<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="?attr/actionBarSize">

	<com.google.android.material.button.MaterialButton
		style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
		android:id="@+id/image_toolbar_back"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:gravity="start|center_vertical"
		android:layout_gravity="start|center_vertical"
		android:fontFamily="@font/cairo_bold"
		android:layout_centerVertical="true"
		android:layout_alignParentStart="true"
		android:layout_alignParentLeft="true"
		android:text="Back"
		android:textSize="18sp"
		android:textStyle="bold"
		android:textAllCaps="false"
		app:icon="@drawable/imagepicker_ic_back"
		app:iconGravity="textStart"
		app:iconSize="20dp"
		android:padding="0dp"
		app:backgroundTint="@android:color/transparent"/>

    <TextView
        android:id="@+id/text_toolbar_title"
        style="@style/imagepicker_ToolbarTitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="@dimen/imagepicker_margin_large"
        android:layout_marginEnd="@dimen/imagepicker_margin_large"
		android:layout_gravity="center"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Folder"
        android:textColor="@color/imagepicker_white"
		android:fontFamily="@font/cairo_black"
		android:textStyle="bold"
		android:textSize="18sp"
		android:layout_centerInParent="true"
		android:textAllCaps="true"
		android:textAlignment="center" />

	<com.addisonelliott.segmentedbutton.SegmentedButtonGroup
		android:id="@+id/switch_photos"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_centerInParent="true"
		android:elevation="2dp"
		android:background="@color/imagepicker_white"
		app:borderWidth="0dp"
		app:position="0"
		app:radius="24dp"
		app:ripple="true"
		app:selectedButtonRadius="24dp"
		app:selectedBackground="@color/imagepicker_black">

		<com.addisonelliott.segmentedbutton.SegmentedButton
			android:id="@+id/switch_btn_photos"
			android:layout_width="90dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:fontFamily="@font/cairo_black"
			android:padding="6dp"
			app:selectedTextColor="@color/imagepicker_white"
			app:text="Photos"
			app:textColor="@color/imagepicker_gray" />

		<com.addisonelliott.segmentedbutton.SegmentedButton
			android:id="@+id/switch_btn_albums"
			android:layout_width="90dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:fontFamily="@font/cairo_black"
			android:padding="6dp"
			app:selectedTextColor="@color/imagepicker_white"
			app:text="Albums"
			app:textColor="@color/imagepicker_gray" />

	</com.addisonelliott.segmentedbutton.SegmentedButtonGroup>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/image_toolbar_camera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignWithParentIfMissing="true"
        android:layout_centerVertical="true"
		android:layout_alignParentEnd="true"
		android:layout_alignParentRight="true"
		android:gravity="end|center_vertical"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="16dp"
        android:src="@drawable/imagepicker_ic_camera" />


    <TextView
        android:id="@+id/text_toolbar_done"
        style="@style/imagepicker_ToolbarMenuText"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/imagepicker_padding_large"
        android:text="@string/imagepicker_action_done"
        android:textAllCaps="true"
        android:textColor="@color/imagepicker_white"
        android:visibility="gone" />

</merge>