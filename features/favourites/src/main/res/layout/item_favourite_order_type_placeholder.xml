<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shimmerContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/_4sdp"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- First Shimmering View -->
    <View
        android:id="@+id/shimmerView1"
        android:layout_width="@dimen/_70sdp"
        android:layout_height="@dimen/_28sdp"
        android:background="@drawable/bg_favourite_order_item_placeholder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/shimmerView2"
        android:layout_width="@dimen/_70sdp"
        android:layout_height="@dimen/_28sdp"
        android:layout_marginStart="@dimen/_15sdp"
        android:background="@drawable/bg_favourite_order_item_placeholder"
        app:layout_constraintStart_toEndOf="@+id/shimmerView1"
        app:layout_constraintBottom_toBottomOf="@+id/shimmerView1"
        app:layout_constraintTop_toTopOf="@id/shimmerView1" />

    <View
        android:id="@+id/shimmerView3"
        android:layout_width="@dimen/_70sdp"
        android:layout_height="@dimen/_28sdp"
        android:layout_marginStart="@dimen/_15sdp"
        android:background="@drawable/bg_favourite_order_item_placeholder"
        app:layout_constraintBottom_toBottomOf="@+id/shimmerView2"
        app:layout_constraintStart_toEndOf="@+id/shimmerView2"
        app:layout_constraintTop_toTopOf="@+id/shimmerView2" />
</androidx.constraintlayout.widget.ConstraintLayout>