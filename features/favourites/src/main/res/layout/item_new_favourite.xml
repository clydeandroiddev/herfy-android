<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<androidx.cardview.widget.CardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_large"
    android:padding="@dimen/_10sdp"
    app:strokeColor="#D9E8F3"
    app:strokeWidth="@dimen/_1sdp"
    app:cardPreventCornerOverlap="false"
    app:cardCornerRadius="@dimen/radius_large"
    app:contentPadding="@dimen/_4sdp"
    android:id="@+id/optionCardView"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:id="@+id/clickable_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image_item"
            android:layout_width="@dimen/_120sdp"
            android:layout_height="@dimen/_120sdp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            app:strokeColor="@color/card_selected_bg"
            app:strokeWidth="@dimen/_1sdp"
            android:padding="@dimen/padding_micro"
            tools:src = "@tools:sample/avatars"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Image.Corner12dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:id="@+id/layoutCalories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginStart="16dp"
                tools:visibility="visible"
                android:layout_marginTop="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/ic_common_calories" />

                <TextView
                    android:id="@+id/tvCalories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/inter_medium"
                    android:includeFontPadding="false"
                    android:textStyle="bold"
                    tools:text = "1120"
                    android:textSize="11sp"
                    android:textColor="#55667B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:textSize="11sp"
                    android:textColor="#55667B"
                    android:text="Kcal"/>

            </LinearLayout>
            <ImageView
                android:id="@+id/favorite_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_favourites_selected"
                android:layout_marginEnd="@dimen/margin_small"
                android:layout_marginTop="@dimen/margin_small"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <TextView
                android:id="@+id/txtModifierItemName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toStartOf="@+id/favorite_icon"
                android:layout_marginTop="@dimen/_4sdp"
                style="@style/Styles.Text.Caption.Semibold"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutCalories"
                android:layout_marginStart="16dp"
                android:layout_gravity="center_vertical"
                android:gravity="start|center_vertical"

                android:paddingEnd="4dp"
                android:textAlignment="viewStart"
                android:textColor="#0C0C0C"
                tools:text="Marinara" />

            <TextView
                android:id="@+id/txtFavouriteDescription"
                style="@style/Styles.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:layout_marginTop="@dimen/margin_small"
                android:ellipsize="end"
                android:fontFamily="@font/inter_regular"
                android:gravity="start|center_vertical"
                android:maxLines="3"
                android:textAlignment="viewStart"
                android:textColor="#1e1e1e"
                app:layout_constraintEnd_toEndOf="@+id/txtModifierItemName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtModifierItemName"
                tools:text="Dive into a flavor-packed adventure with our New Triple Herfy!" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtFavouritePrice"
                style="@style/Styles.Text.Footnote_Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="#2266A7"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@+id/icAdd"
                app:layout_constraintStart_toStartOf="@+id/txtModifierItemName"
                tools:text="+Sar 2" />
            <ImageView
                android:id="@+id/icAdd"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                android:layout_marginEnd="@dimen/_4sdp"
                app:layout_constraintEnd_toEndOf="parent"
                tools:visibility="visible"
                android:src="@drawable/ic_common_quantity_up_blue"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_height="wrap_content"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/favouriteQuantityLayout"
                android:layout_width="32dp"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/bg_favourite_quantity"
                android:gravity="center_vertical"
                android:visibility="visible"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/margin_small"
                android:layout_marginEnd="@dimen/_4sdp"
                android:textAlignment="center"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_height="32dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/txtQuantity"
                    style="@style/Styles.Text.Headline1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_medium"
                    android:textSize="18sp"
                    android:maxLines="1"
                    app:autoSizeTextType="uniform"
                    app:autoSizeMinTextSize="12sp"
                    android:padding="4dp"
                    app:autoSizeMaxTextSize="18sp"
                    android:gravity="center"
                    android:textColor="#0064AC"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="88"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
</layout>