<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<androidx.cardview.widget.CardView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/margin_large"
    android:padding="@dimen/_10sdp"
    app:strokeColor="#D9E8F3"
    app:strokeWidth="@dimen/_1sdp"
    app:cardPreventCornerOverlap="false"
    app:cardCornerRadius="@dimen/radius_large"
    app:contentPadding="@dimen/_4sdp"
    android:id="@+id/optionCardView"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:id="@+id/clickable_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image_item"
            android:layout_width="@dimen/_120sdp"
            android:layout_height="@dimen/_120sdp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            app:strokeColor="@color/card_selected_bg"
            app:strokeWidth="@dimen/_1sdp"
            android:padding="@dimen/padding_micro"
            tools:src = "@tools:sample/avatars"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Image.Corner12dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/txtCalories"
                android:drawableStart="@drawable/ic_common_calories"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.Caption"
                android:fontFamily="@font/inter_regular"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="@dimen/margin_large"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_gravity="center_vertical"
                android:drawablePadding="@dimen/padding_micro"
                android:gravity="start|center_vertical"
                android:paddingStart="@dimen/_10sdp"
                android:visibility="gone"
                android:paddingEnd="@dimen/_4sdp"
                android:textAlignment="viewStart"
                android:textColor="#0C0C0C"
                tools:text="2000 Kcal" />

            <TextView
                android:id="@+id/txtKcal"
                android:layout_marginStart="@dimen/_2sdp"
                android:textSize="11sp"
                android:textColor="#55667B"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@+id/txtCalories"
                app:layout_constraintTop_toTopOf="@+id/txtCalories"
                app:layout_constraintBottom_toBottomOf="@+id/txtCalories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <ImageView
                android:id="@+id/favorite_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_favourites_selected"
                android:layout_marginEnd="@dimen/margin_small"
                android:layout_marginTop="@dimen/margin_small"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <TextView
                android:id="@+id/txtModifierItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                style="@style/Styles.Text.Caption.Semibold"
                android:fontFamily="@font/inter_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtCalories"
                android:layout_marginStart="@dimen/margin_large"

                android:layout_gravity="center_vertical"
                android:gravity="start|center_vertical"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="4dp"
                android:textAlignment="viewStart"
                android:textColor="#0C0C0C"
                tools:text="Marinara dip" />

            <TextView
                android:id="@+id/txtFavouriteDescription"
                style="@style/Styles.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_large"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="@dimen/margin_small"
                android:ellipsize="end"
                android:fontFamily="@font/inter_regular"
                android:gravity="start|center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="4dp"
                android:textAlignment="viewStart"
                android:textColor="#1e1e1e"

                app:layout_constraintEnd_toEndOf="@+id/txtModifierItemName"
                app:layout_constraintStart_toStartOf="parent"

                app:layout_constraintTop_toBottomOf="@+id/txtModifierItemName"
                app:layout_constraintWidth_percent="0.45"
                tools:text="Dive into a flavor-packed adventure with our New Triple Herfy!" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtFavouritePrice"
                style="@style/Styles.Text.Footnote_Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@+id/icAdd"
                app:layout_constraintStart_toStartOf="@+id/txtModifierItemName"
                app:layout_constraintTop_toTopOf="@+id/icAdd"
                tools:text="+Sar 2" />
            <ImageView
                android:id="@+id/icAdd"

                android:layout_width="wrap_content"
                android:layout_marginBottom="@dimen/margin_small"
                android:layout_marginEnd="@dimen/_4sdp"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/ic_common_quantity_up_blue"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_height="wrap_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
</layout>