<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/language_pic"
            app:layout_constraintBottom_toTopOf="@id/view"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toTopOf="@id/bottomPart" />

        <LinearLayout
            android:id="@+id/bottomPart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_slidingpanel_bg"
            android:backgroundTint="#F7F7F7"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="@dimen/margin_20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="30dp"
            app:layout_constraintBottom_toTopOf="@id/confirm_container">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/chooseYourEnglishLabel"
                style="@style/TextAppearance.Headline5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                tools:text="Choose your language to continue" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/chooseYourArabicLabel"
                style="@style/TextAppearance.Headline1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="viewEnd"
                android:textColor="@color/black"
                tools:text="اختر لغتك للمتابعة" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/chooseArabic"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_language_selected"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                app:layout_constraintTop_toTopOf="parent">>

                <ImageView
                    android:id="@+id/arabicFlag"
                    android:layout_width="20dp"
                    android:layout_height="19dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/arabic_flag"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/selectedArabic"
                    android:layout_width="@dimen/margin_20dp"
                    android:layout_height="@dimen/margin_20dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_language_circle_selected"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/arabicName"
                    style="@style/Styles.Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:paddingStart="14dp"
                    android:paddingEnd="7dp"
                    android:text="@string/arabic"
                    android:textColor="#101010"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/selectedArabic"
                    app:layout_constraintStart_toEndOf="@id/arabicFlag"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/chooseEnglish"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_language_unselected"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                app:layout_constraintTop_toTopOf="parent">>

                <ImageView
                    android:id="@+id/englishFlag"
                    android:layout_width="20dp"
                    android:layout_height="19dp"
                    android:layout_marginStart="5dp"
                    android:src="@drawable/english_flag"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/selectedEnglish"
                    android:layout_width="@dimen/margin_20dp"
                    android:layout_height="@dimen/margin_20dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_language_circle_unselected"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/englishName"
                    style="@style/Styles.Text.Caption"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:paddingStart="14dp"
                    android:paddingEnd="7dp"
                    android:text="@string/english"
                    android:textColor="#101010"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/selectedEnglish"
                    app:layout_constraintStart_toEndOf="@id/englishFlag"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/confirm_container"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="6dp"
            app:cardUseCompatPadding="false"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/continueButton"
                    style="@style/Styles.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/background_button_common"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Continue" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>