<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/txtModifierGroupTitle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:textAlignment="viewStart"
        android:fontFamily="@font/cairo_bold"
        android:textColor="@color/black"
        tools:text = "Choose size"
        android:layout_height="wrap_content"/>
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/txtModifierLabel"
        android:layout_width="wrap_content"
        tools:text = "Select one"
        app:layout_constraintTop_toBottomOf="@+id/txtModifierGroupTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/margin_5dp"
        android:layout_height="wrap_content"/>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="false"
        android:descendantFocusability="blocksDescendants"
        app:layout_constraintTop_toBottomOf="@+id/txtModifierLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_modifier_item"
        tools:itemCount="5"
        android:layout_marginTop="@dimen/margin_large"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="16dp"/>

    <LinearLayout
        android:id="@+id/btnRequired"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_background"
        android:gravity="center"
        android:textAlignment="viewEnd"
        app:layout_constraintBottom_toBottomOf="@+id/txtModifierLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:gravity="center"
            tools:text="Required" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
