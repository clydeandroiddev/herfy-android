<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/footer">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/main_toolbar"
                android:layout_width="match_parent"
                android:layout_height="385dp"
                android:animateLayoutChanges="true"
                android:fitsSystemWindows="true"
                app:contentInsetLeft="0dp"
                app:contentInsetStart="0dp"
                app:contentInsetStartWithNavigation="0dp"
                app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
                app:titleEnabled="true">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/image"
                        android:layout_width="match_parent"
                        android:layout_height="285dp"
                        android:layout_gravity="center_horizontal|center_vertical"
                        android:orientation="vertical"
                        android:scaleType="centerCrop"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        app:layout_constraintTop_toBottomOf="@+id/image"/>

                    <ImageView
                        android:id="@+id/icClose"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="@dimen/margin_large"
                        android:layout_marginTop="@dimen/margin_xlarge"
                        android:src="@drawable/ic_close"
                        app:layout_constraintStart_toStartOf="@id/image"
                        app:layout_constraintTop_toTopOf="parent" />

                    <FrameLayout
                        android:id="@+id/favorite_card"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_xlarge"
                        android:layout_marginEnd="@dimen/margin_large"
                        android:background="@drawable/background_favourite"
                        android:elevation="8dp"
                        android:visibility="visible"
                        app:layout_constraintEnd_toEndOf="@id/image"
                        app:layout_constraintTop_toTopOf="parent">

                        <RelativeLayout
                            android:id="@+id/favorite_container"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/favorite_icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:scaleType="centerCrop"
                                app:srcCompat="@drawable/ic_heart_unselected" />

                        </RelativeLayout>

                    </FrameLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/bg_menu_item_background"
                    app:contentInsetLeft="0dp"
                    app:contentInsetStart="0dp"
                    app:contentInsetStartWithNavigation="0dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/name"
                            style="@style/TextAppearance.Headline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_large"
                            android:layout_marginTop="16dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/primary_text"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="Grill Chicken" />

                        <TextView
                            android:id="@+id/total"

                            style="@style/Styles.Text.Headline1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_large"
                            android:layout_marginBottom="-5dp"
                            android:includeFontPadding="false"
                            android:textColor="#2266A7"
                            app:layout_constraintBottom_toBottomOf="@+id/name"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/name"
                            tools:text="SAR 44" />
                        <TextView
                            android:id="@+id/description"
                            style="@style/TextAppearance.Footnote.Medium_Regular"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="start"
                            android:textAlignment="viewStart"
                            android:textColor="#969696"
                            android:maxLines="3"
                            android:ellipsize="end"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/name"
                            app:layout_constraintTop_toBottomOf="@+id/name"
                            app:layout_constraintBottom_toTopOf="@+id/txtMoreInfo"
                            tools:text="Dive into a flavor-packed adventure with our New Triple Herfy! Three mouthwatering beef patties, decadent cheese, and our signature herfy sauce, all crowned with crisp lettuce, pickles, and onions. It's a triple delight that takes burger indulgence to new heights!" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/txtMoreInfo"
                            style="@style/Styles.Text.Footnote.Semi.Bold"
                            android:layout_width="wrap_content"
                            android:layout_marginBottom="@dimen/margin_small"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_large"
                            android:drawableEnd="@drawable/ic_question_mark"
                            android:drawablePadding="@dimen/margin_micro"
                            android:textAlignment="viewStart"
                            android:textColor="@color/shade_blue"
                            android:visibility="gone"
                            app:layout_constraintBottom_toTopOf="@+id/viewSeparator"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginTop="@dimen/margin_large"
                            app:layout_constraintTop_toBottomOf="@+id/description"
                            app:lineHeight="20sp"
                            tools:text="More Info"
                            tools:visibility="visible" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnCalories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_small"
                            android:layout_marginBottom="@dimen/margin_small"
                            android:backgroundTint="@color/white"
                            android:gravity="center"
                            android:orientation="horizontal"
                            app:cardCornerRadius="@dimen/_12sdp"
                            app:cardPreventCornerOverlap="true"
                            app:cardUseCompatPadding="false"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/description"
                            app:layout_constraintTop_toTopOf="@+id/txtMoreInfo"
                            app:strokeColor="#D9E8F3"
                            app:strokeWidth="1dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/calories"
                                style="@style/Styles.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center_vertical"
                                android:layout_weight="1"
                                android:drawableStart="@drawable/ic_fire"
                                android:drawablePadding="@dimen/margin_small"
                                android:gravity="center_vertical"
                                android:paddingStart="@dimen/padding_micro"
                                android:paddingTop="@dimen/padding_micro"
                                android:paddingEnd="@dimen/padding_micro"
                                android:paddingBottom="@dimen/padding_micro"
                                tools:text="2200 Kcal" />
                        </androidx.cardview.widget.CardView>

                        <View
                            android:id="@+id/viewSeparator"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="@dimen/margin_large"
                            android:layout_marginTop="@dimen/margin_small"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:background="@color/colorSeparator" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.appcompat.widget.Toolbar>

            </com.google.android.material.appbar.CollapsingToolbarLayout>

        </com.google.android.material.appbar.AppBarLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/content_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F7F7F7"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_large"
                android:background="#F7F7F7"
                android:orientation="vertical">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/sizesLayoutTextContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible">


                    <ImageView
                        android:id="@+id/checkBox"
                        android:layout_width="34dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:layout_marginEnd="@dimen/margin_large"
                        android:src="@drawable/ic_modifier_group_checked_selected"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@+id/txtSelectOne"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:visibility="visible" />


                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/sizes_label"
                        style="@style/Styles.Text.Footnote.Semi.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_large"
                        android:layout_marginTop="@dimen/margin_large"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:text="Choose size"
                        android:textAlignment="viewStart"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        app:layout_constraintStart_toEndOf="@+id/imageCardView"
                        app:layout_constraintTop_toTopOf="parent" />


                    <LinearLayout
                        android:id="@+id/imageCardView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_modifier_group_image"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/margin_large"
                        app:layout_constraintTop_toTopOf="@+id/sizes_label"
                        app:layout_constraintBottom_toBottomOf="@+id/txtSelectOne"
                        app:layout_constraintStart_toStartOf="parent">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/padding_small"
                            tools:src="@drawable/ic_car_drive_thru" />
                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtSelectOne"
                        style="@style/Styles.Text.Footnote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_small"
                        android:textSize="12sp"
                        app:layout_constraintStart_toStartOf="@+id/sizes_label"
                        app:layout_constraintTop_toBottomOf="@+id/sizes_label"
                        tools:text="Select up to 2" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/sizes_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:orientation="horizontal"
                    android:layout_marginStart="@dimen/margin_large"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/sizes_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:descendantFocusability="blocksDescendants"
                    android:focusableInTouchMode="false"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:layout_marginHorizontal="@dimen/margin_small"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_new_size"
                    tools:visibility="visible" />

                <View
                    android:id="@+id/viewSizesSeparator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_large"
                    android:background="@color/colorSeparator"
                    android:visibility="gone"/>

                <!--                </androidx.cardview.widget.CardView>-->

                <!--                <androidx.cardview.widget.CardView-->
                <!--                    android:id="@+id/menuItemGroupCardView"-->
                <!--                    android:layout_width="match_parent"-->
                <!--                    android:layout_height="wrap_content"-->
                <!--                    android:visibility="gone"-->
                <!--                    app:cardBackgroundColor="@color/white"-->
                <!--                    app:cardCornerRadius="5dp"-->
                <!--                    app:cardElevation="0dp"-->
                <!--                    app:cardPreventCornerOverlap="true"-->
                <!--                    app:cardUseCompatPadding="true">-->

                <!--                    <LinearLayout-->
                <!--                        android:layout_width="match_parent"-->
                <!--                        android:layout_height="wrap_content"-->
                <!--                        android:orientation="vertical"-->
                <!--                        android:paddingBottom="50dp">-->

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/modifier_groups_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_small"
                    android:clipToPadding="false"
                    android:descendantFocusability="blocksDescendants"
                    android:focusableInTouchMode="false"
                    android:paddingTop="2dp"
                    android:visibility="gone"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior"
                    tools:itemCount="5"
                    tools:listitem="@layout/item_modifier_group_new"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/notes_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/margin_large"
                    android:layout_marginBottom="@dimen/margin_large"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/notes_label"
                        style="@style/TextAppearance.Footnote.Semi_Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_large"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:text="@string/special_instruction"
                        android:textAlignment="viewStart"
                        android:textAllCaps="false"
                        android:textColor="#0C0C0C"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/notes_description"
                        style="@style/TextAppearance.Footnote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:layout_marginTop="@dimen/margin_small"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:textAlignment="viewStart"
                        android:textAllCaps="false"
                        android:textColor="#55667B"
                        android:textStyle="bold" />


                    <EditText
                        android:id="@+id/et_item_notes"
                        style="@style/Styles.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="30dp"
                        android:paddingBottom="30dp"
                        android:layout_marginTop="@dimen/margin_large"
                        android:background="@drawable/bg_background_border"
                        android:fontFamily="@font/inter_regular"
                        android:gravity="center_vertical"
                        android:imeOptions="actionDone"
                        android:lineSpacingExtra="4dp"
                        android:maxLength="512"
                        android:textColor="#0C0C0C"
                        android:textColorHint="#ACACAC"
                        android:textAlignment="viewStart"
                        android:textSize="14sp"
                        tools:hint="e.g. Orange door on left, white coloured building, don’t ring the bell" />
                    <View
                        android:id="@+id/notesDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/margin_large"
                        android:background="#E6E8EB" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/txtFrequntlyBought"
                        style="@style/Styles.Text.Footnote.Semi.Bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_large"
                        android:layout_marginTop="@dimen/margin_small"
                        android:text="Frequently Bought Together"
                        android:textColor="@color/dark_shade_of_grey"
                        android:textSize="16sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/frequently_bough_recycleview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin_small"
                        android:clipToPadding="false"
                        android:descendantFocusability="blocksDescendants"
                        android:focusableInTouchMode="false"
                        android:layout_marginTop="@dimen/margin_large"
                        android:orientation="vertical"
                        android:paddingTop="2dp"
                        app:layout_behavior="@string/appbar_scrolling_view_behavior"
                        tools:visibility="visible" />

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>


    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/white"
        android:elevation="5dp"
        android:orientation="horizontal"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtQuantity"
            style="@style/Styles.Text.Subheadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_large"
            android:layout_marginTop="@dimen/margin_large"
            android:fontFamily="@font/inter_semi_bold"
            android:layout_marginBottom="@dimen/margin_large"
                android:textColor="#0C0C0C"
            android:textAlignment="viewStart"
            app:layout_constraintBottom_toTopOf="@+id/add"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Quantity" />

        <LinearLayout
            android:id="@+id/clickableParentQuantityLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/margin_large"
            android:background="@drawable/rounded_corner"
            android:backgroundTint="#D9E8F3"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@+id/add"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/quantity"
                    style="@style/TextAppearance.Footnote.Medium_Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/margin_large"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="1"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/minus"
                    app:layout_constraintEnd_toStartOf="@+id/plus"
                    app:layout_constraintTop_toTopOf="@+id/minus" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/plus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?selectableItemBackground"
                    android:textAlignment="viewEnd"
                    app:layout_constraintBottom_toBottomOf="@+id/minus"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/minus"
                    app:srcCompat="@drawable/quantity_up_blue" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/minus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_large"
                    android:background="?selectableItemBackground"
                    app:layout_constraintEnd_toStartOf="@+id/quantity"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/ic_new_minus" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/add"
            style="@style/TextAppearance.Footnote.Semi_Bold"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="@dimen/margin_large"
            android:layout_marginTop="@dimen/margin_large"
            android:layout_marginBottom="@dimen/margin_xlarge"
            android:background="@drawable/rounded_corner"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="ADD TO Cart"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:cornerRadius="36dp"
            android:paddingStart="@dimen/_30sdp"
            android:paddingTop="@dimen/padding_small"
            android:paddingEnd="@dimen/_30sdp"
            android:paddingBottom="@dimen/_8sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtQuantity"
            app:strokeWidth="2dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>