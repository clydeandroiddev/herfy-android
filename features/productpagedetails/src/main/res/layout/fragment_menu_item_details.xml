<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/footer"
        tools:visibility="visible"
        android:visibility="invisible">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/main_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="@dimen/menu_appbar_height_no_slider"
                app:layout_scrollFlags="scroll|exitUntilCollapsed">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/margin_small"
                    app:layout_scrollFlags="scroll|enterAlways">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/materialImageCalendar"
                            android:layout_width="361dp"
                            android:layout_height="180dp"
                            android:layout_marginTop="@dimen/margin_large"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Image.Corner12dp"
                            android:layout_marginHorizontal="@dimen/margin_large"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginEnd="@dimen/margin_large"
                            android:background="@drawable/bg_menu_item_details_background"
                            android:layout_marginStart="12dp"
                            android:scaleType="fitXY"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" >

                            <ImageView
                                android:id="@+id/image"
                                android:layout_width="163dp"
                                tools:src="@tools:sample/avatars"
                                android:layout_gravity="center_horizontal|center_vertical"
                                android:layout_height="151dp"/>
                        </com.google.android.material.card.MaterialCardView>

                        <ImageView
                            android:id="@+id/icClose"
                            android:layout_width="36dp"
                            android:src="@drawable/ic_close"
                            app:layout_constraintStart_toStartOf="@id/materialImageCalendar"
                            app:layout_constraintTop_toTopOf="parent"
                            android:layout_marginStart="@dimen/margin_large"
                            android:layout_marginTop="@dimen/margin_xlarge"
                            android:layout_height="36dp"/>

                        <FrameLayout
                            android:id="@+id/favorite_card"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginTop="@dimen/margin_xlarge"
                            android:layout_marginEnd="@dimen/margin_large"
                            android:background="@drawable/background_favourite"
                            android:elevation="8dp"
                            android:visibility="visible"
                            app:layout_constraintEnd_toEndOf="@id/materialImageCalendar"
                            app:layout_constraintTop_toTopOf="parent">

                            <RelativeLayout
                                android:id="@+id/favorite_container"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/favorite_icon"
                                    android:layout_width="20dp"
                                    android:layout_height="18dp"
                                    android:layout_centerInParent="true"
                                    android:scaleType="fitXY"
                                    app:srcCompat="@drawable/ic_heart"
                                    app:tint="#DEDEDE" />

                                    </RelativeLayout>

                        </FrameLayout>

                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/halfGuideline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintGuide_begin="206dp" />

                        <LinearLayout
                            android:id="@+id/btnDriveThru"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_rounded_drive_thru"
                            app:layout_constraintEnd_toEndOf="@+id/name"
                            android:layout_marginTop="@dimen/margin_large"
                            android:orientation="horizontal"
                            android:gravity="center"
                            app:layout_constraintBottom_toTopOf="@+id/name"
                            app:layout_constraintTop_toBottomOf="@id/materialImageCalendar">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                style="@style/Styles.Text.Caption"
                                android:layout_gravity="center"
                                android:drawablePadding="@dimen/margin_small"
                                android:drawableStart="@drawable/ic_car"
                                android:gravity="center_vertical"
                                android:layout_weight="1"
                                tools:text="Drive thru" />

                        </LinearLayout>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnCalories"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/white"
                            android:gravity="center"
                            android:orientation="horizontal"
                            app:strokeColor="#D9E8F3"
                            app:strokeWidth="1dp"
                            app:cardUseCompatPadding="true"
                            app:cardCornerRadius="8dp"
                            android:layout_marginStart="@dimen/margin_small"
                            app:cardPreventCornerOverlap="true"
                            app:contentPadding="@dimen/padding_small"
                            app:layout_constraintBottom_toBottomOf="@+id/btnDriveThru"
                            app:layout_constraintStart_toEndOf="@+id/btnDriveThru"
                            app:layout_constraintTop_toTopOf="@+id/btnDriveThru">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/calories"
                                style="@style/Styles.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:layout_gravity="center_vertical"
                                android:layout_weight="1"
                                android:drawableStart="@drawable/ic_fire"
                                android:drawablePadding="@dimen/margin_small"
                                android:gravity="center_vertical"
                                tools:text="2200 Kcal" />
                        </androidx.cardview.widget.CardView>

                        <TextView
                            android:id="@+id/name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:layout_marginTop="@dimen/margin_small"
                            android:fontFamily="@font/cairo_bold"
                            android:includeFontPadding="false"
                            android:layout_marginStart="@dimen/margin_large"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/primary_text"
                            android:textSize="18sp"
                            tools:text="Grill Chicken"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/btnDriveThru" />

                        <TextView
                            android:id="@+id/total"
                            style="@style/Styles.Text.Headline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_large"
                            android:layout_marginBottom="-5dp"
                            android:fontFamily="@font/cairo_regular"
                            android:textColor="@color/shade_blue"
                            android:includeFontPadding="false"
                            app:layout_constraintBottom_toBottomOf="@+id/btnCalories"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/btnCalories"
                            tools:text="SAR 44" />

                        <TextView
                            android:id="@+id/description"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/cairo_regular"
                            android:gravity="start"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="-7dp"
                            android:textAlignment="viewStart"
                            android:textColor="#969696"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintStart_toStartOf="@+id/name"
                            app:layout_constraintTop_toBottomOf="@+id/name"
                            tools:text="Grilled chicken patty, topped with a flavorful slice of cheese and shredded fresh lettuce" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/txtMoreInfo"
                            style="@style/Styles.Text.Footnote.Medium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableEnd="@drawable/ic_question_mark"
                            android:drawablePadding="@dimen/margin_micro"
                            android:textAlignment="viewStart"
                            android:textColor="@color/shade_blue"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/description"
                            android:layout_marginEnd="@dimen/margin_large"
                            app:lineHeight="20sp"
                            tools:text="More Info"
                            tools:visibility="visible" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:id="@+id/imageSeparator"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/margin_small"
                        app:layout_constraintTop_toBottomOf="@+id/txtMoreInfo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginHorizontal="@dimen/margin_large"
                        android:background="@color/colorSeparator"
                        android:layout_height="1dp"/>
                </LinearLayout>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/content_main"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="#FAFBFC"
            app:layout_constraintTop_toBottomOf="@+id/appbar"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_small"
                android:layout_marginBottom="@dimen/margin_large"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@+id/appbar">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/btnRequired"
                            android:layout_width="73dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_rounded_25_radius_background"
                            android:gravity="center"
                            android:textAlignment="viewEnd"
                            app:layout_constraintBottom_toBottomOf="@+id/txtSelectOne"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/txtRequired"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:padding="0dp"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                tools:text="Required" />
                        </LinearLayout>

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/sizes_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_large"

                            android:gravity="start"
                            android:includeFontPadding="false"
                            android:text="Choose size"
                            android:textAlignment="viewStart"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/txtSelectOne"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select one"
                            android:textSize="12sp"
                            app:layout_constraintStart_toStartOf="@+id/sizes_label"
                            app:layout_constraintTop_toBottomOf="@+id/sizes_label" />

                        <LinearLayout
                            android:id="@+id/sizes_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:orientation="horizontal"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/txtSelectOne"
                            tools:visibility="visible"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/sizes_recycler_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:descendantFocusability="blocksDescendants"
                            android:focusableInTouchMode="false"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            app:layout_behavior="@string/appbar_scrolling_view_behavior"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/sizes_container"
                            tools:itemCount="2"
                            tools:visibility="visible" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
<!--                </androidx.cardview.widget.CardView>-->

<!--                <androidx.cardview.widget.CardView-->
<!--                    android:id="@+id/menuItemGroupCardView"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:visibility="gone"-->
<!--                    app:cardBackgroundColor="@color/white"-->
<!--                    app:cardCornerRadius="5dp"-->
<!--                    app:cardElevation="0dp"-->
<!--                    app:cardPreventCornerOverlap="true"-->
<!--                    app:cardUseCompatPadding="true">-->

<!--                    <LinearLayout-->
<!--                        android:layout_width="match_parent"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:orientation="vertical"-->
<!--                        android:paddingBottom="50dp">-->

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/modifier_groups_recycler_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:descendantFocusability="blocksDescendants"
                            android:focusableInTouchMode="false"
                            android:paddingTop="2dp"
                            android:visibility="gone"
                            android:paddingBottom="50dp"
                            app:layout_behavior="@string/appbar_scrolling_view_behavior"
                            tools:visibility="visible" />



                    <LinearLayout
                        android:id="@+id/notes_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/margin_large"
                        android:layout_marginBottom="@dimen/margin_large"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/notes_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_large"
                            android:gravity="start"
                            android:includeFontPadding="false"
                            android:text="Special Instruction"
                            android:textAlignment="viewStart"
                            android:textAllCaps="true"
                            android:textColor="#ACACAC"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            style="@style/Styles.Text.Footnote" />

                        <TextView
                            android:id="@+id/notes_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/cairo_bold"
                            android:gravity="start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textAlignment="viewStart"
                            android:textAllCaps="false"
                            android:textColor="#ACACAC"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/et_item_notes"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:layout_marginTop="@dimen/margin_xlarge"
                            android:background="@drawable/bg_background_border"
                            android:fontFamily="@font/cairo_regular"
                            android:gravity="start"
                            android:inputType="text"
                            android:maxLines="4"
                            android:maxLength="512"
                            android:textAlignment="viewStart"
                            android:textColorHint="#ACACAC"
                            android:textSize="14sp" />

                    </LinearLayout>




                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_large"
                            android:layout_marginTop="@dimen/margin_small"
                            android:text="Frequently Bought Together"
                            android:textSize="16sp"
                            style="@style/Styles.Text.Subheadline" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/frequently_bough_recycleview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:descendantFocusability="blocksDescendants"
                            android:focusableInTouchMode="false"
                            android:layout_marginHorizontal="@dimen/margin_large"
                            android:orientation="vertical"
                            android:paddingTop="2dp"
                            android:visibility="gone"
                            app:layout_behavior="@string/appbar_scrolling_view_behavior"
                            tools:listitem="@layout/item_modifier_frequently_bought"
                            tools:visibility="visible" />

                    </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:layout_marginTop="@dimen/margin_xlarge"
        android:elevation="5dp"
        android:orientation="horizontal"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtQuantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_large"
            android:layout_marginBottom="@dimen/margin_large"
            android:textAlignment="viewStart"
            style="@style/Styles.Text.Subheadline"
            android:fontFamily="@font/cairo_bold"
            app:layout_constraintBottom_toTopOf="@+id/add"
            android:layout_marginStart="@dimen/margin_large"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Quantity" />

        <TextView
            android:id="@+id/quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/margin_large"
            android:fontFamily="@font/cairo_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="1"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/minus"
            app:layout_constraintEnd_toStartOf="@+id/plus"
            app:layout_constraintTop_toTopOf="@+id/minus" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/plus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAlignment="viewEnd"
            android:background="?selectableItemBackground"
            app:layout_constraintBottom_toBottomOf="@+id/minus"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="@dimen/margin_large"
            app:layout_constraintTop_toTopOf="@+id/minus"
            app:srcCompat="@drawable/ic_plus_button" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/minus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?selectableItemBackground"
            app:layout_constraintBottom_toTopOf="@+id/add"
            app:layout_constraintEnd_toStartOf="@+id/quantity"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="@dimen/margin_large"
            app:srcCompat="@drawable/ic_delete_btn" />

        <Button
            android:id="@+id/add"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_large"
            android:background="@drawable/rounded_corner"
            android:fontFamily="@font/cairo_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="ADD TO Cart"
            android:textColor="@color/white"
            android:textAlignment="center"
            android:textAllCaps="true"
            android:textStyle="bold"
            app:cornerRadius="36dp"
            android:layout_marginBottom="@dimen/margin_large"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txtQuantity"
            app:strokeWidth="2dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>