<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginBottom="@dimen/margin_large"
    android:background="@drawable/bg_modifier_item_selector"
    android:padding="10dp"
    app:cardPreventCornerOverlap="false"
    android:layout_marginHorizontal="@dimen/margin_small"
    app:contentPadding="8dp"
    android:id="@+id/optionCardView"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:id="@+id/clickable_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical">


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:scaleType="fitXY"
            android:src="@drawable/product_page_details_border"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Image.Corner8dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <TextView
                android:id="@+id/txtModifierItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Styles.Text.Footnote.Medium"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginStart="@dimen/margin_large"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_gravity="center_vertical"
                android:gravity="start|center_vertical"

                android:paddingEnd="4dp"
                android:textAlignment="viewStart"
                android:textColor="#0C0C0C"
                tools:text="Marinara dip" />


            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtmodifierPrice"
                android:layout_width="wrap_content"

                style="@style/Styles.Text.Footnote_Bold"
                android:textColor="@color/color_light_blue"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="@dimen/margin_large"
                app:layout_constraintTop_toBottomOf="@+id/txtModifierItemName"
                app:layout_constraintStart_toStartOf="@+id/txtModifierItemName"
                tools:text="+Sar 2" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnPopular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_large"
                android:background="@drawable/bg_rounded_background"
                android:textAlignment="viewEnd"
                android:visibility="gone"
                app:cardCornerRadius="6dp"
                app:contentPadding="0dp"
                app:cardUseCompatPadding="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/check_layout"
                android:layout_gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/Styles.Text.Footnote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:padding="@dimen/padding_smallest"
                    android:gravity="center_vertical"
                    android:textColor="#CA3B32"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Popular" />
            </com.google.android.material.card.MaterialCardView>
            <FrameLayout
                android:id="@+id/check_layout"
                android:layout_width="46dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_height="46dp"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/checkBox"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:layout_gravity="center"
                    android:src="@drawable/item_drawable_checked_state" />
                <ImageView
                    android:id="@+id/radioButton"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:visibility="gone"
                    android:layout_gravity="center"
                    android:button="@drawable/item_drawable_radio_state"/>

            </FrameLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/quantity_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_13sdp"
                android:background="@drawable/rounded_corner"
                android:orientation="horizontal"
                android:backgroundTint="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/quantityDownLayout"
                    android:layout_width="wrap_content"
                    tools:visibility="visible"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_height="wrap_content">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quantityDown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_corner"
                    app:cardCornerRadius="80dp"
                    android:backgroundTint="#952E1D"
                    app:contentPadding="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:layout_width="wrap_content"
                        android:src="@drawable/ic_delete"
                        android:padding="@dimen/_8sdp"
                        android:layout_height="wrap_content">

                    </ImageView>
                </com.google.android.material.card.MaterialCardView>
                    <TextView
                        android:id="@+id/quantity"
                        android:layout_width="30dp"
                        style="@style/Styles.Text.Headline_Regular"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        app:layout_constraintBottom_toBottomOf="@id/quantityDown"
                        app:layout_constraintStart_toEndOf="@id/quantityDown"
                        app:layout_constraintTop_toTopOf="@id/quantityDown"
                        tools:text="100" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <ImageButton
                    android:id="@+id/quantityUp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/quantity_up_blue"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/quantityDownLayout"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck" />
                </androidx.constraintlayout.widget.ConstraintLayout>



            </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>