<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/name"
        style="@style/TextAppearance.Subheadline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margin_large"
        android:layout_marginTop="@dimen/margin_large"
        android:textAlignment="viewStart"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:fontFamily="@font/cairo_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lineHeight="16sp"
        tools:text="Topic Sauce" />



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="false"
        android:descendantFocusability="blocksDescendants"
        app:layout_constraintTop_toBottomOf="@+id/name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_modifier_drinks_type"
        tools:itemCount="5"
        android:layout_marginTop="@dimen/margin_large"

        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:paddingBottom="16dp"/>

    <LinearLayout
        android:id="@+id/btnMinimum"
        android:layout_width="80dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_rounded_25_radius_background"
        android:gravity="center"
        android:textAlignment="viewEnd"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/name"
        tools:visibility="visible">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/minimum"
            style="@style/Styles.Text.Footnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/white"
            tools:text="Required" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
