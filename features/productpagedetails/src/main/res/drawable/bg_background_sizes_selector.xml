<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="8dp" />
            <padding
                android:bottom="6dp"
                android:left="12dp"
                android:right="12dp"
                android:top="6dp"
                />
            <solid android:color="@color/black" />
            <stroke
                android:width="1dp"
                android:color="@color/black" />
        </shape>
    </item>

    <!-- Default state -->
    <item>
        <shape>
            <corners android:radius="8dp" />
            <padding
                android:bottom="6dp"
                android:left="12dp"
                android:right="12dp"
                android:top="6dp"
                />
            <solid android:color="@color/white" />
            <stroke
                android:width="2dp"
                android:color="#D1D1D6" />
        </shape>
    </item>
</selector>