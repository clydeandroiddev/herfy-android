<?xml version="1.0" encoding="utf-8"?>
<layout>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="#F7F7F7"
    android:layout_marginHorizontal="@dimen/margin_large"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/mobile_number_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_xlarge"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:textColor="#101010"
        tools:text = "Mobile number"
        style="@style/TextAppearance.Footnote"
        />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/phoneNumberLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/mobile_number_label">

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/radius_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/colorGrayStroke"
            app:strokeWidth="@dimen/_1sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <Spinner
                    android:id="@+id/phone_number_prefix"
                    style="@style/SpinnerTheme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?selectableItemBackground"
                    android:clickable="false"
                    android:elevation="0dp"
                    android:gravity="center_horizontal"
                    android:includeFontPadding="true"
                    android:layoutDirection="ltr"
                    android:spinnerMode="dropdown"
                    android:textAlignment="viewStart"
                    android:textColor="@color/colorAccent"
                    android:textSize="14sp"
                    tools:listitem="@layout/item_spinner_dial_code" />

                <FrameLayout
                    android:id="@+id/fm_spinner_click"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/mobile_number_container"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/margin_small"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/_8sdp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cv_spinner"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/colorGrayStroke"
            app:strokeWidth="@dimen/_1sdp">

            <EditText
                android:id="@+id/mobile_number"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/Styles.Text.Footnote.Medium_Regular"
                android:layout_marginEnd="8dp"
                android:background="@null"
                android:digits="0123456789٠١٢٣٤٥٦٧٨٩"
                android:gravity="center"
                android:imeOptions="actionNext"
                android:includeFontPadding="true"
                android:inputType="phone"
                android:maxLength="9"
                android:maxLines="1"
                android:paddingStart="@dimen/margin_10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="@color/black"
                tools:text = "434343434434344444"
                android:textColorHint="@color/black" />
        </androidx.cardview.widget.CardView>


    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.textview.MaterialTextView
        android:layout_width="wrap_content"
        style="@style/Styles.Text.Footnote.Medium_Regular"
        app:layout_constraintTop_toBottomOf="@+id/phoneNumberLayout"
        android:textColor="@color/color_dark_gray_blue"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/margin_large"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text = "This phone number will only be used for this delivery and not be saved."
        android:layout_height="wrap_content"/>

    <Button
        android:id="@+id/btnConfirm"
        style="@style/TextAppearance.Footnote.Semi_Bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/common_rounder_corner"
        android:layout_marginTop="@dimen/margin_large"
        android:layout_marginBottom="@dimen/margin_xlarge"
        android:gravity="center"
        android:includeFontPadding="false"
        tools:text="Confirm"
        android:textAlignment="center"
        android:textColor="@color/white"
        app:cornerRadius="@dimen/radius_xlarge"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeWidth="@dimen/_2sdp" />
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>