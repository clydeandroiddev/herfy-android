<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:cardCornerRadius="20dp"
    android:layout_marginTop="34dp"
    android:layout_marginHorizontal="16dp"
    app:cardPreventCornerOverlap="true"
    app:cardUseCompatPadding="false"
    app:cardElevation="24dp"
    android:layout_marginBottom="24dp"
    android:id="@+id/cv_loyalty_card"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_card_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/background_loyalty_card"
            android:scaleType="fitXY"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:contentDescription="loyalty card background" />
        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_card_contents"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:padding="16dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_ashab_herfy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/white"
                style="@style/Styles.Text.Headline1"
                tools:text="Ashab Herfy"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_tier"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textAlignment="center"
                android:gravity="center_vertical"
                android:drawablePadding="4dp"
                app:drawableStartCompat="@drawable/ic_loyalty_tier"
                tools:background="@drawable/background_silver_tier"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_ashab_herfy"
                style="@style/Styles.Text.Footnote.Semi.Bold"
                tools:text="Diamond"
                android:visibility="invisible"
                />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_marginTop="22dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tv_tier"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:id="@+id/ln_total_points"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tv_total_points_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        style="@style/Styles.Text.Footnote.Medium"
                        tools:text="Total Points"/>

                    <TextView
                        android:id="@+id/tv_total_points"
                        style="@style/Styles.Text.Title1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/white"
                        android:textSize="25sp"
                        android:maxLines="1"
                        tools:text="1900" />

                </LinearLayout>



                <ImageView
                    android:id="@+id/iv_points_to_sar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_points_to_sar_arrow"
                    android:layout_marginStart="19dp"
                    app:layout_constraintTop_toTopOf="@id/ln_total_points"
                    app:layout_constraintBottom_toBottomOf="@id/ln_total_points"
                    app:layout_constraintStart_toEndOf="@id/ln_total_points"/>


                <LinearLayout
                    android:id="@+id/ln_sar_value"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="19dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_points_to_sar">

                    <TextView
                        android:id="@+id/tv_sar_value_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        style="@style/Styles.Text.Footnote.Medium"
                        tools:text="Total Points"/>

                    <TextView
                        android:id="@+id/tv_sar_value"
                        style="@style/Styles.Text.Title1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAlignment="viewEnd"
                        android:textColor="@color/white"
                        android:textSize="25sp"
                        tools:text="1900" />

                </LinearLayout>



            </androidx.constraintlayout.widget.ConstraintLayout>





        </androidx.constraintlayout.widget.ConstraintLayout>

        




    </androidx.constraintlayout.widget.ConstraintLayout>



</com.google.android.material.card.MaterialCardView>
