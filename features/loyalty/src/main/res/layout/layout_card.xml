<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:cardCornerRadius="20dp"
    android:layout_marginTop="34dp"
    android:layout_marginHorizontal="16dp"
    app:cardPreventCornerOverlap="true"
    app:cardUseCompatPadding="false"
    app:cardElevation="24dp"
    android:layout_marginBottom="24dp"
    android:id="@+id/cv_loyalty_card"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_card_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_loyalty_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            tools:src="@drawable/background_loyalty_card"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:contentDescription="loyalty card background" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_card_contents"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/iv_loyalty_card"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="12dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_ashab_herfy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/white"
                style="@style/Styles.Text.Headline1"
                tools:text="Ashab Herfy"
                android:includeFontPadding="false"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_tier"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textAlignment="center"
                android:gravity="center_vertical"
                android:drawablePadding="4dp"
                app:drawableStartCompat="@drawable/ic_loyalty_tier"
                tools:background="@drawable/background_silver_tier"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_ashab_herfy"
                style="@style/Styles.Text.Footnote.Semi.Bold"
                tools:text="Diamond"
                />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_tier_progress_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp"
                style="@style/Styles.Text.Footnote.Medium"
                tools:text="200 points until Gold"
                android:includeFontPadding="false"
                app:drawableStartCompat="@drawable/ic_loyalty_database"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@id/constraintLayout"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@+id/tv_sar_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_sar_value"
                app:layout_constraintVertical_bias=".7"
                app:layout_constraintWidth_percent=".55">


                <SeekBar
                    android:id="@+id/progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:max="100"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/background_loyalty_progress"
                    android:splitTrack="false"
                    android:thumb="@drawable/ic_rewards_thumb"
                    android:thumbOffset="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_progress_tier"
                    style="@style/Styles.Text.Footnote.Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/progress"
                    tools:text="Silver" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/progress_text_indicator"
                    style="@style/Styles.Text.Footnote.Medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_progress_tier"
                    tools:text="400/600" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tv_total_points_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="end"
                android:textAlignment="viewEnd"
                android:includeFontPadding="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/Styles.Text.Footnote.Medium"
                tools:text="Total Points"/>

            <TextView
                android:id="@+id/tv_total_points"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="25sp"
                android:gravity="end"
                android:textAlignment="viewEnd"
                android:maxLines="1"
                android:includeFontPadding="false"
                app:layout_constraintWidth_max="200dp"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toEndOf="@id/tv_tier"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_total_points_label"
                style="@style/Styles.Text.LargeTitle"
                tools:text="1900"/>

            <ImageView
                android:id="@+id/iv_points_equivalent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_loyalty_equivalent"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="6dp"
                app:layout_constraintTop_toBottomOf="@id/tv_total_points"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tv_sar_value_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="end"
                android:textAlignment="viewEnd"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_points_equivalent"
                style="@style/Styles.Text.Footnote.Medium"
                tools:text="SAR VALUE"/>

            <TextView
                android:id="@+id/tv_sar_value"
                style="@style/Styles.Text.LargeTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAlignment="viewEnd"
                android:textColor="@color/white"
                android:textSize="25sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toEndOf="@+id/constraintLayout"
                app:layout_constraintTop_toBottomOf="@id/tv_sar_value_label"
                app:layout_constraintWidth_max="200dp"
                tools:text="1900.00" />




        </androidx.constraintlayout.widget.ConstraintLayout>






    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/fm_shimmer_loyalty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/placeholder_color"/>

    </com.facebook.shimmer.ShimmerFrameLayout>



</com.google.android.material.card.MaterialCardView>
