<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7">


    <include
        android:id="@+id/placeholder_order_details"
        layout="@layout/placeholder_order_details"
        android:visibility="visible"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_order_details"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="#F7F7F7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatTextView
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:id="@+id/your_order_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:gravity="start"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="@color/primaryTextColor"
            android:textSize="15sp"
            android:layout_marginStart="8dp"
            style="@style/Styles.Text.Title1"
            tools:text="YOUR ORDER (3)"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_cart_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@+id/your_order_label"
            tools:itemCount="3"
            tools:listitem="@layout/item_cart"
            tools:visibility="visible" />

        <include
            android:id="@+id/layout_item_coupons"
            layout="@layout/item_cart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/rv_cart_items"/>

        <com.google.android.material.button.MaterialButton
            android:backgroundTint="@color/white"
            android:id="@+id/add_more"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:insetRight="0dp"
            android:insetLeft="0dp"
            android:insetBottom="0dp"
            android:insetTop="0dp"
            android:gravity="center"
            android:textColor="#0064AC"
            android:textSize="14sp"
            app:cornerRadius="20dp"
            app:strokeColor="#0064AC"
            app:strokeWidth="1dp"
            app:elevation="9dp"
            android:textAllCaps="false"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_item_coupons"
            tools:enabled="true"
            android:text="Add more item" />


        <androidx.appcompat.widget.AppCompatTextView
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/add_more"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:id="@+id/promotion_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="32dp"
            android:includeFontPadding="false"
            android:textColor="#D12928"
            android:textStyle="bold"
            android:textSize="11sp"
            android:visibility="gone"
            android:text="Add 2 more items to your order to unlock free delivery!" />





    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
