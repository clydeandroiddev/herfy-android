<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content_main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="#F7F7F7">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/payment_summary_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ln_payment_details"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_coupon_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#E6F0F7"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="true"
                app:cardUseCompatPadding="false">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/main_coupon_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="16dp">

                    <LinearLayout
                        android:id="@+id/apply_coupon_container"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="visible"
                        android:weightSum="2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_weight="2"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_coupon"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="center_vertical"
                                android:src="@drawable/ic_apply_coupon" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_vertical"
                                android:layout_marginStart="6dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/apply_coupon_label"
                                    style="@style/Styles.Text.SmallTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:ellipsize="end"
                                    android:gravity="center_vertical"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textAlignment="viewStart"
                                    android:textColor="@color/primaryTextColor"
                                    android:textSize="14sp"
                                    tools:text="Apply a coupon" />

                                <TextView
                                    android:id="@+id/tv_coupon_description"
                                    style="@style/Styles.Text.Caption.Regular"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center_vertical"
                                    android:layout_marginTop="6dp"
                                    android:ellipsize="end"
                                    android:gravity="center_vertical"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textAlignment="viewStart"
                                    android:textColor="@color/secondaryTextColor"
                                    android:textSize="11sp"
                                    tools:text="Apply a coupon" />

                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/view_coupon"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_gravity="end"
                            android:backgroundTint="@color/background_color_blue"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            app:cornerRadius="20dp"
                            tools:text="View Coupons" />

                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/applied_coupon_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_coupon" />

                            <TextView
                                android:id="@+id/applied_coupon_label"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:textAlignment="viewEnd"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                tools:text="Coupon Applied" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/coupon_icon"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:src="@drawable/image_placeholder"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <androidx.appcompat.widget.LinearLayoutCompat
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    app:layout_constraintBottom_toBottomOf="@+id/coupon_icon"
                                    app:layout_constraintStart_toEndOf="@+id/coupon_icon"
                                    app:layout_constraintTop_toTopOf="@+id/coupon_icon">

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:id="@+id/coupon_name"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:includeFontPadding="false"
                                        android:textColor="@color/black"
                                        android:textSize="15sp"
                                        android:textStyle="bold"
                                        tools:text="Coupon Name" />

                                    <androidx.appcompat.widget.AppCompatTextView
                                        android:id="@+id/coupon_amount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="match_parent"
                                        android:layout_marginStart="8dp"
                                        android:layout_marginTop="4dp"
                                        android:ellipsize="end"
                                        android:gravity="start|bottom"
                                        android:includeFontPadding="false"
                                        android:maxLines="1"
                                        android:textAlignment="viewStart"
                                        android:textColor="@color/black"
                                        android:textSize="15sp"
                                        tools:text="Amount" />
                                </androidx.appcompat.widget.LinearLayoutCompat>

                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <TextView
                                android:id="@+id/remove_coupon"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="end|center_vertical"
                                android:includeFontPadding="false"
                                android:textAlignment="viewEnd"
                                android:textAllCaps="true"
                                android:textColor="#6B7280"
                                android:textSize="12sp"
                                tools:text="REMOVE" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/ln_coupons_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/main_coupon_container">

                <TextView
                    android:id="@+id/tv_enter_coupon"
                    style="@style/Styles.Text.Caption.Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primaryTextColor"
                    android:textSize="14sp"
                    tools:text="Enter coupon code?" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:layout_height="wrap_content">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/til_coupon"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="8dp"
                        app:strokeColor="@color/input_border_color"
                        app:strokeWidth=".5dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/tie_coupon"
                            style="@style/Styles.Text.Caption.Regular"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?selectableItemBackground"
                            android:hint="e.g. 100Sale12"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="13dp"
                            android:textColor="@color/secondaryTextColor"
                            android:textSize="12sp" />

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_paste"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginEnd="16dp"
                        android:textAllCaps="false"
                        android:textAppearance="@style/TextAppearance.Caption"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        app:backgroundTint="@color/background_color_blue"
                        app:cornerRadius="24dp"
                        app:layout_constraintBottom_toBottomOf="@id/til_coupon"
                        app:layout_constraintEnd_toEndOf="@id/til_coupon"
                        app:layout_constraintTop_toTopOf="@id/til_coupon" />

                </androidx.constraintlayout.widget.ConstraintLayout>


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_apply"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:textAllCaps="false"
                    android:textAppearance="@style/TextAppearance.Caption"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:backgroundTint="@color/background_color_blue"
                    app:cornerRadius="24dp" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/payment_summary_label"
                style="@style/Styles.Text.SmallTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="start"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Payment Summary"
                android:textAlignment="viewStart"
                android:textColor="@color/primary_text"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/subtotal_label"
                    style="@style/TextAppearance.Footnote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:textAlignment="viewStart"
                    android:textColor="#55667B"
                    android:textSize="14sp"
                    tools:text="Subtotal" />

                <TextView
                    android:id="@+id/subtotal"
                    style="@style/Styles.Text.SmallTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:textAlignment="viewEnd"
                    android:textAllCaps="true"
                    android:textColor="@color/primaryTextColor"
                    android:textDirection="ltr"
                    android:textSize="12sp"
                    tools:text="55 SR" />

            </LinearLayout>


            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/colorSeparator" />

            <LinearLayout
                android:id="@+id/discount_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/coupon_discount_label"
                        style="@style/TextAppearance.Footnote"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:textAlignment="viewStart"
                        android:textColor="#55667B"
                        android:textSize="14sp"
                        tools:text="Discount" />

                    <TextView
                        android:id="@+id/coupon_discount"
                        style="@style/Styles.Text.SmallTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:textAlignment="viewEnd"
                        android:textAllCaps="true"
                        android:textColor="@color/primaryTextColor"
                        android:textDirection="ltr"
                        android:textSize="12sp"
                        tools:text="-2 SR" />
                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/colorSeparator" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/delivery_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/delivery_charge_label"
                        style="@style/TextAppearance.Footnote"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:includeFontPadding="false"
                        android:textAlignment="viewStart"
                        android:textColor="#55667B"
                        android:textSize="14sp"
                        tools:text="Delivery Charge" />

                    <TextView
                        android:id="@+id/delivery_charge"
                        style="@style/Styles.Text.SmallTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:textAlignment="viewEnd"
                        android:textAllCaps="true"
                        android:textColor="@color/primaryTextColor"
                        android:textDirection="ltr"
                        android:textSize="12sp"
                        tools:text="5 SR" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/colorSeparator" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/total_label"
                    style="@style/Styles.Text.Footnote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:textAlignment="viewStart"
                    android:textColor="#55667B"
                    android:textSize="14sp"
                    tools:text="Total" />

                <TextView
                    android:id="@+id/total"
                    style="@style/Styles.Text.SmallTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:includeFontPadding="false"
                    android:textAlignment="viewEnd"
                    android:textAllCaps="true"
                    android:textColor="@color/primaryTextColor"
                    android:textDirection="ltr"
                    android:textSize="12sp"
                    tools:text="55 SR" />

            </LinearLayout>


        </androidx.appcompat.widget.LinearLayoutCompat>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
