<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmer_order_details"
    android:layout_marginTop="37dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <View
            android:layout_width="150dp"
            android:layout_height="17dp"
            android:layout_marginHorizontal="16dp"
            android:background="@color/placeholder_color"/>

        <LinearLayout
            android:layout_marginTop="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="4dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/border_color_light"
                app:cardCornerRadius="20dp"
                app:strokeWidth="1dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="false"
                app:cardPreventCornerOverlap="true"
                android:layout_marginVertical="12dp"
                android:layout_marginHorizontal="12dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_margin="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_upsell_1"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardUseCompatPadding="false"
                        app:cardPreventCornerOverlap="true"
                        app:cardBackgroundColor="@color/placeholder_color"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>



                    <View
                        android:id="@+id/name_1"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:maxWidth="100dp"
                        android:background="@color/placeholder_color"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/cv_upsell_1" />

                    <View
                        android:id="@+id/modifier_items_1"
                        android:layout_width="60dp"
                        android:layout_height="13dp"
                        android:background="@color/placeholder_color"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@+id/name_1"
                       />

                    <View
                        android:id="@+id/total_price_1"
                        android:layout_width="60dp"
                        android:layout_height="13dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/placeholder_color"
                        app:layout_constraintTop_toBottomOf="@id/modifier_items_1"
                        app:layout_constraintStart_toStartOf="parent"/>


                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/border_color_light"
                app:cardCornerRadius="20dp"
                app:strokeWidth="1dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="false"
                app:cardPreventCornerOverlap="true"
                android:layout_marginVertical="12dp"
                android:layout_marginHorizontal="12dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_margin="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_upsell_2"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardUseCompatPadding="false"
                        app:cardPreventCornerOverlap="true"
                        app:cardBackgroundColor="@color/placeholder_color"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>



                    <View
                        android:id="@+id/name_2"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:maxWidth="100dp"
                        android:background="@color/placeholder_color"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/cv_upsell_2" />

                    <View
                        android:id="@+id/modifier_items_2"
                        android:layout_width="60dp"
                        android:layout_height="13dp"
                        android:background="@color/placeholder_color"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@+id/name_2"
                        />

                    <View
                        android:id="@+id/total_price_2"
                        android:layout_width="60dp"
                        android:layout_height="13dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/placeholder_color"
                        app:layout_constraintTop_toBottomOf="@id/modifier_items_2"
                        app:layout_constraintStart_toStartOf="parent"/>


                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/border_color_light"
                app:cardCornerRadius="20dp"
                app:strokeWidth="1dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="false"
                app:cardPreventCornerOverlap="true"
                android:layout_marginVertical="12dp"
                android:layout_marginHorizontal="12dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_margin="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_upsell_3"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardUseCompatPadding="false"
                        app:cardPreventCornerOverlap="true"
                        app:cardBackgroundColor="@color/placeholder_color"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>



                    <View
                        android:id="@+id/name_3"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:maxWidth="100dp"
                        android:background="@color/placeholder_color"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/cv_upsell_3" />

                    <View
                        android:id="@+id/modifier_items_3"
                        android:layout_width="60dp"
                        android:layout_height="13dp"
                        android:background="@color/placeholder_color"
                        android:layout_marginTop="4dp"
                        app:layout_constraintTop_toBottomOf="@+id/name_3"
                        />

                    <View
                        android:id="@+id/total_price_3"
                        android:layout_width="60dp"
                        android:layout_height="13dp"
                        android:layout_marginTop="4dp"
                        android:background="@color/placeholder_color"
                        app:layout_constraintTop_toBottomOf="@id/modifier_items_3"
                        app:layout_constraintStart_toStartOf="parent"/>


                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


    </LinearLayout>



</com.facebook.shimmer.ShimmerFrameLayout>
