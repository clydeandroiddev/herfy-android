<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/shimmer_coupon_items"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_details_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/background_coupon">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_iv_coupon_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent=".335"/>


                <ImageView
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/guide_iv_coupon_1"
                    android:background="@color/placeholder_color"
                    android:id="@+id/iv_coupon_1"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="28dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="16dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/guide_iv_coupon_1">

                    <View
                        android:layout_width="135dp"
                        android:layout_height="19dp"
                        android:background="@color/placeholder_color"
                        />

                    <View
                        android:layout_marginTop="5dp"
                        android:layout_width="100dp"
                        android:layout_height="13dp"
                        android:background="@color/placeholder_color"/>

                    <View
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/coupon_dash_seperator"/>

                    <View
                        android:layout_marginTop="10dp"
                        android:layout_width="100dp"
                        android:layout_height="13dp"
                        android:background="@color/placeholder_color"/>

                    <View
                        android:layout_marginTop="8dp"
                        android:layout_width="100dp"
                        android:layout_height="13dp"
                        android:background="@color/placeholder_color"/>

                </LinearLayout>




            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/ln_footer_coupon_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:backgroundTint="@color/white"
                app:layout_constraintStart_toStartOf="@id/cl_details_1"
                app:layout_constraintEnd_toEndOf="@id/cl_details_1"
                app:layout_constraintTop_toBottomOf="@id/cl_details_1"
                android:background="@drawable/background_lock_redeem"
                >

                <ImageView
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:layout_marginEnd="5dp"/>

                <View
                    android:layout_width="150dp"
                    android:layout_height="13dp"
                    android:background="@color/placeholder_color"/>


            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_details_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/background_coupon">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_iv_coupon_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent=".335"/>


                <ImageView
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/guide_iv_coupon_2"
                    android:background="@color/placeholder_color"
                    android:id="@+id/iv_coupon_2"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="28dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="16dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/guide_iv_coupon_2">

                    <View
                        android:layout_width="135dp"
                        android:layout_height="19dp"
                        android:background="@color/placeholder_color"
                        />

                    <View
                        android:layout_marginTop="5dp"
                        android:layout_width="100dp"
                        android:layout_height="13dp"
                        android:background="@color/placeholder_color"/>

                    <View
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/coupon_dash_seperator"/>

                    <View
                        android:layout_marginTop="10dp"
                        android:layout_width="100dp"
                        android:layout_height="13dp"
                        android:background="@color/placeholder_color"/>

                    <View
                        android:layout_marginTop="8dp"
                        android:layout_width="100dp"
                        android:layout_height="13dp"
                        android:background="@color/placeholder_color"/>

                </LinearLayout>




            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/ln_footer_coupon_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:backgroundTint="@color/white"
                app:layout_constraintStart_toStartOf="@id/cl_details_2"
                app:layout_constraintEnd_toEndOf="@id/cl_details_2"
                app:layout_constraintTop_toBottomOf="@id/cl_details_2"
                android:background="@drawable/background_lock_redeem"
                >

                <ImageView
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:layout_marginEnd="5dp"/>

                <View
                    android:layout_width="150dp"
                    android:layout_height="13dp"
                    android:background="@color/placeholder_color"/>


            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_details_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/background_coupon">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_iv_coupon_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent=".335"/>


                <ImageView
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/guide_iv_coupon_3"
                    android:background="@color/placeholder_color"
                    android:id="@+id/iv_coupon_3"
                    android:layout_width="0dp"
                    android:layout_height="0dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="28dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="16dp"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/guide_iv_coupon_3">

                    <View
                        android:layout_width="135dp"
                        android:layout_height="19dp"
                        android:background="@color/placeholder_color"
                        />

                    <View
                        android:layout_marginTop="5dp"
                        android:layout_width="100dp"
                        android:layout_height="13dp"
                        android:background="@color/placeholder_color"/>

                    <View
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/coupon_dash_seperator"/>

                    <View
                        android:layout_marginTop="10dp"
                        android:layout_width="100dp"
                        android:layout_height="13dp"
                        android:background="@color/placeholder_color"/>

                    <View
                        android:layout_marginTop="8dp"
                        android:layout_width="100dp"
                        android:layout_height="13dp"
                        android:background="@color/placeholder_color"/>

                </LinearLayout>




            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/ln_footer_coupon_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:backgroundTint="@color/white"
                app:layout_constraintStart_toStartOf="@id/cl_details_3"
                app:layout_constraintEnd_toEndOf="@id/cl_details_3"
                app:layout_constraintTop_toBottomOf="@id/cl_details_3"
                android:background="@drawable/background_lock_redeem"
                >

                <ImageView
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:layout_marginEnd="5dp"/>

                <View
                    android:layout_width="150dp"
                    android:layout_height="13dp"
                    android:background="@color/placeholder_color"/>


            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</com.facebook.shimmer.ShimmerFrameLayout>