<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/content_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F7">

    <com.herfy.common.toolbar.TitleToolbar
        android:id="@+id/toolbar_title"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#F7F7F7"
        app:rightButtonColor="#0064AC"
        android:paddingHorizontal="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_details"
        app:layout_constraintTop_toBottomOf="@id/toolbar_title"
        app:layout_constraintBottom_toTopOf="@id/footer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <include
                android:id="@+id/order_type_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/layout_order_type" />

            <include
                android:id="@+id/order_details_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/layout_order_details" />


            <include
                android:id="@+id/upsell_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/layout_upsell" />

            <include
                android:id="@+id/payment_summary_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                layout="@layout/layout_payment_details"
                app:layout_constraintBottom_toBottomOf="parent"/>


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E6F0F7"
        app:layout_constraintTop_toBottomOf="@id/nsv_details"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <LinearLayout
            android:id="@+id/ln_minimum_cart_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/common_background_blue_minimum_cart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <ImageView
                android:src="@drawable/ic_circle_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:layout_marginStart="8dp"
                android:id="@+id/tv_minimum_cart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/white"
                style="@style/Styles.Text.Caption.Regular"
                tools:text="Add SAR 5 to reach minimum order value of SAR 10."/>

        </LinearLayout>

        <ImageView
            android:id="@+id/iv_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/img_cart_footer"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ln_minimum_cart_amount"/>



        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp"
            app:layout_constraintTop_toBottomOf="@id/iv_footer">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.42" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/original_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0064AC"
                android:textSize="15sp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/footer_total_price"
                app:layout_constraintStart_toStartOf="parent"
                android:includeFontPadding="false"
                tools:text="SAR 26" />

            <View
                android:id="@+id/dashed"
                android:layout_width="0dp"
                android:layout_height="1.1dp"
                android:layout_marginStart="6dp"
                android:background="@color/home_indicator"
                app:layout_constraintBottom_toBottomOf="@id/original_price"
                app:layout_constraintEnd_toEndOf="@id/original_price"
                app:layout_constraintTop_toTopOf="@id/original_price" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/footer_total_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0064AC"
                android:textSize="28sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:layout_marginTop="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/center"
                app:layout_constraintHorizontal_bias="0.0"
                tools:text="SAR 25" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/total_vat_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#0064AC"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@+id/footer_total_price"
                app:layout_constraintEnd_toStartOf="@+id/center"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                android:includeFontPadding="false"
                tools:text="Total is inclusive of VAT" />


            <com.google.android.material.button.MaterialButton
                android:backgroundTint="#0064AC"
                app:backgroundTint="#0064AC"
                android:id="@+id/place_order"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:enabled="false"
                android:gravity="center"
                android:textColor="@color/white"
                android:textAppearance="@style/TextAppearance.Title1"
                android:textSize="16sp"
                android:insetRight="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                app:cornerRadius="24dp"
                android:textAllCaps="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/center"
                app:layout_constraintTop_toTopOf="@id/footer_total_price"
                tools:enabled="true"
                tools:text="Checkout" />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>




</androidx.constraintlayout.widget.ConstraintLayout>
