<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/choose_method_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter_bold"
        android:text="CHOOSE PAYMENT METHOD"
        android:textAllCaps="true"
        android:textColor="@color/cod_gray"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/payment_type_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/choose_method_label" />

    <include
        android:id="@+id/inc"
        layout="@layout/item_payment_card"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/payment_type_container" />

    <!--                Mokafaa-->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_mukafaa"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/inc"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="1dp"
        tools:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_mukafaa_container"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/card_img_mukafaa"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:scaleType="centerInside"
                android:src="@drawable/ic_al_rajhi_bank"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/card_tv_mukafaa_bank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semi_bold"
                android:gravity="start"
                android:includeFontPadding="true"
                android:lineSpacingExtra="-8dp"
                android:maxLines="1"
                android:layout_marginStart="18dp"
                android:text="Al Rajhi Bank (Mokafa’a Rewards)"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/card_img_mukafaa"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/card_mukafaa_image_selected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_chevron_right"
                android:layout_marginEnd="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />




            <View
                android:id="@+id/alrhaji_border"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/gray_400"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/card_tv_mukafaa_bank" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!--Mukafaa Numbers-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mukafaa_number"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_mukafaa"
        tools:visibility="gone">

        <TextView
            android:id="@+id/disclaimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="80dp"
            android:fontFamily="@font/inter_regular"
            android:includeFontPadding="true"
            android:lineSpacingExtra="-8dp"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Disclaimer: The user has to be a registered mobile number with Mokafa'a Al Rajhi Program, otherwise the redemption will not be successful." />

        <TextView
            android:id="@+id/phone_number_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="80dp"
            android:fontFamily="@font/inter_bold"
            android:includeFontPadding="true"
            android:lineSpacingExtra="-8dp"
            android:textColor="#4D000000"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/disclaimer"
            tools:text="Mobile Number" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/phone_number_layout"
            android:layout_width="0dp"
            android:layout_height="52dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="6dp"
            app:cardElevation="4dp"
            app:cardPreventCornerOverlap="true"
            app:cardUseCompatPadding="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/phone_number_label">

            <EditText
                android:id="@+id/phone_number"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@null"
                android:fontFamily="@font/inter_bold"
                android:hint="xxxxxxxxxx"
                android:includeFontPadding="true"
                android:inputType="phone"
                android:lineSpacingExtra="-8dp"
                android:paddingStart="16dp"
                android:textAlignment="viewStart"
                android:textColor="#303030"
                android:textColorHint="#858585"
                android:textCursorDrawable="@drawable/cursor"
                android:textSize="14sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/or"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="80dp"
            android:fontFamily="@font/inter_bold"
            android:includeFontPadding="true"
            android:lineSpacingExtra="-8dp"
            android:textAllCaps="true"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/phone_number_layout"
            tools:text="OR" />

        <TextView
            android:id="@+id/loyalty_number_lbl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="80dp"
            android:fontFamily="@font/inter_bold"
            android:includeFontPadding="true"
            android:lineSpacingExtra="-8dp"
            android:textColor="#4D000000"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/or"
            tools:text="Loyalty CIC Number" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/loyalty_number_layout"
            android:layout_width="0dp"
            android:layout_height="52dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="6dp"
            app:cardElevation="4dp"
            app:cardPreventCornerOverlap="true"
            app:cardUseCompatPadding="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/loyalty_number_lbl">

            <EditText
                android:id="@+id/loyalty_number"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:background="@null"
                android:fontFamily="@font/inter_bold"
                android:hint="xxxxxxxxxxx"
                android:includeFontPadding="true"
                android:inputType="number"
                android:lineSpacingExtra="-8dp"
                android:paddingStart="16dp"
                android:textAlignment="viewStart"
                android:textColor="#303030"
                android:textColorHint="#858585"
                android:textCursorDrawable="@drawable/cursor"
                android:textSize="14sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>


    </androidx.constraintlayout.widget.ConstraintLayout>
--

</androidx.constraintlayout.widget.ConstraintLayout>