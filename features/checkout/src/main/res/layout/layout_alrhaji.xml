<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white"
    app:cardUseCompatPadding="false"
    android:layout_marginStart="@dimen/margin_small"
    android:layout_marginEnd="@dimen/margin_small"
    android:layout_marginBottom="@dimen/margin_large">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">

        <FrameLayout
            android:id="@+id/fm_alrhaji_logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/background_alrhaji_logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:id="@+id/iv_alrajhi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_alrhaji_logo"
                android:layout_gravity="center"/>
        </FrameLayout>

        <TextView
            android:id="@+id/tv_alrhaji_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/primaryTextColor"
            android:textSize="14sp"
            style="@style/TextAppearance.Headline1"
            android:maxLines="1"
            app:layout_constraintStart_toEndOf="@id/fm_alrhaji_logo"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="11dp"
            tools:text="Al Rhaji Bank (Mokafa's Rewards)"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="3"
            android:textSize="11sp"
            android:textColor="@color/secondaryTextColor"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/tv_alrhaji_label"
            app:layout_constraintTop_toBottomOf="@id/tv_alrhaji_label"
            app:layout_constraintEnd_toStartOf="@id/switch_alrahji"
            android:layout_marginEnd="8dp"
            tools:text="The user has to be a registered mobile number with Mokafa'a Al Rajhi Program, otherwise the redemption will not be successful."/>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_alrahji"
            android:layout_width="60dp"
            android:layout_height="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>