<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_alrhaji"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/radius_large"
        app:cardElevation="4dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_alrhaji"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:visibility="visible">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/placeholder_color" />

        </com.facebook.shimmer.ShimmerFrameLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_alrhaji_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/disabled_message_alrhaji"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:background="#E6F0F7"
                android:paddingHorizontal="12dp"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/info_blue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_info_blue"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/alrhaji_disabled_message"
                    style="@style/Styles.Text.Footnote.Regular_Large"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#0064AC"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/info_blue"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="This option only work for online payments" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_alrhaji"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:paddingBottom="10dp"
                app:layout_constraintTop_toBottomOf="@id/disabled_message_alrhaji">

                <FrameLayout
                    android:id="@+id/fm_alrhaji_logo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/background_alrhaji_logo"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/iv_alrajhi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_alrhaji_logo" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_alrhaji_label"
                    style="@style/TextAppearance.Headline1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/primaryTextColor"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toStartOf="@+id/switch_alrahji"
                    app:layout_constraintStart_toEndOf="@id/fm_alrhaji_logo"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Al Rhaji Bank (Mokafa's Rewards)" />

                <TextView
                    android:id="@+id/tv_alrhaji_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="8dp"
                    android:lines="3"
                    android:textColor="@color/secondaryTextColor"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toStartOf="@id/switch_alrahji"
                    app:layout_constraintStart_toStartOf="@id/tv_alrhaji_label"
                    app:layout_constraintTop_toBottomOf="@id/tv_alrhaji_label"
                    tools:text="The user has to be a registered mobile number with Mokafa'a Al Rajhi Program, otherwise the redemption will not be successful." />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_alrahji"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/thumb_selector"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:track="@drawable/track_selector" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</layout>
