<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingBottom="16dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/image_view"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_ellipse_placeholder"
        app:layout_constraintBottom_toBottomOf="@+id/tv_loyalty_points"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_loyalty_points_label" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_loyalty_points_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="Use Loyalty Points"
        android:textColor="@color/black"
        android:textSize="12sp"
        android:fontFamily="@font/inter_semi_bold"
        app:layout_constraintStart_toEndOf="@+id/image_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_loyalty_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter_regular"
        android:textColor="@color/black"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/tv_loyalty_points_label"
        app:layout_constraintTop_toBottomOf="@+id/tv_loyalty_points_label"
        app:layout_constraintVertical_bias="0.0"
        tools:text="1900 points" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/loyalty_switch"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:checked="true"
        android:thumb="@drawable/thumb_selector"
        app:track="@drawable/track_selector"
        app:layout_constraintBottom_toBottomOf="@+id/tv_loyalty_points"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintTop_toTopOf="@+id/tv_loyalty_points_label"/>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_loyalty_points"
        app:layout_constraintVertical_bias="1.0"
        android:visibility="gone">
        
        

        <TextView
            android:id="@+id/tv_points_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_semi_bold"
            android:textColor="@color/black"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Points" />


        <androidx.cardview.widget.CardView
            android:id="@+id/points_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="2dp"
            app:cardBackgroundColor="@color/gray_600"
            app:cardCornerRadius="5dp"
            app:cardPreventCornerOverlap="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/imageView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_points_label"
            app:layout_constraintVertical_bias="0.0"
            app:strokeColor="@color/gray_400"
            app:strokeWidth="2dp">

            <EditText
                android:id="@+id/et_points"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="@font/inter_semi_bold"
                android:paddingStart="16dp"
                tools:text="500"
                android:textSize="18sp" />
        </androidx.cardview.widget.CardView>




        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="20dp"
            app:layout_constraintGuide_percent=".5" />

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_double_arrow"
            app:layout_constraintBottom_toBottomOf="@+id/sar_amount_card"
            app:layout_constraintEnd_toStartOf="@+id/guideline"
            app:layout_constraintStart_toStartOf="@+id/guideline"
            app:layout_constraintTop_toTopOf="@+id/sar_amount_card" />

        <TextView
            android:id="@+id/tv_sar_amount_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/inter_semi_bold"
            android:textColor="@color/black"
            android:textSize="11sp"
            app:layout_constraintStart_toEndOf="@+id/imageView"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="SAR Amount" />


        <androidx.cardview.widget.CardView
            android:id="@+id/sar_amount_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/gray_600"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            app:cardCornerRadius="5dp"
            app:cardPreventCornerOverlap="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/imageView"
            app:layout_constraintTop_toBottomOf="@+id/tv_sar_amount_label"
            app:layout_constraintVertical_bias="0.0"
            app:strokeColor="@color/gray_600"
            app:strokeWidth="4dp">

            <EditText
                android:id="@+id/et_sar_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:fontFamily="@font/inter_semi_bold"
                android:paddingStart="16dp"
                android:textSize="18sp"
                tools:text="5" />

        </androidx.cardview.widget.CardView>


    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>