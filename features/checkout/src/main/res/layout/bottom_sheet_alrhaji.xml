<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_rounded_corner_top_24dp">

        <LinearLayout
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="0px"
            android:layout_height="0px"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <ImageButton
            android:id="@+id/ib_close"
            android:background="?selectableItemBackground"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_plain_close"
            android:layout_marginTop="22dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <ImageView
            android:id="@+id/iv_alrajhi"
            android:layout_width="131dp"
            android:layout_height="64dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:src="@drawable/ic_al_rajhi_bank"/>

        <View
            android:id="@+id/line_sep"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="-2dp"
            android:layout_marginHorizontal="16dp"
            android:background="@color/colorSeparator"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_alrajhi"/>

        <TextView
            android:id="@+id/tv_alrhaji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="23dp"
            android:textColor="@color/primaryTextColor"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/line_sep"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Al Rhaji Bank (Mokafa's Rewards)"
            style="@style/Styles.Text.Headline1"/>

        <TextView
            android:id="@+id/tv_alrhaji_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:textSize="11sp"
            android:textColor="@color/secondaryTextColor"
            android:layout_marginHorizontal="39dp"
            android:gravity="center_horizontal"
            android:textAlignment="center"
            app:layout_constraintTop_toBottomOf="@id/tv_alrhaji"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="visible"
            tools:text="The user has to be a registered mobile number with Mokafa'a Al Rajhi Program, otherwise the redemption will not be successful."/>

        <LinearLayout
            android:id="@+id/ln_input_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp"
            android:orientation="vertical"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@id/tv_alrhaji_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_mobile_number_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primaryTextColor"
                android:textSize="14sp"
                style="@style/Styles.Text.Headline1"
                tools:text="Mobile Number"
                android:layout_marginHorizontal="16dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_mobile_number"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                app:strokeWidth=".5dp"
                app:strokeColor="@color/input_border_color"
                app:cardBackgroundColor="@color/white"
                android:layout_marginHorizontal="16dp">

                <EditText
                    android:id="@+id/et_mobile_number"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:textSize="14sp"
                    android:maxLength="12"
                    android:textColor="@color/secondaryTextColor"
                    android:textAppearance="@style/TextAppearance.Body.Medium"
                    android:layout_gravity="center_vertical"
                    android:layout_marginHorizontal="16dp"
                    tools:text="testing"
                    android:inputType="phone"/>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/ln_or_sep"
                android:layout_marginTop="25dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="16dp">

                <View
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/colorSeparator"/>

                <TextView
                    android:id="@+id/tv_or"
                    android:layout_width="25dp"
                    android:layout_height="wrap_content"
                    tools:text="OR"
                    android:textSize="11sp"
                    android:textColor="@color/secondaryTextColor"
                    style="@style/Styles.Text.Body.Medium"
                    android:textAllCaps="true"
                    android:layout_gravity="center"
                    android:gravity="center"/>

                <View
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/colorSeparator"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_cic_number_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primaryTextColor"
                android:textSize="14sp"
                style="@style/Styles.Text.Headline1"
                android:layout_marginTop="25dp"
                tools:text="CIC Number"
                android:layout_marginHorizontal="16dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_cic_number"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                app:strokeWidth=".5dp"
                app:strokeColor="@color/input_border_color"
                app:cardBackgroundColor="@color/white"
                android:layout_marginHorizontal="16dp">

                <EditText
                    android:id="@+id/et_cic_number"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:textSize="14sp"
                    android:textColor="@color/secondaryTextColor"
                    android:textAppearance="@style/TextAppearance.Body.Medium"
                    android:layout_gravity="center_vertical"
                    android:layout_marginHorizontal="16dp"
                    tools:text="testing"
                    android:maxLength="16"
                    android:inputType="number"/>

            </com.google.android.material.card.MaterialCardView>


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="46dp"
                android:background="@color/card_selected_bg"
                android:padding="16dp">


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_request"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/background_color_blue"
                    app:cornerRadius="30dp"
                    android:layout_marginVertical="8dp"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:textAppearance="@style/TextAppearance.Headline1"
                    tools:text="Redeem" />


            </FrameLayout>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/ln_input_otp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tv_alrhaji_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_input_otp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primaryTextColor"
                android:textSize="14sp"
                style="@style/Styles.Text.Body.Medium"
                tools:text="Enter the 4 digit code sent to your"
                android:layout_marginHorizontal="16dp"
                android:includeFontPadding="false"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp">

                <TextView
                    android:id="@+id/tv_mobile_number_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/background_color_blue"
                    style="@style/Styles.Text.Body.Medium"
                    android:includeFontPadding="false"
                    tools:text="+966123456789"/>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_edit_mobile_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/background_color_blue"
                    style="@style/Styles.Text.Body.Medium"
                    android:includeFontPadding="false"
                    tools:text="Edit"
                    android:drawablePadding="4dp"
                    app:drawableStartCompat="@drawable/ic_edit" />
            </LinearLayout>

            <com.mukeshsolanki.OtpView
                android:id="@+id/otp_alrhaji"
                android:layout_marginTop="24dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:inputType="number"
                app:itemCount="4"
                android:textColor="@color/secondaryTextColor"
                app:OtpItemSpacing="12dp"
                app:OtpItemWidth="81dp"
                app:itemRadius="8dp"
                app:OtpViewType="none"
                android:itemBackground="@drawable/background_otp"
                android:layout_gravity="center_horizontal"
                android:gravity="center_horizontal"
                app:OtpState_filled="true"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginHorizontal="16dp">

                <TextView
                    android:layout_weight="1"
                    android:id="@+id/tv_resend_code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/primaryTextColor"
                    style="@style/Styles.Text.Body.Medium"
                    android:includeFontPadding="false"
                    tools:text="Did not get the code?"
                    android:gravity="center_vertical"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_resend"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="19dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/background_color_blue"
                    app:strokeWidth="1dp"
                    app:cornerRadius="20dp">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_resend"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.Caption.Semibold"
                            android:textColor="@color/background_color_blue"
                            tools:text="Send again"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


            </LinearLayout>


            <TextView
                android:id="@+id/tv_amount_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primaryTextColor"
                android:textSize="14sp"
                style="@style/Styles.Text.Headline1"
                android:layout_marginTop="31dp"
                tools:text="Amount"
                android:layout_marginHorizontal="16dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_amount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                app:strokeWidth=".5dp"
                app:strokeColor="@color/input_border_color"
                app:cardBackgroundColor="@color/white"
                android:layout_marginHorizontal="16dp">

                <EditText
                    android:id="@+id/et_amount"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:textSize="14sp"
                    android:textColor="@color/secondaryTextColor"
                    android:textAppearance="@style/TextAppearance.Body.Medium"
                    android:layout_gravity="center_vertical"
                    android:layout_marginHorizontal="16dp"
                    tools:text="testing"
                    android:inputType="numberDecimal"/>

            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:id="@+id/tv_amount_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                android:drawablePadding="6dp"
                android:textColor="@color/text_color_red"
                android:textSize="14sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_error"
                tools:text="Amount cannot exceed the total amount"
                style="@style/TextAppearance.Headline1"

                />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="46dp"
                android:background="@color/card_selected_bg"
                android:padding="16dp">


                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_submit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/background_color_blue"
                    app:cornerRadius="30dp"
                    android:layout_marginVertical="8dp"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:textAppearance="@style/TextAppearance.Headline1"
                    tools:text="Submit" />


            </FrameLayout>


        </LinearLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
