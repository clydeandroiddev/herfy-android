<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/light_gray">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@+id/payment_footer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <include
                android:id="@+id/toolbar_layout"
                layout="@layout/toolbar_layout" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/nestedScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:layout_marginStart="@dimen/margin_large"
                        android:layout_marginEnd="@dimen/margin_large"
                        android:background="#E6E8EB" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:orientation="horizontal"
                        android:padding="@dimen/padding_large">


                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/imageView2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_schedule_v2"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_within"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/tv_within" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_time_label"
                            style="@style/Styles.Text.Footnote.Semi.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_small"
                            android:drawableStart="@drawable/ic_alarm"
                            android:drawablePadding="@dimen/padding_small"
                            android:fontFamily="@font/inter_semi_bold"
                            android:textColor="@color/color_dark_gray_blue"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/tv_within"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintStart_toEndOf="@+id/imageView2"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="Delivery time" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/tv_within"
                            style="@style/Styles.Text.Footnote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/color_gray"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="Within 20 -40 mins" />

                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/constraintLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:background="@color/light_gray"
                        app:layout_constraintBottom_toTopOf="@+id/layout_payment"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.0">


                        <fragment
                            android:id="@+id/checkout_map"
                            android:name="com.herfy.common.base.OrderSupportMapFragment"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_200sdp"
                            android:layout_marginStart="@dimen/margin_large"
                            android:layout_marginEnd="@dimen/margin_large"
                            app:layout_constraintBottom_toTopOf="@+id/branch_image_container"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />


                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/branch_image_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin_large"
                            android:background="@color/card_selected_bg"
                            android:padding="@dimen/margin_small"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/checkout_map">

                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_order_type"
                                android:layout_width="@dimen/_55sdp"
                                android:layout_height="@dimen/_55sdp"
                                android:layout_marginStart="@dimen/margin_small"
                                android:background="@color/white"
                                android:padding="@dimen/padding_small"
                                android:scaleType="centerInside"
                                app:layout_constraintBottom_toBottomOf="@+id/tv_branch_name"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="@+id/tv_order_type"
                                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Image.Circle"
                                app:strokeColor="@color/background_color_light_blue"
                                app:strokeWidth="@dimen/_2sdp"
                                tools:src="@tools:sample/avatars" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_order_type"
                                style="@style/TextAppearance.Footnote.Semi_Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:textColor="@color/black"
                                app:layout_constraintEnd_toEndOf="@+id/tv_branch_name"
                                app:layout_constraintHorizontal_bias="0.0"
                                app:layout_constraintStart_toEndOf="@+id/iv_order_type"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:text="Pickup" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_branch_name"
                                style="@style/TextAppearance.Footnote.Medium_Regular"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_small"
                                android:layout_marginEnd="@dimen/margin_large"
                                android:textColor="@color/black"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHorizontal_bias="0.0"
                                app:layout_constraintStart_toEndOf="@+id/iv_order_type"
                                app:layout_constraintTop_toBottomOf="@+id/tv_order_type"
                                tools:text="UAT Herfy 272" />


                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/delivery_details_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:visibility="visible"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="@dimen/radius_large"
                        app:cardPreventCornerOverlap="true"
                        app:cardUseCompatPadding="true"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:strokeColor="#D9E8F3"
                        app:strokeWidth="@dimen/_1sdp"
                        tools:visibility="visible">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="@dimen/padding_large">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_mobile_number"
                                android:layout_width="@dimen/_45sdp"
                                android:layout_height="@dimen/_45sdp"
                                android:background="@drawable/unselected_image_bg"
                                android:padding="@dimen/padding_large"
                                android:src="@drawable/ic_mobile"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tv_mobile_number"
                                style="@style/Styles.Text.Footnote.Regular_Large"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_12sdp"
                                android:textColor="@color/black"
                                app:layout_constraintBottom_toBottomOf="@+id/iv_mobile_number"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintHorizontal_bias="0.0"
                                app:layout_constraintStart_toEndOf="@+id/iv_mobile_number"
                                app:layout_constraintTop_toTopOf="@+id/iv_mobile_number"
                                tools:text="+966-5671982192" />


                            <View
                                android:id="@+id/view_delivery"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_1sdp"
                                android:layout_marginTop="@dimen/_12sdp"
                                android:background="@color/colorSeparator"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/iv_mobile_number" />


                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/iv_delivery_note"
                                android:layout_width="@dimen/_45sdp"
                                android:layout_height="@dimen/_45sdp"
                                android:layout_marginTop="@dimen/_12sdp"
                                android:background="@drawable/unselected_image_bg"
                                android:padding="@dimen/padding_large"
                                android:src="@drawable/ic_note"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/view_delivery" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:gravity="center_vertical"
                                android:orientation="vertical"
                                android:layout_gravity="center"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintBottom_toBottomOf="@+id/iv_delivery_note"
                                app:layout_constraintStart_toEndOf="@+id/iv_delivery_note"
                                app:layout_constraintTop_toTopOf="@+id/iv_delivery_note">

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/tv_delivery_instruction_label"
                                    style="@style/TextAppearance.Footnote.Semi_Bold"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:fontFamily="@font/inter_medium"
                                    tools:text="Delivery Instruction"
                                    android:textAllCaps="false"
                                    android:textColor="@color/color_dark_gray"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/iv_delivery_note"
                                    app:layout_constraintTop_toTopOf="@+id/iv_delivery_note" />

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/tv_delivery_instruction"
                                    style="@style/Styles.Text.Footnote.Medium"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/_12sdp"
                                    android:ellipsize="end"
                                    android:maxLines="2"
                                    android:visibility="gone"
                                    tools:visibility="visible"
                                    android:textColor="@color/color_gray"
                                    app:layout_constraintBottom_toBottomOf="@+id/iv_delivery_note"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/iv_delivery_note"
                                    app:layout_constraintTop_toBottomOf="@+id/tv_delivery_instruction_label"
                                    tools:text="Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. It has survived not only five centuries, but also the leap into electronic typesetting, remaining essentially unchanged. It was popularised in the 1960s with the release of Letraset sheets containing Lorem Ipsum passages, and more recently with desktop publishing software like Aldus PageMaker including versions of Lorem Ipsum" />
                            </LinearLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <include
                        android:id="@+id/layout_payment"
                        layout="@layout/payment_method_new"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:layout_marginStart="@dimen/margin_small"
                        android:layout_marginEnd="@dimen/margin_small" />

                    <include
                        android:id="@+id/layout_alrahji"
                        layout="@layout/layout_alrhaji"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:layout_marginStart="@dimen/margin_small"
                        android:layout_marginEnd="@dimen/margin_small"/>

                    <include
                        android:id="@+id/layout_loyalty"
                        layout="@layout/item_loyalty_points"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/margin_small"
                        android:layout_marginTop="@dimen/margin_micro"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:layout_marginBottom="@dimen/_5sdp" />

                    <include
                        android:id="@+id/layout_payment_summary"
                        layout="@layout/payment_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:layout_marginBottom="@dimen/margin_xlarge"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />


                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/payment_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_checkout_footer"
            android:padding="@dimen/padding_large"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <View
                android:id="@+id/dashed"
                android:layout_width="0dp"
                android:layout_height="@dimen/_1sdp"
                android:layout_marginStart="6dp"
                android:background="@color/light_red"
                app:layout_constraintBottom_toBottomOf="@id/tv_original_price"
                app:layout_constraintEnd_toEndOf="@id/tv_original_price"
                app:layout_constraintTop_toTopOf="@id/tv_original_price" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_original_price"
                style="@style/Styles.Text.Footnote.Medium_Regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/light_red"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/tv_discounted_price"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="SAR 25" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_discounted_price"
                style="@style/Styles.Text.Title1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semi_bold"
                android:textColor="@color/selected_stroke_color"
                android:textSize="28sp"
                app:layout_constraintBottom_toTopOf="@+id/totalVatDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_original_price"
                tools:text="SAR 18.50" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/totalVatDescription"
                style="@style/TextAppearance.Caption.Regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/selected_stroke_color"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_discounted_price"
                tools:text="Total is inclusive of VAT" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/place_order"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_place_order_button"
                android:fontFamily="@font/inter_medium"
                android:gravity="center"
                android:paddingStart="@dimen/_30sdp"
                android:paddingTop="@dimen/padding_small"
                android:paddingEnd="@dimen/_30sdp"
                android:paddingBottom="@dimen/_8sdp"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:cornerRadius="@dimen/_24sdp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_discounted_price"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toEndOf="@+id/tv_discounted_price"
                app:layout_constraintTop_toTopOf="@+id/tv_discounted_price"
                tools:text="Place Order" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/blocker"
            android:alpha="0.5"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>