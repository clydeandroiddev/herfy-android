<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F7F7F7"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/dialogAlrajiCardView"
        style="@style/CustomCardViewStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"

        app:strokeColor="#D9E8F3"
        app:strokeWidth="1dp"
        tools:visibility="visible">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineLeft"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.05" />
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineRight"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.95" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideLineHalf"
                android:layout_width="wrap_content"
                app:layout_constraintGuide_percent="0.50"
                android:orientation="vertical"
                android:layout_height="wrap_content"/>


            <ImageView
                android:id="@+id/icClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_close_without_bg"
                app:layout_constraintBottom_toBottomOf="@+id/viewSeparator"
                app:layout_constraintStart_toStartOf="@+id/guidelineLeft"
                app:layout_constraintTop_toTopOf="parent" />
            <ImageView
                android:layout_width="131dp"
                android:src="@drawable/alraji_icon_with_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/viewSeparator"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_height="64dp"/>
            <View
                android:id="@+id/viewSeparator"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_large"
                android:background="#E6E8EB"
                app:layout_constraintStart_toStartOf="@+id/icClose"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@+id/icClose" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/viewSeparator"
                app:layout_constraintStart_toStartOf="parent"
                style="@style/Styles.Text.Footnote.Semi.Bold"
                android:layout_marginTop="@dimen/margin_xlarge"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text = "Al Rhaji Bank (Mokafa's Rewards)"
                android:layout_height="wrap_content"/>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtDescription"
                android:layout_width="0dp"
                app:layout_constraintStart_toStartOf="@+id/guidelineLeft"
                app:layout_constraintEnd_toEndOf="@+id/guidelineRight"
                android:gravity="center"
                android:layout_marginTop="@dimen/margin_small"
                android:layout_gravity="center_horizontal"
                app:layout_constraintTop_toBottomOf="@+id/txtTitle"
                tools:text="The user has to be a registered mobile number with Mokafa'a Al Rajhi Program, otherwise the redemption will not be successful."
                android:layout_height="wrap_content"/>
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/txtMobileNumber"
            android:layout_width="wrap_content"
            tools:text = "Mobile Number"
            style="@style/Styles.Text.Footnote.Semi.Bold"
            android:layout_marginTop="@dimen/margin_xlarge"
            app:layout_constraintTop_toBottomOf="@+id/txtDescription"
            app:layout_constraintStart_toStartOf="@+id/guidelineLeft"
            android:layout_height="wrap_content"/>

            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/mobileNumberEditText"
                style="@style/TextAppearance.Body"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/common_background_edit_field"
                android:digits="0123456789"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/margin_small"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:padding="15dp"
                android:layoutDirection="ltr"
                android:maxLength="9"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1C1C1E"
                android:textDirection="ltr"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="@+id/guidelineRight"
                app:layout_constraintTop_toBottomOf="@+id/txtMobileNumber"
                app:layout_constraintStart_toStartOf="@id/guidelineLeft">

            </androidx.appcompat.widget.AppCompatEditText>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtOr"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/margin_xlarge"
                tools:text = "OR"
                android:textAllCaps="true"
                style="@style/TextAppearance.Caption"
                android:textColor="#55667B"
                app:layout_constraintTop_toBottomOf="@+id/mobileNumberEditText"
                app:layout_constraintStart_toStartOf="@+id/guideLineHalf"
                android:layout_height="wrap_content"/>

            <View
                android:id="@+id/viewLeftSeparator"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginEnd="16dp"
                android:background="#E6E8EB"
                app:layout_constraintBottom_toBottomOf="@+id/txtOr"
                app:layout_constraintEnd_toEndOf="@+id/guideLineHalf"
                app:layout_constraintStart_toStartOf="@+id/icClose"
                app:layout_constraintTop_toTopOf="@+id/txtOr" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtCicTitle"
                android:layout_width="wrap_content"
                tools:text = "CIC Number"
                style="@style/Styles.Text.Footnote.Semi.Bold"
                android:layout_marginTop="@dimen/margin_xlarge"
                app:layout_constraintTop_toBottomOf="@+id/viewLeftSeparator"
                app:layout_constraintStart_toStartOf="@+id/guidelineLeft"
                android:layout_height="wrap_content"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/cicNumberEditText"
                style="@style/TextAppearance.Body"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/common_background_edit_field"
                android:digits="0123456789"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/margin_small"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:padding="15dp"
                android:layoutDirection="ltr"
                android:maxLength="9"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1C1C1E"
                android:textDirection="ltr"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="@+id/guidelineRight"
                app:layout_constraintTop_toBottomOf="@+id/txtCicTitle"
                app:layout_constraintStart_toStartOf="@id/guidelineLeft"/>

            <LinearLayout
                android:id="@+id/placeOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#E6F0F7"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/margin_xxlarge"
                android:padding="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"

                app:layout_constraintTop_toBottomOf="@+id/cicNumberEditText">


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/requestOtp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_place_order_button"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:padding="12dp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    app:cornerRadius="@dimen/_24sdp"
                    tools:text="Request OTP" />
            </LinearLayout>
            <View
                android:id="@+id/viewRightSeparator"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/margin_large"
                android:background="#E6E8EB"
                app:layout_constraintBottom_toBottomOf="@+id/txtOr"
                app:layout_constraintEnd_toEndOf="@+id/guidelineRight"
                app:layout_constraintStart_toEndOf="@+id/txtOr"
                app:layout_constraintTop_toTopOf="@+id/txtOr" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>