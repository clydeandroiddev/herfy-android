<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F7F7F7">

        <include
            android:id="@+id/toolbar_container"
            layout="@layout/toolbar_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/toolbar_container">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/choose_method_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineHeight="16dp"
                    android:text="Debit/Credit Card"
                    android:textAllCaps="false"
                    android:textColor="#0C0C0C"
                    android:textFontWeight="600"
                    android:textSize="14sp"
                    app:lineHeight="16dp"
                    app:fontFamily="@font/inter_semi_bold"
                    android:layout_marginStart="4dp"
                    tools:text ="Debit"
                    tools:visibility="visible"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:visibility="gone"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_cards"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/margin_large"
                    android:layout_height="wrap_content"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_payment_card" />
                <View
                    android:id="@+id/notesDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginBottom="@dimen/margin_large"
                    android:layout_marginTop="@dimen/margin_large"
                    android:background="#E6E8EB" />
                <com.google.android.material.button.MaterialButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/white"
                    android:fontFamily="@font/inter_medium"
                    android:gravity="center"
                    android:lineHeight="16dp"
                    android:padding="16dp"
                    android:text="Add New Card"
                    android:textAllCaps="false"
                    android:textColor="#0064AC"
                    android:textFontWeight="500"
                    app:cornerRadius="25dp"
                    app:strokeColor="#0064AC"
                    app:strokeWidth="2dp"
                    android:visibility="gone"/>


                <LinearLayout
                    android:id="@+id/payment_type_container"
                    android:layout_width="match_parent"
                    android:backgroundTint="#F7F7F7"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E6E8EB"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_marginTop="@dimen/margin_large"
                    android:layout_marginBottom="16dp"/>


                <LinearLayout
                    android:id="@+id/cashOnDeliveryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/confirmButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_place_order_button"
                    android:fontFamily="@font/inter_medium"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:paddingStart="30dp"
                    android:paddingTop="@dimen/padding_small"
                    android:layout_marginTop="@dimen/margin_xxxlarge"
                    android:paddingEnd="30dp"
                    android:paddingBottom="8dp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:cornerRadius="@dimen/_24sdp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_discounted_price"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    tools:text="Confirm" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>





