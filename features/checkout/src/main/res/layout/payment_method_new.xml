<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/choose_method_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/cairo_bold"
        android:text="PAYMENT METHOD"
        android:textAllCaps="true"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_edit_payment_method"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cairo_semibold"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/choose_method_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/choose_method_label"
        tools:text="Edit" />

    <ImageView
        android:id="@+id/cash_image"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_ellipse_placeholder"
        app:layout_constraintBottom_toBottomOf="@+id/tv_selected_paymennt"
        app:layout_constraintStart_toStartOf="@+id/choose_method_label"
        app:layout_constraintTop_toTopOf="@+id/tv_selected_paymennt" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_selected_paymennt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/cairo_semibold"
        android:textColor="@color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/cash_image"
        app:layout_constraintTop_toBottomOf="@+id/choose_method_label"
        tools:text="Visa ****9876" />

</androidx.constraintlayout.widget.ConstraintLayout>