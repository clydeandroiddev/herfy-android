<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_order_type_pickup_bg"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_dialog_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/soloType"
                style="@style/Styles.Text.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="60dp"
                android:layout_marginEnd="30dp"
                android:gravity="start"
                android:includeFontPadding="false"
                android:textColor="#101010"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Choose Pickup Method" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D1D1D6"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp"
            app:layout_constraintTop_toBottomOf="@id/top">

            <androidx.cardview.widget.CardView
                android:id="@+id/pickupContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/margin_20dp"
                app:cardCornerRadius="@dimen/category_icon_12dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/choosePickup"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_choose"
                    android:paddingStart="@dimen/margin_10dp"
                    android:paddingEnd="@dimen/margin_10dp">

                    <ImageView
                        android:id="@+id/pickupEllipse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_choose_pickup"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/pickupArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/arrow_forward_android"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/storePickup"
                        style="@style/Styles.Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:textColor="#101010"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toTopOf="@id/pickupEllipse"
                        app:layout_constraintEnd_toStartOf="@id/pickupArrow"
                        app:layout_constraintStart_toEndOf="@id/pickupEllipse"
                        app:layout_constraintTop_toTopOf="@id/pickupEllipse"
                        tools:text="Walk In Pickup" />

                    <TextView
                        android:id="@+id/descriptionPickup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_regular"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:textColor="#101010"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toStartOf="@id/pickupArrow"
                        app:layout_constraintStart_toEndOf="@id/pickupEllipse"
                        app:layout_constraintTop_toBottomOf="@id/storePickup"
                        tools:text="Pickup your order inside the restaurant" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/curbsideContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/margin_20dp"
                app:cardCornerRadius="@dimen/category_icon_12dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/chooseCurbside"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_choose"
                    android:paddingStart="@dimen/margin_10dp"
                    android:paddingEnd="@dimen/margin_10dp">

                    <ImageView
                        android:id="@+id/curbsideEllipse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_choose_curbside"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/curbsideArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/arrow_forward_android"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/curbside"
                        style="@style/Styles.Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:textColor="#101010"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toTopOf="@id/curbsideEllipse"
                        app:layout_constraintEnd_toStartOf="@id/curbsideArrow"
                        app:layout_constraintStart_toEndOf="@id/curbsideEllipse"
                        app:layout_constraintTop_toTopOf="@id/curbsideEllipse"
                        tools:text="Curbside pickup" />

                    <TextView
                        android:id="@+id/descriptionCurbside"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_regular"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:textColor="#101010"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toStartOf="@id/curbsideArrow"
                        app:layout_constraintStart_toEndOf="@id/curbsideEllipse"
                        app:layout_constraintTop_toBottomOf="@id/curbside"
                        tools:text="Park at the restaurant and your order will be served in your car" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/chooseDriveThruContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/margin_20dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="@dimen/category_icon_12dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/chooseDriveThru"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_choose"
                    android:paddingStart="@dimen/margin_10dp"
                    android:paddingEnd="@dimen/margin_10dp">

                    <ImageView
                        android:id="@+id/driveThruEllipse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_choose_drive_thru"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/driveThruArrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/arrow_forward_android"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/driveThru"
                        style="@style/Styles.Text.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:paddingStart="12dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="12dp"
                        android:textColor="#101010"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toTopOf="@id/driveThruEllipse"
                        app:layout_constraintEnd_toStartOf="@id/driveThruArrow"
                        app:layout_constraintStart_toEndOf="@id/driveThruEllipse"
                        app:layout_constraintTop_toTopOf="@id/driveThruEllipse"
                        tools:text="Drive Thru" />

                    <TextView
                        android:id="@+id/descriptionDriveThru"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter_regular"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:textColor="#101010"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toStartOf="@id/driveThruArrow"
                        app:layout_constraintStart_toEndOf="@id/driveThruEllipse"
                        app:layout_constraintTop_toBottomOf="@id/driveThru"
                        tools:text="Pick up your order from the drive thru." />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
