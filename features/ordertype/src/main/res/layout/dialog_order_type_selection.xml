<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_order_type_pickup_bg"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_dialog_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/soloType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:fontFamily="@font/helvetica_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#101010"
                android:textSize="17sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Choose Pickup Type" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#D1D1D6"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            app:layout_constraintTop_toBottomOf="@id/top">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/choosePickup"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/pickupEllipse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_ellipse"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/pickupArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/arrow_forward_android"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/storePickup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/helvetica_bold"
                    android:includeFontPadding="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#101010"
                    android:textSize="20sp"
                    app:layout_constraintEnd_toStartOf="@id/pickupArrow"
                    app:layout_constraintStart_toEndOf="@id/pickupEllipse"
                    app:layout_constraintTop_toTopOf="@id/pickupEllipse"
                    tools:text="Store Pickup" />

                <TextView
                    android:id="@+id/descriptionPickup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/helvetica_regular"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#101010"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="@id/pickupEllipse"
                    app:layout_constraintEnd_toStartOf="@id/pickupArrow"
                    app:layout_constraintStart_toEndOf="@id/pickupEllipse"
                    tools:text="Pickup your order from the store." />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/chooseCurbside"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/curbsideEllipse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_ellipse"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/curbsideArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/arrow_forward_android"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/curbside"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/helvetica_bold"
                    android:includeFontPadding="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#101010"
                    android:textSize="20sp"
                    app:layout_constraintEnd_toStartOf="@id/curbsideArrow"
                    app:layout_constraintStart_toEndOf="@id/curbsideEllipse"
                    app:layout_constraintTop_toTopOf="@id/curbsideEllipse"
                    tools:text="Curbside" />

                <TextView
                    android:id="@+id/descriptionCurbside"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/helvetica_regular"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="#101010"
                    android:textSize="15sp"
                    app:layout_constraintBottom_toBottomOf="@id/curbsideEllipse"
                    app:layout_constraintEnd_toStartOf="@id/curbsideArrow"
                    app:layout_constraintStart_toEndOf="@id/curbsideEllipse"
                    tools:text="Your order will be served in your car." />


            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
