<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="slide"
            type="com.skylinedynamics.solosdk.api.models.objects.Slide" />
        <variable
            name="listener"
            type="com.herfy.home.adapter.SliderImageAdapter.SliderListener" />
    </data>




    <ImageView
        app:sliderImageUri="@{slide.imageUri}"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:focusable="true"
        android:clickable="true"
        android:onClick="@{()->listener.onSelectedImage(slide)}"
        android:contentDescription="@{slide.title != null ? slide.title : ``}" />


</layout>
