<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_customer_loyalty"
    >


    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="20dp"
        app:cardUseCompatPadding="false"
        app:cardElevation="16dp"
        app:cardPreventCornerOverlap="false"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_loyalty_details_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="visible"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <ImageView
                    android:id="@+id/iv_loyalty_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:scaleType="fitXY"
                    android:src="@drawable/background_loyalty_card"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rl_loyalty_content"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="visible"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="@id/iv_loyalty_card">


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_card_contents"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:padding="16dp">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_ashab_herfy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textColor="@color/white"
                            style="@style/Styles.Text.Headline1"
                            tools:text="Ashab Herfy"
                            android:includeFontPadding="false"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_tier"
                            android:layout_marginTop="8dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="6dp"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textAlignment="center"
                            android:gravity="center"
                            android:drawablePadding="4dp"
                            app:drawableStartCompat="@drawable/ic_loyalty_tier"
                            tools:background="@drawable/background_silver_tier"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_ashab_herfy"
                            style="@style/Styles.Text.Footnote.Semi.Bold"
                            tools:text="Diamond"
                            />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_tier_progress_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:drawablePadding="4dp"
                            android:gravity="center_vertical"
                            android:layout_marginTop="16dp"
                            style="@style/Styles.Text.Footnote.Medium"
                            tools:text="200 points until Gold"
                            android:includeFontPadding="false"
                            app:drawableStartCompat="@drawable/ic_loyalty_database"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_tier"/>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/constraintLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_tier_progress_desc"
                            app:layout_constraintWidth_percent=".6">


                            <SeekBar
                                android:id="@+id/progress"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:max="100"
                                android:progress="0"
                                android:layout_marginTop="3dp"
                                android:paddingEnd="0dp"
                                android:paddingStart="0dp"
                                android:thumbOffset="0dp"
                                android:progressDrawable="@drawable/background_loyalty_progress"
                                android:thumb="@drawable/ic_rewards_thumb"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:splitTrack="false"
                                />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_progress_tier"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/progress"
                                style="@style/Styles.Text.Footnote.Medium"
                                android:includeFontPadding="false"
                                tools:text="Silver" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/progress_text_indicator"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="@id/tv_progress_tier"
                                style="@style/Styles.Text.Footnote.Medium"
                                android:includeFontPadding="false"
                                tools:text="400/600" />


                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            android:id="@+id/tv_total_points_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:gravity="end"
                            android:textAlignment="viewEnd"
                            android:includeFontPadding="false"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            style="@style/Styles.Text.Footnote.Medium"
                            tools:text="Total Points"/>

                        <TextView
                            android:id="@+id/tv_total_points"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="25sp"
                            android:gravity="end"
                            android:textAlignment="viewEnd"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            app:layout_constraintWidth_max="200dp"
                            app:layout_constraintHorizontal_bias="1.0"
                            app:layout_constraintStart_toEndOf="@id/tv_tier"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_total_points_label"
                            style="@style/Styles.Text.LargeTitle"
                            tools:text="1900"/>

                        <ImageView
                            android:id="@+id/iv_points_equivalent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/ic_loyalty_equivalent"
                            android:layout_marginEnd="20dp"
                            android:layout_marginTop="6dp"
                            app:layout_constraintTop_toBottomOf="@id/tv_total_points"
                            app:layout_constraintEnd_toEndOf="parent"/>

                        <TextView
                            android:id="@+id/tv_sar_value_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="@color/white"
                            android:gravity="end"
                            android:textAlignment="viewEnd"
                            android:layout_marginTop="10dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/iv_points_equivalent"
                            style="@style/Styles.Text.Footnote.Medium"
                            tools:text="SAR VALUE"/>

                        <TextView
                            android:id="@+id/tv_sar_value"
                            style="@style/Styles.Text.LargeTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:textAlignment="viewEnd"
                            android:textColor="@color/white"
                            android:textSize="25sp"
                            android:layout_marginStart="16dp"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="1.0"
                            app:layout_constraintStart_toEndOf="@+id/constraintLayout"
                            app:layout_constraintTop_toBottomOf="@id/tv_sar_value_label"
                            app:layout_constraintWidth_max="200dp"
                            tools:text="1900.00" />




                    </androidx.constraintlayout.widget.ConstraintLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_see_rewards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:paddingVertical="18dp"
                    android:paddingHorizontal="20dp"
                    android:visibility="visible"
                    android:layout_marginTop="-10dp"
                    app:layout_constraintTop_toBottomOf="@id/iv_loyalty_card"
                    >

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_see_rewards"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="6dp"
                        android:textSize="14sp"
                        android:textColor="@color/text_color_blue"
                        app:drawableStartCompat="@drawable/ic_loyalty_see_rewards"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        style="@style/Styles.Text.Footnote.Semi.Bold"
                        android:includeFontPadding="false"
                        tools:text="See my rewards"/>

                    <ImageView
                        android:id="@+id/iv_see_rewards"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_arrow_blue_right"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>
            
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_loyalty_empty_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/iv_loyalty_empty_card"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/background_loyalty_card"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/ln_loyalty_empty_state"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    android:orientation="vertical"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_title_empty_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        style="@style/Styles.Text.Title1"
                        tools:text="Become an Ashab Herfy"/>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_description_empty_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:layout_marginHorizontal="32dp"
                        android:gravity="center_horizontal"
                        android:layout_gravity="center_horizontal"
                        style="@style/Styles.Text.Caption.Regular"
                        tools:text="By creating an account or signing in to your existing one you get point on every order"/>


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_continue"
                        android:layout_marginTop="36dp"
                        android:layout_width="172dp"
                        android:layout_height="40dp"
                        android:insetBottom="0dp"
                        android:insetTop="0dp"
                        app:cornerRadius="20dp"
                        android:textAllCaps="false"
                        android:textColor="@color/text_color_red"
                        android:textSize="14sp"
                        app:backgroundTint="@color/white"
                        android:textAppearance="@style/Styles.Text.Footnote.Semi.Bold"
                        android:layout_marginBottom="32dp"
                        tools:text="Continue"/>

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/fm_shimmer_loyalty"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/placeholder_color"/>

            </com.facebook.shimmer.ShimmerFrameLayout>







        </androidx.constraintlayout.widget.ConstraintLayout>




    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>