<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:id="@+id/cl_slider_container"
    tools:layout_height="300dp">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mercury"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/main_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="@dimen/menu_appbar_height_no_slider"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            tools:layout_height="@dimen/menu_appbar_height">

            <View
                android:id="@+id/empty_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                app:layout_collapseMode="parallax"
                tools:layout_height="@dimen/menu_appbar_height_no_slider" />

            <androidx.constraintlayout.widget.ConstraintLayout
                app:layout_collapseMode="parallax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/slider_view_pager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layoutDirection="locale"
                    app:layout_collapseMode="parallax"
                    android:visibility="gone"/>

                <com.tbuonomo.viewpagerdotsindicator.StrokeDotsIndicator
                    android:id="@+id/dots_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|bottom"
                    app:dotsColor="#00000000"
                    app:dotsSize="10dp"
                    app:dotsStrokeWidth="1dp"
                    app:dotsStrokeColor="@color/white"
                    app:layout_collapseMode="parallax"
                    app:dotsSpacing="4dp"
                    app:dotsWidthFactor="3.5"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="18dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:progressMode="false"
                    app:selectedDotColor="@color/white"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/new_menu_banner_shimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:shimmer_duration="1000">

                <include layout="@layout/placeholder_banner" />

            </com.facebook.shimmer.ShimmerFrameLayout>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar_main"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tab_layout_no_search"
                app:layout_collapseMode="pin" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>