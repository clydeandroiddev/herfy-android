<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="category"
            type="com.herfy.model.PromotionCategory" />

        <variable
            name="listener"
            type="com.herfy.home.adapter.PromotionCategoryAdapter.PromotionCategoryListener" />

        <variable
            name="categoryPos"
            type="int" />
    </data>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp"
        android:textColor="@{category.selected ? @color/white : @color/primaryDark}"
        android:onClick="@{() -> listener.selectedCategory(category)}"
        style="@style/Styles.Text.Footnote.Medium"
        tools:text="All"
        android:text="@{category.name}"
        android:layout_marginHorizontal="2dp"
        app:selectedBackground="@drawable/background_promo_category"
        app:isSelected="@{category.selected}"
         />


</layout>
