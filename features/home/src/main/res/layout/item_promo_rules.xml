<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="requirement"
            type="com.herfy.model.PromotionRequirement" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_rule"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tv_rule"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@+id/iv_rule"
            app:layout_constraintEnd_toEndOf="@+id/cb_rules"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:gravity="start"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/secondaryTextColor"
            android:textSize="14sp"
            android:textAlignment="viewStart"
            tools:text="Login/Register"
            android:text="@{requirement.label}"
            style="@style/Styles.Text.Caption.Semibold"/>

        <CheckBox
            android:id="@+id/cb_rules"
            android:focusable="false"
            android:clickable="false"
            android:enabled="false"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/cb_promo_rules_state"
            android:button="@null"
            android:checked="@{requirement.isRequired}"
            tools:checked="false"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
