<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="promo"
            type="com.skylinedynamics.solosdk.api.models.objects.Campaign" />

        <variable
            name="listener"
            type="com.herfy.home.adapter.PromotionsAdapter.PromotionListener" />
        <variable
            name="orderType"
            type="String"/>
        <variable
            name="orderTypeCount"
            type="int"/>
        <variable
            name="orderTypeIcon"
            type="int" />
        <import type="android.view.View"/>
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="false"
        app:cardPreventCornerOverlap="true"
        app:strokeColor="#D9E8F3"
        app:strokeWidth="1dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginVertical="12dp"
        android:onClick="@{() -> listener.onSelectedPromo(promo)}">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="10dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_image_container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:cardCornerRadius="16dp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="false"
                app:cardElevation="0dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toTopOf="@id/cl_info"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/iv_item_image"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:scaleType="centerCrop"
                        app:imageSrc="@{promo.attributes.imageUri}"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintVertical_chainStyle="spread" />



                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_info"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@color/white"
                app:layout_constraintTop_toBottomOf="@id/cv_image_container"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/tv_item_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="#000"
                    style="@style/Styles.Text.Footnote.Medium"
                    tools:text="Promotion Name"
                    android:maxLines="1"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:text="@{promo.attributes.name}"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_item_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="#55667B"
                    style="@style/Styles.Text.Caption.Regular"
                    tools:text="Details of the promotion"
                    android:text="@{promo.attributes.description}"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tv_item_title"
                    app:layout_constraintTop_toBottomOf="@id/tv_item_title"
                    app:layout_constraintVertical_bias="0"/>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/ln_promo_category"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_item_description"
                    android:visibility="@{!orderType.empty? View.VISIBLE : View.GONE}"
                    tools:visibility="visible">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:background="@drawable/background_blue_gradient"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/colorPromoCategoryBlue"
                        app:cardPreventCornerOverlap="false"
                        app:cardUseCompatPadding="false"
                        app:contentPaddingRight="8dp"
                        app:contentPaddingLeft="8dp"
                        app:contentPaddingTop="4dp"
                        app:contentPaddingBottom="4dp"
                        app:cardCornerRadius="4dp">

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <ImageView
                                android:id="@+id/iv_promo_category"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:layout_marginEnd="5dp"
                                app:icon="@{orderTypeIcon}"
                                android:contentDescription="" />

                            <TextView
                                style="@style/Styles.Text.Caption"
                                android:id="@+id/tv_promo_category"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                tools:text="Pick up"
                                android:text="@{orderType}"/>

                        </androidx.appcompat.widget.LinearLayoutCompat>




                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/cv_promo_category_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/background_blue_circle_gradient"
                        android:visibility="@{orderTypeCount > 1? View.VISIBLE : View.GONE}"
                        tools:visibility="visible">


                        <TextView
                            style="@style/Styles.Text.Caption"
                            android:id="@+id/tv_promo_category_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:layout_gravity="center"
                            android:layout_marginVertical="4dp"
                            android:layout_marginHorizontal="6dp"
                            app:countValue="@{orderTypeCount}"
                            tools:text="+1"/>



                    </FrameLayout>

                </androidx.appcompat.widget.LinearLayoutCompat>



            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>


</layout>


