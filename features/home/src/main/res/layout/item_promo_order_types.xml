<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="orderType"
            type="com.herfy.model.PromotionOrderType"/>
    </data>


    <FrameLayout
        android:id="@+id/fm_promo_category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="3dp"
        android:layout_marginBottom="6dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:background="@drawable/background_blue_gradient">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/iv_promo_category"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="5dp"
                app:icon="@{orderType.icon}"
                android:contentDescription="" />

            <TextView
                style="@style/Styles.Text.Caption"
                android:id="@+id/tv_promo_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                tools:text="Pick up"
                android:text="@{orderType.label}"/>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </FrameLayout>

</layout>
