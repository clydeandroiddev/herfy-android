<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="promo"
            type="com.skylinedynamics.solosdk.api.models.objects.Campaign" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_rate"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tv_promo_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Promotion Name"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:text="@{promo.attributes.name}"
            app:layout_constraintEnd_toStartOf="@id/cv_promo_category"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_promo_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/placeholder_color"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            >

            <TextView
                android:id="@+id/tv_promo_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                tools:text="DRIVE-THRU ONLY"
                android:layout_marginVertical="2dp"
                android:layout_marginHorizontal="6dp"
                android:layout_gravity="center"
                android:gravity="center"
                />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_promo_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:text="@{promo.attributes.description}"
            tools:text="Description of the promotion, which can be multiple lines."
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_promo_name"/>

        <TextView
            android:id="@+id/tv_requirements"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Requirements"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_promo_description"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_requirements"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_requirements"
            app:layout_constrainedHeight="true"
            tools:itemCount="3"/>
        
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:id="@+id/btn_claim"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetRight="0dp"
            android:insetLeft="0dp"
            android:layout_marginTop="24dp"
            android:textColor="@color/white"
            android:textAllCaps="false"
            tools:text="Claim Promo"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="30dp"
            app:layout_constraintTop_toBottomOf="@id/rv_requirements"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>
