<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:ignore="HardcodedText">

    <data>
        <variable
            name="promo"
            type="com.skylinedynamics.solosdk.api.models.objects.Campaign" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_rate"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        android:paddingHorizontal="16dp">
        
        
        <FrameLayout
            android:id="@+id/fm_promo_image"
            android:layout_width="0dp"
            android:layout_height="151dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/ib_close"
                android:background="?selectableItemBackground"
                android:src="@drawable/ic_circle_white_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="close button" />

            <ImageView
                app:imageSrc="@{promo.attributes.imageUri}"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Promo image"
                 />

        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_promo_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/colorPromoCategoryBlue"
            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="false"
            android:layout_marginTop="8dp"
            app:contentPaddingRight="8dp"
            app:contentPaddingLeft="8dp"
            app:contentPaddingTop="4dp"
            app:contentPaddingBottom="4dp"
            app:cardCornerRadius="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/fm_promo_image">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:id="@+id/iv_promo_category"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="" />

                <TextView
                    style="@style/Styles.Text.Caption.Semibold"
                    android:id="@+id/tv_promo_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorPrimary"
                    tools:text="Pick up"/>

            </androidx.appcompat.widget.LinearLayoutCompat>




        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_promo_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Promotion Name"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:text="@{promo.attributes.name}"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cv_promo_category" />



        <TextView
            android:id="@+id/tv_promo_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:text="@{promo.attributes.description}"
            tools:text="Description of the promotion, which can be multiple lines."
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_promo_name"/>

        <TextView
            android:id="@+id/tv_requirements"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Requirements"
            android:textSize="16sp"
            android:layout_marginTop="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_promo_description"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_requirements"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_requirements"
            app:layout_constrainedHeight="true"
            tools:itemCount="3"/>
        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_claim"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetRight="0dp"
            android:insetLeft="0dp"
            android:layout_marginTop="24dp"
            android:textColor="@color/white"
            android:textAllCaps="false"
            app:backgroundTint="@color/colorPrimary"
            tools:text="Redeem"
            app:cornerRadius="4dp"
            app:layout_constraintTop_toBottomOf="@id/rv_requirements"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>
