<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:layout_editor_absoluteX="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                style="@style/CustomCardViewStyle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_height="wrap_content">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">



            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineLeft"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.05"/>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideLineImageLeft"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.10"/>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guidelineRight"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.95"/>

            <ImageView
                android:id="@+id/icClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                android:src="@drawable/ic_close"
                app:layout_constraintBottom_toTopOf="@+id/viewSeparator"
                app:layout_constraintStart_toStartOf="@+id/guidelineLeft" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtNutritionInfo"
                android:layout_width="0dp"
                style="@style/TextAppearance.Headline1"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:textSize="17sp"
                android:textColor="#101010"
                app:layout_constraintBottom_toTopOf="@+id/viewSeparator"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/guidelineRight"
                app:layout_constraintStart_toEndOf="@+id/icClose"
                app:layout_constraintStart_toStartOf="@+id/guidelineLeft"
                app:layout_constraintTop_toTopOf="@+id/icClose"
                tools:text="Grilled Chicken" />

            <View
                android:id="@+id/viewSeparator"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="@dimen/margin_large"
                app:layout_constraintTop_toBottomOf="@+id/txtNutritionInfo"
                android:layout_marginTop="@dimen/margin_large"
                android:background="#E6E8EB"/>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtNutritionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.Headline1"
                android:layout_marginTop="@dimen/margin_large"
                app:layout_constraintStart_toStartOf="@+id/guidelineLeft"
                app:layout_constraintTop_toBottomOf="@+id/viewSeparator"
                tools:text="Nutrition info." />

            <ImageView
                android:id="@+id/nutritionImage"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:layout_marginHorizontal="@dimen/margin_large"
                android:layout_marginTop="@dimen/margin_xlarge"
                android:scaleType="centerInside"
                app:layout_constraintEnd_toEndOf="@+id/guidelineRight"
                app:layout_constraintHorizontal_bias="0.505"
                app:layout_constraintStart_toStartOf="@+id/guidelineLeft"
                app:layout_constraintTop_toBottomOf="@+id/txtNutritionLabel"
                tools:src="@tools:sample/avatars" />
                    <View
                        android:id="@+id/imageSeparator"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="@dimen/margin_large"
                        app:layout_constraintTop_toBottomOf="@+id/nutritionImage"
                        android:layout_marginTop="@dimen/margin_large"
                        android:background="#E6E8EB"/>
            <LinearLayout
                android:id="@+id/storyLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible"
                android:layout_marginHorizontal="@dimen/margin_xlarge"
                android:layout_marginTop="@dimen/margin_xxlarge"
                app:layout_constraintTop_toBottomOf="@+id/imageSeparator"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/guidelineLeft"
                android:orientation="vertical">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/txtStory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Styles.Text.Headline1"
                    android:layout_marginBottom="@dimen/margin_small"
                    app:layout_constraintBottom_toTopOf="@+id/txtStoryDescription"
                    app:layout_constraintTop_toBottomOf="@+id/nutritionImage"
                    app:layout_constraintStart_toStartOf="@+id/guidelineLeft"
                    tools:text="Story" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/txtStoryDescription"
                    style="@style/Styles.Text.Headline_Regular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_xxxlarge"

                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/guidelineRight"
                    app:layout_constraintStart_toStartOf="@+id/guidelineLeft"
                    tools:text="Story of the product with multiple lines go here...Story of the product with multiple lines go here...Story of the product with multiple lines go here...Story of the product with multiple lines go here..." />

            </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</layout>