<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/servedLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/background_cards"
            android:padding="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <FrameLayout
                android:id="@+id/arrivedFrame"
                android:layout_width="41dp"
                android:layout_height="41dp"
                android:background="@drawable/background_blue_corner_8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_order_served" />

            </FrameLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/thankYouLabel"
                style="@style/Styles.Text.Caption.Semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:textColor="#0064AC"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@id/arrivedFrame"
                app:layout_constraintTop_toTopOf="@id/arrivedFrame"
                tools:text="Thank you!" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/orderServedLabel"
                style="@style/Styles.Text.Caption.Semibold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#191919"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/thankYouLabel"
                app:layout_constraintTop_toTopOf="@id/thankYouLabel"
                tools:text="Your order will be served shortly" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/notServedLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="@drawable/background_cards"
            android:padding="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:id="@+id/instructionFrame"
                android:layout_width="41dp"
                android:layout_height="41dp"
                android:background="@drawable/background_blue_corner_8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_curbside_check_map" />

            </FrameLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/letUsKnowLabel"
                style="@style/Styles.Text.Caption.Semibold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:textColor="#191919"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/instructionFrame"
                app:layout_constraintTop_toTopOf="@id/instructionFrame"
                tools:text="Let us know when you arrive." />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/driverInstruction"
                style="@style/Styles.Text.Caption.Semibold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:textColor="#55667B"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/letUsKnowLabel"
                app:layout_constraintTop_toBottomOf="@id/letUsKnowLabel"
                tools:text="We will serve your order to you when you are here." />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_cards"
            android:padding="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/curbsideVehicleLabel"
                style="@style/Styles.Text.Footnote_Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:textColor="#0C0C0C"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Curbside Vehicle" />

            <LinearLayout
                android:id="@+id/editOrderCurbsideLayout"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_curbside_edit_vehicle" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/editCurbsideLabel"
                    style="@style/Styles.Text.Caption.Semibold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:includeFontPadding="false"
                    android:textColor="#0064AC"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Edit" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/curbsideBrandFrame"
                android:layout_width="41dp"
                android:layout_height="41dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/background_blue_corner_8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/editOrderCurbsideLayout">

                <ImageView
                    android:id="@+id/curbsideBrandImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:padding="4dp"
                    tools:src="@tools:sample/backgrounds/scenic" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="@id/curbsideBrandFrame"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/curbsideBrandFrame"
                app:layout_constraintTop_toTopOf="@id/curbsideBrandFrame">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/curbsideBrandName"
                    style="@style/Styles.Text.Caption.Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="BMW" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Styles.Text.Caption.Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:includeFontPadding="false"
                    android:text="-"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/curbsideVehicleColor"
                    style="@style/Styles.Text.Caption.Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Black" />

                <androidx.appcompat.widget.AppCompatTextView
                    style="@style/Styles.Text.Caption.Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:includeFontPadding="false"
                    android:text="-"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/curbsidePlateNumber"
                    style="@style/Styles.Text.Caption.Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="kl8989" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>


</layout>
