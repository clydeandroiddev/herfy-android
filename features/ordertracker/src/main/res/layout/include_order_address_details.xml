<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_cards"
            android:padding="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/deliveryDetailsLabel"
                style="@style/Styles.Text.LargeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#0C0C0C"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Delivery Details" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/orderNumberLabel"
                style="@style/Styles.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                android:textColor="#0C0C0C"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/deliveryDetailsLabel"
                tools:text="Order #" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/orderNumber"
                style="@style/Styles.Text.Caption.Regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:textColor="#0C0C0C"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/orderNumberLabel"
                app:layout_constraintStart_toEndOf="@id/orderNumberLabel"
                app:layout_constraintTop_toTopOf="@id/orderNumberLabel"
                tools:text="234566" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tellLabel"
                style="@style/Styles.Text.Caption.Regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/background_blue_corner_4dp"
                android:includeFontPadding="false"
                android:padding="12dp"
                android:textColor="#0064AC"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/orderNumberLabel"
                tools:text="Tell the order number to the rider to recive your order" />

            <View
                android:id="@+id/centerOrderDetails"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#E6E8EB"
                app:layout_constraintTop_toBottomOf="@id/tellLabel" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/deliveryAddressLabel"
                style="@style/Styles.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                android:textColor="#0C0C0C"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/centerOrderDetails"
                tools:text="Delivery Address" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/addressType"
                style="@style/Styles.Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                android:textColor="#0064AC"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/deliveryAddressLabel"
                tools:text="Herfy - Al Hamra" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/addressKm"
                style="@style/Styles.Text.Caption.Regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:alpha="0.5"
                android:includeFontPadding="false"
                android:textColor="#212121"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/addressType"
                app:layout_constraintStart_toEndOf="@id/addressType"
                app:layout_constraintTop_toTopOf="@id/addressType"
                tools:text="0.8 km" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/addressName"
                style="@style/Styles.Text.Caption.Regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                android:textColor="#55667B"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/addressType"
                tools:text="Al Batha street, Riyadh, Saudi Arabia" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/addressTime"
                style="@style/Styles.Text.Caption.Regular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                android:textColor="#212121"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/addressName"
                tools:text="10 AM - 2AM" />


            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/getDirection"
                style="@style/Styles.Text.Caption.Semibold"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/background_stroke_blue_24dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#0064AC"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/addressTime"
                tools:text="Get Direction" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
