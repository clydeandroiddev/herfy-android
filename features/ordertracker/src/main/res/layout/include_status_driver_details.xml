<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_cards"
            android:padding="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/driverAreaLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/noDriverLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="gone">

                    <FrameLayout
                        android:id="@+id/noRiderFrame"
                        android:layout_width="41dp"
                        android:layout_height="41dp"
                        android:background="@drawable/background_blue_corner_8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_tracker_headset" />

                    </FrameLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/yourRiderLabel"
                        style="@style/Styles.Text.Caption.Semibold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:textColor="#191919"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/noRiderFrame"
                        app:layout_constraintTop_toTopOf="@id/noRiderFrame"
                        tools:text="Your Rider" />


                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/yourRiderDescription"
                        style="@style/Styles.Text.Caption.Semibold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:textColor="#55667B"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/yourRiderLabel"
                        app:layout_constraintTop_toBottomOf="@id/yourRiderLabel"
                        tools:text="A rider will be assigned to you when order is ready. You will be able to track your order in real time" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/withDriverLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent">

                    <FrameLayout
                        android:id="@+id/riderFrame"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/background_oval_40dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/driverInitial"
                            style="@style/Styles.Text.Caption.Semibold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:includeFontPadding="false"
                            android:textAllCaps="true"
                            android:textColor="#0064AC"
                            android:textSize="16sp"
                            tools:text="TD" />

                    </FrameLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/riderName"
                        style="@style/Styles.Text.LargeTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:textColor="#191919"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/riderFrame"
                        app:layout_constraintTop_toTopOf="@id/riderFrame"
                        tools:text="Your Rider" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/riderMotor"
                        style="@style/Styles.Text.Caption.Semibold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:textColor="#55667B"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/riderName"
                        app:layout_constraintTop_toBottomOf="@id/riderName"
                        tools:text="Red Honda - KKL7878" />

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/cnter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.5" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/callRider"
                        style="@style/Styles.Text.Caption.Semibold"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/background_current_status"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toStartOf="@id/cnter"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/riderFrame"
                        tools:text="Call" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/messageRider"
                        style="@style/Styles.Text.Caption.Semibold"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/background_whatsup_green"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cnter"
                        app:layout_constraintTop_toBottomOf="@id/riderFrame"
                        tools:text="Message" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/centerLineDriverDetails"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#E6E8EB"
                app:layout_constraintTop_toBottomOf="@id/driverAreaLayout" />

            <FrameLayout
                android:id="@+id/instructionFrame"
                android:layout_width="41dp"
                android:layout_height="41dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/background_blue_corner_8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/centerLineDriverDetails">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tracker_instruction" />

            </FrameLayout>

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/deliveryInstructionLabel"
                style="@style/Styles.Text.Caption.Semibold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:textColor="#191919"
                android:textSize="16sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/instructionFrame"
                app:layout_constraintTop_toTopOf="@id/instructionFrame"
                tools:text="Delivery Instruction" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/driverInstruction"
                style="@style/Styles.Text.Caption.Semibold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:textColor="#55667B"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/deliveryInstructionLabel"
                app:layout_constraintTop_toBottomOf="@id/deliveryInstructionLabel"
                tools:text="Do not ring the bell, Call me" />

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"
                app:layout_constraintTop_toBottomOf="@id/instructionFrame" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>
