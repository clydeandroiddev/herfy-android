<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="30dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="94dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="4"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="0.18"
                android:background="#0064AC"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/preparingLayout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.02"
                android:background="@drawable/background_cards"
                android:padding="10dp"
                tools:background="@drawable/background_past_status">

                <FrameLayout
                    android:id="@+id/frameIconPreparing"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:background="@drawable/background_disabled_status">

                    <ImageView
                        android:id="@+id/imageIconPreparing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        tools:src="@drawable/ic_preparing_not_yet" />

                </FrameLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/preparingTime"
                    style="@style/Styles.Text.Caption.Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="@color/time_status_color_past"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="7:05" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/preparingLabel"
                    style="@style/Styles.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/text_status_color_past"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toTopOf="@id/preparingTime"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/frameIconPreparing"
                    tools:text="Preparing" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/statusViewSecond"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="0.20"
                android:background="#0064AC"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/onWayLayout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.20"
                android:background="@drawable/background_cards"
                android:padding="10dp"
                tools:background="@drawable/background_current_status">

                <FrameLayout
                    android:id="@+id/frameIconOnWay"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:background="@drawable/background_enabled_status">

                    <ImageView
                        android:id="@+id/imageIconOnWay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        tools:src="@drawable/ic_delivery_done" />

                </FrameLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/onWayTime"
                    style="@style/Styles.Text.Caption.Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="@color/time_status_color_current"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="7:05" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/onWayLabel"
                    style="@style/Styles.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/text_status_color_current"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toTopOf="@id/onWayTime"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/frameIconOnWay"
                    tools:text="On Way" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/statusViewThird"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="0.20"
                android:background="#0064AC"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/finishedLayout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.02"
                android:background="@drawable/background_cards"
                android:padding="10dp">

                <FrameLayout
                    android:id="@+id/frameIconFinished"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:background="@drawable/background_disabled_status">

                    <ImageView
                        android:id="@+id/imageIconFinishes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:alpha="0.7"
                        tools:src="@drawable/ic_order_not_yet" />

                </FrameLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/finishedTime"
                    style="@style/Styles.Text.Caption.Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="@color/time_status_color_past"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/finishedLabel"
                    style="@style/Styles.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/text_status_color_past"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toTopOf="@id/finishedTime"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/frameIconFinished"
                    tools:text="Delivered" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="0.18"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>
