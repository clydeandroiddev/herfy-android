<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="158dp"
    android:layout_marginTop="16dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    app:cardPreventCornerOverlap="true"
    app:cardUseCompatPadding="false"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:strokeWidth="1dp"
    app:strokeColor="#D9E8F3">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutMenuItem"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:clickable="true"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:background="?selectableItemBackground">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutImage"
            android:layout_width="134dp"
            android:layout_height="134dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="4dp"
            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="false"
            app:cardBackgroundColor="#E6F0F7"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:elevation="0dp">

            <ImageView
                android:id="@+id/ivImage"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

        </com.google.android.material.card.MaterialCardView>

        <View
            android:id="@+id/viewTop"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            app:layout_constraintTop_toTopOf="@+id/layoutImage"/>

        <LinearLayout
            android:id="@+id/layoutCalories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toEndOf="@+id/layoutImage"
            app:layout_constraintTop_toBottomOf="@+id/viewTop"
            android:layout_marginStart="8dp"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_calories" />

            <TextView
                android:id="@+id/tvCalories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/inter_medium"
                android:includeFontPadding="false"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="#55667B" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:layout_constraintTop_toTopOf="@+id/layoutImage"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:background="?selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_favorite_empty" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@+id/layoutImage"
            app:layout_constraintEnd_toStartOf="@+id/btnFavorite"
            app:layout_constraintTop_toBottomOf="@+id/layoutCalories"
            android:layout_marginTop="2dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:fontFamily="@font/inter_semi_bold"
            android:includeFontPadding="false"
            android:textAlignment="viewStart"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#0C0C0C" />

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@+id/layoutImage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvName"
            android:layout_marginTop="2dp"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/inter_regular"
            android:ellipsize="end"
            android:maxLines="3"
            android:includeFontPadding="false"
            android:textAlignment="viewStart"
            android:textSize="11sp"
            android:textColor="#55667B" />

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@+id/layoutImage"
            app:layout_constraintTop_toTopOf="@+id/btnAdd"
            app:layout_constraintBottom_toBottomOf="@+id/btnAdd"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/inter_medium"
            android:includeFontPadding="false"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#2266A7" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="?selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_add" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>