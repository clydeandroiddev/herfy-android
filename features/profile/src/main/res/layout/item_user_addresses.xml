<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chooseCurbside"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/background_cards"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/curbsideEllipse"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_curbside_item_type"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/cardImage"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:layout_constraintBottom_toBottomOf="@id/curbsideEllipse"
                app:layout_constraintEnd_toEndOf="@id/curbsideEllipse"
                app:layout_constraintStart_toStartOf="@id/curbsideEllipse"
                app:layout_constraintTop_toTopOf="@id/curbsideEllipse" />

            <LinearLayout
                android:id="@+id/addressDetailsLayout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/curbsideEllipse"
                app:layout_constraintTop_toTopOf="@id/curbsideEllipse">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/addressType"
                    style="@style/Styles.Text.Footnote_Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    tools:text="Home" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/address"
                    style="@style/Styles.Text.Footnote.Medium_Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#1c1c1c"
                    android:textSize="12sp"
                    tools:text="AL Batha Street, Riyadh" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/noteToRider"
                    style="@style/Styles.Text.Footnote.Medium_Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="20"
                    android:textColor="#1c1c1c"
                    android:textSize="12sp"
                    tools:text="Note to rider: First orange building on right" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/deleteItem"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_trash_item"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/addressDetailsLayout" />

            <ImageButton
                android:id="@+id/editItem"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_edit_item"
                app:layout_constraintEnd_toStartOf="@id/deleteItem"
                app:layout_constraintTop_toBottomOf="@id/addressDetailsLayout" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>