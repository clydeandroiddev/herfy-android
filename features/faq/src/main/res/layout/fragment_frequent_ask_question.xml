<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/icClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_large"
        android:src="@drawable/ic_common_close"
        app:layout_constraintBottom_toBottomOf="@+id/txtFAQs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txtFAQs" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/txtFAQs"
        style="@style/Styles.Text.Headline1"
        android:layout_width="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/viewSeparator"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="FAQs" />
    <View
        android:id="@+id/viewSeparator"
        android:layout_width="match_parent"
        android:background="#E6E8EB"
        android:layout_marginTop="@dimen/margin_large"
        app:layout_constraintTop_toBottomOf="@+id/txtFAQs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="@dimen/_1sdp"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/frequencyRecycleView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_large"
        android:layout_marginHorizontal="@dimen/margin_small"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingBottom="@dimen/_100sdp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewSeparator"
        tools:itemCount="4"
        tools:listitem="@layout/item_frequent" />
</androidx.constraintlayout.widget.ConstraintLayout>
</layout>