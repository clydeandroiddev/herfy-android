<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:layout_width="match_parent"
    tools:layout_height="60dp"
    tools:background="#F7F7F7"
    tools:paddingHorizontal="16dp"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">


    <ImageButton
        android:id="@+id/ib_navigation"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_navigate_back"
        android:background="?selectableItemBackground"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_order_type"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="@drawable/background_spinner_order_type"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintTop_toTopOf="@id/ib_navigation"
        app:layout_constraintBottom_toBottomOf="@id/ib_navigation"
        app:layout_constraintStart_toEndOf="@id/ib_navigation"
        app:layout_constraintEnd_toStartOf="@id/cv_cart">

        <ImageView
            android:id="@+id/iv_order_type"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tv_order_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#0064AC"
            style="@style/Styles.Text.Caption"
            tools:text="Delivery"
            android:layout_marginStart="2.5dp"
            app:layout_constraintTop_toTopOf="@id/iv_order_type"
            app:layout_constraintStart_toEndOf="@id/iv_order_type"
            app:layout_constraintBottom_toTopOf="@id/tv_order_type_address"/>

        <TextView
            android:id="@+id/tv_order_type_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            tools:text="Other"
            android:textColor="#FF1C1C1E"
            android:layout_marginStart="2.5dp"
            style="@style/Styles.Text.LargeTitle"
            app:layout_constraintStart_toEndOf="@id/iv_order_type"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_order_type"
            app:layout_constraintBottom_toBottomOf="@id/iv_order_type"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_cart"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        app:cardCornerRadius="4dp"
        app:cardBackgroundColor="#2865A8"
        tools:cardBackgroundColor="@color/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/ln_cart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="8dp">

            <ImageView
                android:id="@+id/iv_cart"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_toolbar_cart"
                />

            <TextView
                android:id="@+id/tv_cart_qty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textColor="@color/white"
                android:layout_marginStart="2dp"
                android:gravity="center"
                android:textAlignment="center"
                android:includeFontPadding="false"
                style="@style/Styles.Text.Title1"
                tools:text="0"/>


        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>





</merge>