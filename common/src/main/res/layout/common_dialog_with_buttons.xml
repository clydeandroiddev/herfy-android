<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardUseCompatPadding="false"
        app:cardPreventCornerOverlap="true">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="30dp">

            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="49dp"
                android:layout_height="49dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:contentDescription="Icon for dialog" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textSize="@dimen/_16ssp"
                android:textColor="@color/primaryTextColor"
                android:gravity="center_horizontal"
                android:textAlignment="center"
                style="@style/Styles.Text.Title1"
                app:layout_constraintTop_toBottomOf="@id/iv_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Invalid for this Order"/>

            <TextView
                android:id="@+id/tv_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="@dimen/_14ssp"
                android:textColor="@color/color_dark_gray_blue"
                android:gravity="center_horizontal"
                android:textAlignment="center"
                style="@style/Styles.Text.Dialog.Content"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Coupons can not be redeemed on orders having free items. Add more items from them menu to redeem coupons"/>


            <Space
                android:id="@+id/space_button_a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/tv_message"
                android:layout_marginTop="32dp"/>
            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_a"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:layout_marginTop="32dp"
                android:textColor="@color/white"
                android:textAllCaps="false"
                app:elevation="0dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/background_color_blue"
                app:layout_constraintTop_toBottomOf="@id/space_button_a"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <Space
                android:id="@+id/space_button_b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/button_a"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_b"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:textAllCaps="false"
                android:textColor="@color/background_color_blue"
                app:cornerRadius="24dp"
                app:elevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/background_color_blue"
                app:backgroundTint="@color/white"
                app:layout_constraintTop_toBottomOf="@id/space_button_b"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>



    </com.google.android.material.card.MaterialCardView>




</androidx.constraintlayout.widget.ConstraintLayout>