<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@+id/imageEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:src = "@drawable/ic_favourite_empty"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/txtEmptyTitle" />
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/txtEmptyTitle"
        android:layout_width="wrap_content"
        style="@style/Styles.Text.Footnote.Medium_Regular"
        app:layout_constraintTop_toBottomOf="@+id/imageEmpty"
        android:layout_marginTop="@dimen/margin_large"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text = "No favourites found"
        android:fontFamily="@font/inter_regular"
        android:layout_height="wrap_content"/>

</androidx.constraintlayout.widget.ConstraintLayout>