<?xml version="1.0" encoding="utf-8"?>
<resources>

    <attr name="navButton" format="reference"/>
    <attr name="rightButtonColor" format="color"/>
    <attr name="rightButtonIcon" format="reference"/>
    <attr name="title" format="string"/>
    <attr name="titleTextColor" format="color"/>

    <declare-styleable name="MainToolbar">
        <attr name="logo" format="reference"/>
        <attr name="leftButton" format="reference"/>
        <attr name="rightButtonIcon"/>
    </declare-styleable>

    <declare-styleable name="TitleToolbar">
        <attr name="title"/>
        <attr name="navButton"/>
        <attr name="rightButtonColor"/>
        <attr name="rightButtonLabel" format="string"/>
    </declare-styleable>

    <declare-styleable name="OrderTypeToolbar">
        <attr name="navButton"/>
        <attr name="rightButtonColor"/>
        <attr name="rightButtonIcon"/>
        <attr name="rightButtonTextColor" format="color"/>
    </declare-styleable>

    <declare-styleable name="CustomButtonsToolbar">
        <attr name="navButton"/>
        <attr name="title"/>
        <attr name="titleTextColor"/>
        <attr name="rightButtonIcon"/>
    </declare-styleable>



    <declare-styleable name="EmptyStateView">

        <attr name="emptyStateDrawable" format="reference"/>
        <attr name="emptyStateTitle" format="reference"/>
    </declare-styleable>
</resources>