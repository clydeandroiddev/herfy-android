<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_history"
    app:startDestination="@id/new_history_fragment">

    <include app:graph="@navigation/nav_order_tracker" />

    <fragment
        android:id="@+id/new_history_fragment"
        android:name="com.herfy.history.historynew.NewHistoryFragment"
        tools:layout="@layout/fragment_new_order_history">

        <deepLink app:uri="android-app://com.herfy/new_history_fragment_nav" />

        <action
            android:id="@+id/action_history_to_details"
            app:destination="@id/new_order_details_fragment"
            app:popUpTo="@+id/new_history_fragment" />

        <action
            android:id="@+id/action_history_to_tracker"
            app:destination="@id/nav_order_tracker"
            app:popUpTo="@+id/new_history_fragment">

            <argument
                android:name="orderId"
                app:argType="string"
                app:nullable="false" />


        </action>

    </fragment>

    <fragment
        android:id="@+id/new_order_details_fragment"
        android:name="com.herfy.history.historynew.NewOrderDetailsFragment"
        tools:layout="@layout/fragment_new_order_details">

        <argument
            android:name="orderId"
            app:argType="string"
            app:nullable="false" />

    </fragment>

</navigation>