<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_auth">

    <fragment
        android:id="@+id/nav_login_fragment"
        android:name="com.herfy.authentication.views.LoginFragment"
        tools:layout="@layout/fragment_login">

    </fragment>

    <fragment
        android:id="@+id/nav_signin_register"
        android:name="com.herfy.auth.views.AuthFragment"
        tools:layout="@layout/fragment_auth">

        <argument
            android:name="sign_in"
            android:defaultValue="true"
            app:argType="boolean" />

        <argument
            android:name="guest"
            android:defaultValue="false"
            app:argType="boolean" />

        <argument
            android:name="history"
            android:defaultValue="false"
            app:argType="boolean" />

        <argument
            android:name="account"
            android:defaultValue="false"
            app:argType="boolean" />

        <argument
            android:name="curbside"
            android:defaultValue="false"
            app:argType="boolean" />

        <argument
            android:name="checkout"
            android:defaultValue="false"
            app:argType="boolean" />

        <action
            android:id="@+id/action_auth_to_guest"
            app:destination="@id/nav_guest"
            app:popUpTo="@+id/nav_guest" />

    </fragment>

    <fragment
        android:id="@+id/nav_guest"
        android:name="com.herfy.auth.views.GuestFragment"
        tools:layout="@layout/fragment_guest">

        <argument
            android:name="checkout"
            android:defaultValue="false"
            app:argType="boolean" />

    </fragment>

</navigation>