<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<androidx.coordinatorlayout.widget.CoordinatorLayout
		android:id="@+id/coordinator"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent">

		<com.google.android.material.appbar.AppBarLayout
			android:id="@+id/appBarLayout"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:background="@color/mercury"
			app:elevation="0dp">

			<com.google.android.material.appbar.CollapsingToolbarLayout
				android:id="@+id/main_toolbar"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:maxHeight="@dimen/menu_appbar_height_no_slider"
				app:layout_scrollFlags="scroll|exitUntilCollapsed"
				tools:layout_height="@dimen/menu_appbar_height">

				<View
					android:id="@+id/empty_slider"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:background="@color/white"
					app:layout_collapseMode="parallax"
					tools:layout_height="@dimen/menu_appbar_height_no_slider" />

				<androidx.constraintlayout.widget.ConstraintLayout
					app:layout_collapseMode="parallax"
					android:layout_width="match_parent"
					android:layout_height="wrap_content">

					<androidx.viewpager2.widget.ViewPager2
						android:id="@+id/slider_view_pager"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						app:layout_constraintTop_toTopOf="parent"
						android:layoutDirection="locale"
						app:layout_collapseMode="parallax"
						android:visibility="gone"/>

					<com.tbuonomo.viewpagerdotsindicator.StrokeDotsIndicator
						android:id="@+id/dots_indicator"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_gravity="center_horizontal|bottom"
						app:dotsColor="#00000000"
						app:dotsSize="10dp"
						app:dotsStrokeWidth="1dp"
						app:dotsStrokeColor="@color/white"
						app:layout_collapseMode="parallax"
						app:dotsSpacing="4dp"
						app:dotsWidthFactor="3.5"
						android:visibility="gone"
						app:layout_constraintBottom_toBottomOf="parent"
						android:layout_marginBottom="18dp"
						app:layout_constraintEnd_toEndOf="parent"
						app:layout_constraintStart_toStartOf="parent"
						app:progressMode="false"
						app:selectedDotColor="@color/white"/>

				</androidx.constraintlayout.widget.ConstraintLayout>

				<com.facebook.shimmer.ShimmerFrameLayout
					android:id="@+id/new_menu_banner_shimmer"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					app:shimmer_duration="1000">

					<include layout="@layout/placeholder_banner" />

				</com.facebook.shimmer.ShimmerFrameLayout>

				<androidx.appcompat.widget.Toolbar
					android:id="@+id/toolbar_main"
					android:layout_width="match_parent"
					android:layout_height="@dimen/tab_layout_no_search"
					app:layout_collapseMode="pin" />

				<com.herfy.views.CenteringTabLayout
					android:id="@+id/tabs_layout"
					android:layout_width="wrap_content"
					android:layout_height="112dp"
					android:layout_gravity="bottom|center_horizontal"
					android:animateLayoutChanges="true"
					android:animationCache="true"
					android:foregroundGravity="center"
					android:background="@color/mercury"
					app:layout_collapseMode="pin"
					app:tabBackground="@android:color/transparent"
					app:tabGravity="fill"
					app:tabIndicatorColor="?attr/colorPrimary"
					app:tabIndicatorFullWidth="false"
					app:tabMode="scrollable"
					app:tabRippleColor="@null" />

				<com.facebook.shimmer.ShimmerFrameLayout
					android:id="@+id/new_menu_tabs_shimmer"
					android:layout_width="match_parent"
					android:layout_height="112dp"
					android:layout_gravity="bottom"
					app:shimmer_duration="1000"
					android:visibility="gone">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:clipToPadding="false"
						android:orientation="horizontal">

						<include layout="@layout/placeholder_tab_category" />

						<include layout="@layout/placeholder_tab_category" />

						<include layout="@layout/placeholder_tab_category" />

						<include layout="@layout/placeholder_tab_category" />

						<include layout="@layout/placeholder_tab_category" />

					</LinearLayout>

				</com.facebook.shimmer.ShimmerFrameLayout>

				<com.facebook.shimmer.ShimmerFrameLayout
					android:id="@+id/new_menu_tabs_shimmer_text"
					android:layout_width="match_parent"
					android:layout_height="24dp"
					android:layout_gravity="bottom"
					app:shimmer_duration="1000"
					android:visibility="gone">

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="match_parent"
						android:clipToPadding="false"
						android:orientation="horizontal">

						<include layout="@layout/placeholder_tab_category_text" />

						<include layout="@layout/placeholder_tab_category_text" />

						<include layout="@layout/placeholder_tab_category_text" />

						<include layout="@layout/placeholder_tab_category_text" />

						<include layout="@layout/placeholder_tab_category_text" />

					</LinearLayout>

				</com.facebook.shimmer.ShimmerFrameLayout>

				<androidx.constraintlayout.widget.ConstraintLayout
					android:id="@+id/search_box"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:layout_gravity="bottom"
					android:layout_marginStart="10dp"
					android:layout_marginEnd="10dp"
					android:layout_marginBottom="@dimen/search_box_bottom_padding"
					app:layout_collapseMode="pin">

					<View
						android:id="@+id/spaceTwo"
						android:layout_width="match_parent"
						android:layout_height="20dp"
						android:visibility="gone"
						app:layout_constraintTop_toTopOf="parent"/>

					<androidx.cardview.widget.CardView
						android:id="@+id/card_order_type_container"
						android:layout_width="0dp"
						android:layout_height="70dp"
						android:layout_marginEnd="76dp"
						app:cardBackgroundColor="@color/white"
						app:cardCornerRadius="8dp"
						app:cardElevation="3dp"
						app:cardUseCompatPadding="true"
						app:layout_constraintEnd_toEndOf="parent"
						app:layout_constraintStart_toStartOf="parent"
						app:layout_constraintTop_toBottomOf="@id/spaceTwo">

						<androidx.constraintlayout.widget.ConstraintLayout
							android:id="@+id/card_order_type"
							android:layout_width="match_parent"
							android:layout_height="match_parent"
							android:background="?attr/selectableItemBackground"
							android:paddingStart="16dp"
							android:paddingEnd="16dp">

							<androidx.constraintlayout.widget.Guideline
								android:id="@+id/center"
								android:layout_width="match_parent"
								android:layout_height="wrap_content"
								android:orientation="horizontal"
								app:layout_constraintGuide_percent="0.4" />

							<androidx.appcompat.widget.AppCompatTextView
								android:id="@+id/order_type"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:layout_marginTop="8dp"
								android:fontFamily="@font/cairo_black"
								android:includeFontPadding="false"
								android:textColor="@color/cod_gray"
								android:textSize="10sp"
								app:layout_constraintTop_toTopOf="parent"
								app:layout_constraintStart_toStartOf="parent"
								tools:text="PICK UP FROM" />

							<androidx.appcompat.widget.AppCompatTextView
								android:id="@+id/branch_name"
								android:layout_width="0dp"
								android:layout_height="wrap_content"
								android:includeFontPadding="false"
								android:ellipsize="end"
								android:fontFamily="@font/cairo_regular"
								android:gravity="start"
								android:maxLines="1"
								android:paddingStart="0dp"
								android:paddingEnd="5dp"
								android:textAlignment="viewStart"
								android:textColor="@color/cod_gray"
								android:textSize="13sp"
								android:lineSpacingExtra="-7dp"
								app:layout_constraintEnd_toStartOf="@id/image_union"
								app:layout_constraintStart_toStartOf="parent"
								app:layout_constraintTop_toBottomOf="@id/center"
								tools:text="King Abdulla Branch"/>

							<androidx.appcompat.widget.AppCompatImageView
								android:id="@+id/image_union"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:background="@drawable/ic_union"
								app:layout_constraintBottom_toBottomOf="@id/branch_name"
								app:layout_constraintEnd_toEndOf="parent"
								app:layout_constraintTop_toTopOf="@id/branch_name" />

						</androidx.constraintlayout.widget.ConstraintLayout>

					</androidx.cardview.widget.CardView>

					<androidx.cardview.widget.CardView
						android:id="@+id/card_search_container"
						android:layout_width="@dimen/search_bar_start_width"
						android:layout_height="70dp"
						app:cardBackgroundColor="@color/white"
						app:cardCornerRadius="8dp"
						app:cardElevation="3dp"
						app:cardUseCompatPadding="true"
						app:layout_constraintEnd_toEndOf="parent"
						app:layout_constraintTop_toTopOf="parent">

						<androidx.constraintlayout.widget.ConstraintLayout
							android:layout_width="match_parent"
							android:layout_height="match_parent">

							<FrameLayout
								android:id="@+id/card_close"
								android:layout_width="wrap_content"
								android:layout_height="match_parent"
								android:background="?attr/selectableItemBackground"
								android:paddingStart="26.5dp"
								android:paddingEnd="26.5dp"
								android:visibility="gone"
								app:layout_constraintBottom_toBottomOf="parent"
								app:layout_constraintEnd_toEndOf="parent"
								app:layout_constraintTop_toTopOf="parent">

								<androidx.appcompat.widget.AppCompatImageView
									android:layout_width="wrap_content"
									android:layout_height="wrap_content"
									android:layout_gravity="center"
									app:srcCompat="@drawable/ic_search_close" />

							</FrameLayout>

							<androidx.appcompat.widget.AppCompatEditText
								android:id="@+id/search_text"
								android:layout_width="0dp"
								android:layout_height="0dp"
								android:background="@null"
								android:fontFamily="@font/cairo_regular"
								android:gravity="center"
								android:inputType="textVisiblePassword"
								android:lineSpacingExtra="-12dp"
								android:maxLines="2"
								android:textColor="@color/cod_gray"
								app:layout_constraintBottom_toBottomOf="parent"
								app:layout_constraintEnd_toStartOf="@id/card_close"
								app:layout_constraintStart_toEndOf="@id/card_search"
								app:layout_constraintTop_toTopOf="parent"
								tools:text="Sample Search" />

							<FrameLayout
								android:id="@+id/card_search"
								android:layout_width="wrap_content"
								android:layout_height="match_parent"
								android:background="?attr/selectableItemBackground"
								android:paddingStart="23.5dp"
								android:paddingEnd="23.5dp"
								app:layout_constraintBottom_toBottomOf="parent"
								app:layout_constraintStart_toStartOf="parent"
								app:layout_constraintTop_toTopOf="parent">

								<androidx.appcompat.widget.AppCompatImageView
									android:layout_width="18dp"
									android:layout_height="18dp"
									android:layout_gravity="center"
									app:srcCompat="@drawable/ic_search" />

							</FrameLayout>

						</androidx.constraintlayout.widget.ConstraintLayout>

					</androidx.cardview.widget.CardView>

					<View
						android:id="@+id/space"
						android:layout_width="match_parent"
						android:layout_height="20dp"
						app:layout_constraintTop_toBottomOf="@+id/card_order_type_container"/>

				</androidx.constraintlayout.widget.ConstraintLayout>

			</com.google.android.material.appbar.CollapsingToolbarLayout>

		</com.google.android.material.appbar.AppBarLayout>

		<RelativeLayout
			android:id="@+id/menu_content"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:paddingTop="4dp"
			android:background="@color/mercury"
			android:fitsSystemWindows="true"
			android:fillViewport="true"
			app:layout_behavior="@string/appbar_scrolling_view_behavior">

			<androidx.recyclerview.widget.RecyclerView
				android:id="@+id/menu_recycler_view"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:layout_marginStart="12dp"
				android:layout_marginEnd="12dp"
				android:paddingBottom="16dp"
				android:descendantFocusability="blocksDescendants"
				android:focusableInTouchMode="false"
				android:visibility="gone"/>

			<com.facebook.shimmer.ShimmerFrameLayout
				android:id="@+id/new_menu_item_shimmer"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_alignParentTop="true"
				app:shimmer_duration="1000"
				android:visibility="gone">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:orientation="vertical">

					<include layout="@layout/placeholder_new_menu_item" />

					<include layout="@layout/placeholder_new_menu_item" />

					<include layout="@layout/placeholder_new_menu_item" />

				</LinearLayout>

			</com.facebook.shimmer.ShimmerFrameLayout>

		</RelativeLayout>

	</androidx.coordinatorlayout.widget.CoordinatorLayout>

	<FrameLayout
		android:id="@+id/with_search_layout"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:layout_marginTop="74dp"
		android:paddingTop="8dp"
		android:background="@color/mercury"
		android:visibility="gone"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent">

		<LinearLayout
			android:id="@+id/search_empty_layout"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="77dp"
			android:gravity="center"
			android:orientation="vertical"
			android:visibility="gone">

			<androidx.appcompat.widget.AppCompatImageView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				app:srcCompat="@drawable/ic_search_empty" />

			<androidx.appcompat.widget.AppCompatTextView
				android:id="@+id/search_empty_text"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/pixel_ten"
				android:fontFamily="@font/cairo_black"
				android:textColor="@color/cod_gray"
				android:textSize="18sp"
				tools:text="No item found" />

			<androidx.appcompat.widget.AppCompatTextView
				android:id="@+id/search_empty_text_desc"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:fontFamily="@font/cairo_regular"
				android:gravity="center"
				android:lineSpacingExtra="-6dp"
				android:paddingStart="72dp"
				android:paddingEnd="72dp"
				android:textColor="#B5B5B5"
				tools:text="Sorry, we were unable to find something that matches your search." />

		</LinearLayout>

		<com.facebook.shimmer.ShimmerFrameLayout
			android:id="@+id/new_menu_item_search_shimmer"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:visibility="gone"
			app:shimmer_duration="1000">

			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:orientation="vertical">

				<include layout="@layout/placeholder_new_menu_item" />

				<include layout="@layout/placeholder_new_menu_item" />

				<include layout="@layout/placeholder_new_menu_item" />

			</LinearLayout>

		</com.facebook.shimmer.ShimmerFrameLayout>

		<androidx.recyclerview.widget.RecyclerView
			android:id="@+id/menu_items_search_list"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:clipToPadding="false"
			android:paddingStart="10dp"
			android:paddingEnd="10dp"
			android:paddingBottom="10dp"
			tools:listitem="@layout/item_menu_item_new" />

	</FrameLayout>

	<androidx.constraintlayout.widget.ConstraintLayout
		android:id="@+id/total_container"
		android:layout_width="match_parent"
		android:layout_height="55dp"
		android:layout_marginStart="@dimen/margin_basic_16dp"
		android:layout_marginEnd="@dimen/margin_basic_16dp"
		android:layout_marginBottom="18dp"
		android:clickable="true"
		android:focusable="true"
		android:background="@drawable/background_oval"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent">

		<androidx.constraintlayout.widget.ConstraintLayout
			android:id="@+id/cart"
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:layout_gravity="start|center_vertical"
			android:layout_marginStart="@dimen/margin_basic_16dp"
			android:gravity="start|center_vertical"
			android:paddingStart="8dp"
			android:paddingEnd="16dp"
			app:layout_constraintStart_toStartOf="parent">

			<androidx.appcompat.widget.AppCompatImageView
				android:id="@+id/cart_icon"
				android:layout_width="@dimen/cart_icon_width"
				android:layout_height="24dp"
				android:visibility="visible"
				tools:visibility="gone"
				app:layout_constraintBottom_toBottomOf="parent"
				app:layout_constraintStart_toStartOf="parent"
				app:layout_constraintTop_toTopOf="parent"
				app:srcCompat="@drawable/ic_cart"
				app:tint="@color/white" />

			<TextView
				android:id="@+id/cart_quantity"
				android:layout_width="20dp"
				android:layout_height="20dp"
				android:layout_gravity="center"
				android:layout_marginTop="8dp"
				android:background="@drawable/background_cart_quantity"
				android:fontFamily="@font/cairo_regular"
				android:gravity="center"
				android:includeFontPadding="false"
				android:textAlignment="center"
				android:textColor="@color/white"
				android:textSize="10sp"
				android:visibility="gone"
				app:layout_constraintStart_toEndOf="@+id/cart_icon"
				app:layout_constraintTop_toTopOf="parent" />

		</androidx.constraintlayout.widget.ConstraintLayout>

		<androidx.appcompat.widget.AppCompatTextView
			android:id="@+id/total_price"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:fontFamily="@font/cairo_bold"
			android:text="0 SR"
			android:textAllCaps="true"
			android:textColor="@color/white"
			android:textSize="15sp"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintStart_toEndOf="@+id/cart"
			app:layout_constraintTop_toTopOf="parent"
			tools:text="0 SR" />

		<androidx.appcompat.widget.AppCompatTextView
			android:id="@+id/btnViewBag"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:layout_marginEnd="16dp"
			android:layout_marginBottom="4dp"
			android:background="@drawable/background_view_bag"
			android:fontFamily="@font/cairo_bold"
			android:gravity="center"
			android:includeFontPadding="false"
			android:paddingStart="10dp"
			android:paddingTop="4dp"
			android:paddingEnd="10dp"
			android:paddingBottom="4dp"
			android:text="VIEW BAG"
			android:textAlignment="center"
			android:textAllCaps="true"
			android:textColor="?attr/colorPrimary"
			android:textSize="14sp"
			android:textStyle="bold"
			app:layout_constraintBottom_toBottomOf="parent"
			app:layout_constraintEnd_toEndOf="parent"
			app:layout_constraintTop_toTopOf="parent" />

	</androidx.constraintlayout.widget.ConstraintLayout>

	<View
		android:id="@+id/blocker"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		app:layout_constraintBottom_toBottomOf="parent"
		app:layout_constraintEnd_toEndOf="parent"
		app:layout_constraintStart_toStartOf="parent"
		app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
