<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="-4dp"
        android:bottom="-4dp"
        android:left="-4dp">
        <shape>
            <solid android:color="@android:color/transparent"/>
            <stroke
                android:width="2dp"
                android:color="?attr/colorPrimary"
                android:dashGap="2dp"
                android:dashWidth="5dp"/>
        </shape>
    </item>
</layer-list>