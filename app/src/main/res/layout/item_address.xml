<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="true"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="10dp"
        android:paddingEnd="16dp"
        android:background="?selectableItemBackground">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_label"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:tint="?attr/colorPrimary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/linearLayout3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/linearLayout3"
            app:layout_constraintVertical_bias="0.22000003" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/icon_selected"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_checkbox_selected"
            android:tint="?attr/colorPrimary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/icon_label"
            app:layout_constraintEnd_toEndOf="@+id/icon_label"
            app:layout_constraintStart_toStartOf="@+id/icon_label"
            app:layout_constraintTop_toTopOf="@+id/icon_label" />

        <LinearLayout
            android:id="@+id/linearLayout3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/bookmark"
            app:layout_constraintStart_toEndOf="@+id/icon_label"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_bold"
                android:gravity="start"
                android:includeFontPadding="false"
                android:textAlignment="viewStart"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-6dp"
                android:layout_marginBottom="1dp"
                android:fontFamily="@font/cairo_regular"
                android:gravity="start"
                android:includeFontPadding="false"
                android:lineSpacingExtra="-7dp"
                android:maxLines="2"
                android:textAlignment="viewStart"
                android:textColor="#626262"
                android:textSize="12sp" />

            <!-- <TextView
                android:id="@+id/instructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/secondary_text"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:textSize="12sp"
                android:layout_marginTop="8dp"/>-->

        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/bookmark"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:backgroundTint="@color/white"
            android:padding="16dp"
            app:tint="#BABABA"
            app:fabCustomSize="40dp"
            app:srcCompat="@drawable/bookmark_unselected"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:elevation="4dp"/>

        <!--<com.google.android.material.button.MaterialButton
            android:id="@+id/delete"
            android:layout_width="20dp"
            android:layout_height="32dp"
            app:cornerRadius="3dp"
            app:icon="@drawable/cart_delete"
            app:iconTint="@color/black"
            app:backgroundTint="@color/delete_cart_item"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:iconPadding="0dp"
            app:iconGravity="textStart"/>-->

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
