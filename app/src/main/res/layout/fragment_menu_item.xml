<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/footer"
        tools:visibility="visible"
        android:visibility="invisible">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white">



            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/main_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="@dimen/menu_appbar_height_no_slider"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                tools:layout_height="@dimen/menu_appbar_height">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_scrollFlags="scroll|enterAlways">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/image_shimmer"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/menu_item_details_image_height"
                        app:layout_constraintTop_toTopOf="parent"
                        app:shimmer_duration="800"
                        android:visibility="gone" >

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/menu_item_details_image_height"
                            android:background="@color/placeholder_color" />

                    </com.facebook.shimmer.ShimmerFrameLayout>

                    <ImageView
                        android:id="@+id/image"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/menu_item_details_image_height"
                        android:scaleType="centerCrop" />

                    <FrameLayout
                        android:id="@+id/favorite_card"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentStart="true"
                        android:layout_alignParentTop="true"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/background_favorite"
                        android:elevation="8dp"
                        android:visibility="invisible">

                        <RelativeLayout
                            android:id="@+id/favorite_container"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="?selectableItemBackground">

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/favorite_icon"
                                android:layout_width="20dp"
                                android:layout_height="18dp"
                                android:layout_centerInParent="true"
                                android:scaleType="fitXY"
                                app:srcCompat="@drawable/ic_heart"
                                app:tint="#DEDEDE" />

                        </RelativeLayout>

                    </FrameLayout>

                </RelativeLayout>

            </com.google.android.material.appbar.CollapsingToolbarLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:elevation="5dp"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/details_shimmer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shimmer_duration="800"
                    android:visibility="gone" >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <View
                            android:layout_width="130dp"
                            android:layout_height="20dp"
                            android:background="@color/placeholder_color" />

                        <View
                            android:layout_width="200dp"
                            android:layout_height="20dp"
                            android:background="@color/placeholder_color"
                            android:layout_marginTop="16dp"/>

                        <View
                            android:layout_width="100dp"
                            android:layout_height="20dp"
                            android:background="@color/placeholder_color"
                            android:layout_marginTop="16dp" />

                    </LinearLayout>

                </com.facebook.shimmer.ShimmerFrameLayout>

                <com.nex3z.flowlayout.FlowLayout
                    android:id="@+id/allergens_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    app:flChildSpacingForLastRow="align"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/cairo_bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/primary_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/allergens_container" />

                <TextView
                    android:id="@+id/calories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/cairo_regular"
                    android:includeFontPadding="false"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="14sp"
                    android:layout_marginBottom="-5dp"
                    app:layout_constraintBottom_toBottomOf="@+id/name"
                    app:layout_constraintStart_toEndOf="@+id/name"
                    app:layout_constraintTop_toTopOf="@+id/name" />

                <TextView
                    android:id="@+id/description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cairo_regular"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="-7dp"
                    android:textAlignment="viewStart"
                    android:textColor="#969696"
                    android:textSize="14sp"
                    app:layout_constraintTop_toBottomOf="@+id/name" />

                <ImageView
                    android:id="@+id/discount_indicator"
                    android:layout_width="47dp"
                    android:layout_height="47dp"
                    android:layout_marginStart="-8dp"
                    android:layout_marginTop="4dp"
                    android:src="@drawable/ic_discount_indicator"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/name"
                    app:layout_constraintStart_toEndOf="@+id/calories"
                    app:layout_constraintTop_toTopOf="@+id/name"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cairo_bold"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:textAlignment="viewStart"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/description" />

                <TextView
                    android:id="@+id/soldout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/background_oval"
                    android:fontFamily="@font/cairo_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textAlignment="center"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="14dp"
                    app:layout_constraintBottom_toBottomOf="@+id/total"
                    app:layout_constraintStart_toEndOf="@+id/total"
                    app:layout_constraintTop_toTopOf="@+id/total" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:id="@+id/content_main"
            android:layout_height="match_parent"
            android:background="#FAFBFC"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:id="@+id/nested_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:paddingBottom="16dp">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/components_shimmer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:shimmer_duration="800"
                    android:visibility="gone" >

                    <include layout="@layout/placeholder_combo_meal" />

                </com.facebook.shimmer.ShimmerFrameLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/mealDealsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:visibility="gone">

                    <include
                        android:id="@+id/meal_deals_tabs"
                        layout="@layout/tabs" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/sizes_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="4dp"
                    app:cardUseCompatPadding="true">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="2dp">

                        <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                            android:id="@+id/sizes_segmented"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:background="@android:color/white"
                            android:layoutDirection="ltr"
                            android:padding="4dp"
                            app:dividerPadding="0dp"
                            app:dividerWidth="0dp"
                            app:radius="24dp"
                            app:ripple="true"
                            app:selectedBackground="?attr/colorPrimary"
                            app:selectedButtonRadius="24dp">

                            <com.addisonelliott.segmentedbutton.SegmentedButton
                                android:id="@+id/size_first"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center_vertical|center_horizontal"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="@font/cairo_bold"
                                android:padding="8dp"
                                android:textAlignment="center"
                                app:linesCount="1"
                                app:selectedTextColor="@color/white"
                                app:textColor="#9F9F9F"
                                app:textSize="14sp"
                                app:textStyle="bold" />

                            <com.addisonelliott.segmentedbutton.SegmentedButton
                                android:id="@+id/size_second"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center_vertical|center_horizontal"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="@font/cairo_bold"
                                android:padding="8dp"
                                android:textAlignment="center"
                                app:linesCount="1"
                                app:selectedTextColor="@color/white"
                                app:textColor="#9F9F9F"
                                app:textSize="14sp"
                                app:textStyle="bold" />

                            <com.addisonelliott.segmentedbutton.SegmentedButton
                                android:id="@+id/size_third"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="center_vertical|center_horizontal"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="@font/cairo_bold"
                                android:padding="8dp"
                                android:textAlignment="center"
                                app:linesCount="1"
                                app:selectedTextColor="@color/white"
                                app:textColor="#9F9F9F"
                                app:textSize="14sp"
                                app:textStyle="bold" />

                        </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>

                    </RelativeLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/sizes_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/cairo_bold"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:text="PICK MEAL SIZE"
                    android:textAlignment="viewStart"
                    android:textAllCaps="true"
                    android:textColor="#ACACAC"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/sizes_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:descendantFocusability="blocksDescendants"
                    android:focusableInTouchMode="false"
                    android:visibility="gone"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/combosList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:layoutDirection="locale"
                    android:nestedScrollingEnabled="false"
                    android:paddingTop="2dp"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_combos"
                    tools:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/yourWayList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:layoutDirection="locale"
                    android:nestedScrollingEnabled="false"
                    android:paddingTop="2dp"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@id/combosList"
                    tools:itemCount="1"
                    tools:listitem="@layout/item_yourway_list"
                    tools:visibility="visible" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/modifier_groups_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:descendantFocusability="blocksDescendants"
                    android:focusableInTouchMode="false"
                    android:paddingTop="2dp"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior" />

                <TextView
                    android:id="@+id/ingredients_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/cairo_bold"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:text="INGREDIENTS"
                    android:textAlignment="viewStart"
                    android:textAllCaps="true"
                    android:textColor="@color/primary_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ingredients_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:descendantFocusability="blocksDescendants"
                    android:focusableInTouchMode="false"
                    android:visibility="gone"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior" />

                <TextView
                    android:id="@+id/notes_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/cairo_bold"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:text="NOTES"
                    android:textAlignment="viewStart"
                    android:textAllCaps="true"
                    android:textColor="#ACACAC"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/notes_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardUseCompatPadding="true"
                    app:cardPreventCornerOverlap="false"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="8dp"
                    app:cardBackgroundColor="@color/white">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:background="?selectableItemBackground">

                        <EditText
                            android:id="@+id/et_item_notes"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:background="@null"
                            android:textColorHint="#ACACAC"
                            android:gravity="start"
                            android:fontFamily="@font/cairo_regular"
                            android:textSize="14sp"
                            android:maxLines="4"
                            android:maxLength="512"
                            android:inputType="text"
                            android:imeOptions="actionDone"
                            android:textAlignment="viewStart"
                            app:layout_constraintTop_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>





            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:elevation="5dp"
        android:orientation="horizontal"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/minus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:background="?selectableItemBackground"
            app:layout_constraintBottom_toBottomOf="@+id/add"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/add"
            app:srcCompat="@drawable/ic_new_minus" />

        <TextView
            android:id="@+id/quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/cairo_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="1"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/add"
            app:layout_constraintStart_toEndOf="@+id/minus"
            app:layout_constraintTop_toTopOf="@+id/add" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/plus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="?selectableItemBackground"
            app:layout_constraintBottom_toBottomOf="@+id/add"
            app:layout_constraintStart_toEndOf="@+id/quantity"
            app:layout_constraintTop_toTopOf="@+id/add"
            app:srcCompat="@drawable/ic_herfy_plus" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/add"
            android:layout_width="0dp"
            android:layout_height="53dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="24dp"
            android:fontFamily="@font/cairo_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="ADD TO BAG"
            android:textAlignment="center"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="?attr/colorPrimary"
            app:cornerRadius="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/plus"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</RelativeLayout>
