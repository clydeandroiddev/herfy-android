<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/top"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/end"
            android:layout_width="6dp"
            android:layout_height="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/start"
            android:layout_width="6dp"
            android:layout_height="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/bottom"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            app:layout_constraintTop_toBottomOf="@id/tabsSection" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tabsSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="46dp"
            app:cardElevation="4dp"
            app:cardPreventCornerOverlap="true"
            app:layout_constraintBottom_toTopOf="@id/bottom"
            app:layout_constraintEnd_toStartOf="@id/end"
            app:layout_constraintStart_toEndOf="@id/start"
            app:layout_constraintTop_toBottomOf="@id/top">

            <com.addisonelliott.segmentedbutton.SegmentedButtonGroup
                android:id="@+id/buttonType"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_centerInParent="true"
                android:background="@android:color/white"
                android:layoutDirection="ltr"
                app:dividerPadding="0dp"
                app:dividerWidth="0dp"
                app:radius="46dp"
                app:ripple="true"
                app:selectedBackground="?attr/colorPrimary"
                app:selectedButtonRadius="46dp">

                <com.addisonelliott.segmentedbutton.SegmentedButton
                    android:id="@+id/mealDealButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:fontFamily="fonts/cairo_bold.ttf"
                    android:padding="4dp"
                    app:textStyle="bold"
                    app:selectedTextColor="@color/white"
                    app:text="Meal Deal"
                    app:textColor="#9F9F9F" />

                <com.addisonelliott.segmentedbutton.SegmentedButton
                    android:id="@+id/sandwichOnlyButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    app:textStyle="bold"
                    android:fontFamily="fonts/cairo_bold.ttf"
                    android:padding="4dp"
                    app:selectedTextColor="@color/white"
                    app:text="Sandwich Only"
                    app:textColor="#9F9F9F" />

            </com.addisonelliott.segmentedbutton.SegmentedButtonGroup>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>