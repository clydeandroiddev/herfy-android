<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:cardPreventCornerOverlap="true"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container_promotion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?selectableItemBackground"
                android:padding="5dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/image_promotion"
                    android:layout_width="@dimen/item_menu_image_size"
                    android:layout_height="@dimen/item_menu_image_size"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:src="@drawable/image_item_stub" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="3dp"
                    app:layout_constraintBottom_toBottomOf="@id/image_promotion"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/image_promotion"
                    app:layout_constraintTop_toTopOf="@id/image_promotion">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/name_promotion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="28dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/cairo_bold"
                        android:gravity="top"
                        android:lineSpacingExtra="-8dp"
                        android:maxLines="2"
                        android:textColor="@color/primary_text"
                        android:textSize="15sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="2 Whopper Jr. + Hash Brown + Coca Cola + Hash Brown" />

                    <FrameLayout
                        android:id="@+id/quantity_layout_promotion"
                        android:layout_width="wrap_content"
                        android:layout_height="33dp"
                        android:layout_marginEnd="2dp"
                        android:layout_marginBottom="2dp"
                        android:background="@drawable/background_quantity_stroke"
                        app:layout_constraintBottom_toBottomOf="@id/total_price_promotion"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/total_price_promotion">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingStart="5dp"
                            android:paddingEnd="5dp">

                            <FrameLayout
                                android:id="@+id/minus"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/background_circle_primary_26"
                                android:visibility="invisible">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/minus_image" />

                            </FrameLayout>

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/promotion_quantity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:layout_marginEnd="4dp"
                                android:fontFamily="@font/cairo_bold"
                                android:gravity="center_vertical"
                                android:maxLines="1"
                                android:textColor="@color/primary_text"
                                android:textSize="18sp"
                                tools:text="1" />

                            <FrameLayout
                                android:id="@+id/plus"
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/background_circle_primary_26"
                                android:visibility="invisible">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/plus_image" />

                            </FrameLayout>

                        </LinearLayout>

                    </FrameLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/total_price_promotion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/cairo_bold"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="0dp"
                        android:maxLines="1"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="22sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/quantity_layout_promotion"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:text="252.00SR" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/modifier_items_ingredients_promotion"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toTopOf="@id/total_price_promotion"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/name_promotion">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/modifier_items_promotion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/cairo_semibold"
                            android:gravity="start|bottom"
                            android:lineSpacingExtra="-8dp"
                            android:maxLines="2"
                            android:textAlignment="viewStart"
                            android:textColor="@color/dusty_gray"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toTopOf="@+id/ingredients_promotion" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/ingredients_promotion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/cairo_semibold"
                            android:gravity="start|bottom"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="-8dp"
                            android:maxLines="2"
                            android:textAlignment="viewStart"
                            android:textColor="@color/dusty_gray"
                            android:textSize="12sp"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guideline2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintGuide_end="26dp" />


                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/promotion_edit"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/background_order_type"
                    android:scaleType="centerInside"
                    app:backgroundTint="@color/white"
                    app:elevation="4dp"
                    app:fabCustomSize="36dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:maxImageSize="15dp"
                    app:srcCompat="@drawable/ic_edit_item_cart" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/promotion_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_remove_a_main_dish_snack_drink_svg"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/promotion_notes_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                app:srcCompat="@drawable/cart_notes" />

            <EditText
                android:id="@+id/promotion_notes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="start"
                android:imeOptions="actionDone"
                android:fontFamily="@font/cairo_regular"
                android:includeFontPadding="false"
                android:inputType="text"
                android:maxLines="1"
                android:maxLength="512"
                android:singleLine="true"
                android:textAlignment="viewStart"
                android:textColor="@color/primary_text"
                android:textColorHint="#B5B5B5"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
