<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/digital_image"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:scaleType="fitXY"
                android:visibility="invisible"
                app:layout_constraintDimensionRatio="H,1:1"
                app:layout_constraintTop_toTopOf="parent" />

            <ProgressBar
                android:id="@+id/progress_image"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:layout_constraintBottom_toBottomOf="@id/digital_image"
                app:layout_constraintEnd_toEndOf="@id/digital_image"
                app:layout_constraintStart_toStartOf="@id/digital_image"
                app:layout_constraintTop_toTopOf="@id/digital_image" />

            <TextView
                android:id="@+id/digital_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/cairo_bold"
                android:gravity="start"
                android:includeFontPadding="false"
                android:lineSpacingExtra="-10dp"
                android:lines="2"
                android:maxLines="2"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:textAlignment="viewStart"
                android:textColor="@color/primary_text"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/digital_image"
                tools:text="Test Digital Promotions" />

            <TextView
                android:id="@+id/digital_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/cairo_semibold"
                android:gravity="start"
                android:includeFontPadding="false"
                android:lineSpacingExtra="-10dp"
                android:lines="2"
                android:maxLines="2"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textAlignment="viewStart"
                android:textColor="@color/primary_text"
                android:textSize="12sp"
                app:layout_constraintTop_toBottomOf="@id/digital_name"
                tools:text="Test Digital Promotions" />

            <View
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="0.1dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:background="#BCBCBC"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/digital_desc" />

            <LinearLayout
                android:id="@+id/time_requirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/divider">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_clock_instore" />

                <TextView
                    android:id="@+id/time_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/cairo_regular"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/primary_text"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/digital_name"
                    tools:text="Test Digital Promotions" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ordertype_requirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/time_requirements">

                <ImageView
                    android:id="@+id/image_ordertype"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_curbside_instore" />

                <TextView
                    android:id="@+id/ordertype"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/cairo_regular"
                    android:gravity="start"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:textAlignment="viewStart"
                    android:textColor="@color/primary_text"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/digital_name"
                    tools:text="To Go Only" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>