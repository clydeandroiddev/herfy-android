<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="menuItem"
            type="com.skylinedynamics.solosdk.api.models.objects.MenuItem" />
        <variable
            name="language"
            type="String"/>
        <variable
            name="total"
            type="Double"/>
        <variable
            name="viewModel"
            type="com.herfy.menuitem.viewmodel.MenuItemDetailViewModel" />
        <variable
            name="isVisible"
            type="Boolean" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:id="@+id/coordinator_layout"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/footer"
                tools:visibility="visible"
                android:visibility="invisible">

                <com.google.android.material.appbar.AppBarLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:elevation="0dp"
                    android:orientation="vertical"
                    android:theme="@style/AppTheme">

                    <com.google.android.material.appbar.CollapsingToolbarLayout
                        android:id="@+id/main_toolbar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:animateLayoutChanges="true"
                        android:fitsSystemWindows="true"
                        app:contentInsetLeft="0dp"
                        app:contentInsetStart="0dp"
                        app:contentInsetStartWithNavigation="0dp"
                        app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
                        app:titleEnabled="true">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_collapseMode="parallax">

                            <ImageView
                                android:id="@+id/image"
                                android:layout_width="match_parent"
                                android:layout_height="285dp"
                                android:layout_gravity="center_horizontal|center_vertical"
                                android:orientation="vertical"
                                app:imageSrc="@{menuItem.image}"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:src="@tools:sample/avatars" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="100dp"
                                app:layout_constraintTop_toBottomOf="@+id/image" />

                            <com.herfy.common.toolbar.CustomButtonsToolbar
                                android:id="@+id/cbt_menu_item"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/margin_large"
                                android:layout_marginTop="@dimen/margin_xlarge"
                                android:layout_marginEnd="@dimen/margin_large"
                                app:navButton="@drawable/ic_close_circle_white"
                                app:rightButtonIcon="@drawable/ic_favorite_empty"
                                app:layout_collapseMode="pin"
                                app:layout_constraintTop_toTopOf="parent"/>



                        </androidx.constraintlayout.widget.ConstraintLayout>



                    </com.google.android.material.appbar.CollapsingToolbarLayout>

                </com.google.android.material.appbar.AppBarLayout>

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/nsv_menu_item_detail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fitsSystemWindows="true"
                    android:layout_marginTop="-15dp"
                    android:fillViewport="true"
                    android:background="@drawable/common_background_half_corner_top"
                    app:layout_behavior="@string/appbar_scrolling_view_behavior"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:id="@+id/ln_menu_item_detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/cl_top_details"
                            android:layout_marginHorizontal="@dimen/margin_large"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <TextView
                                android:id="@+id/name"
                                style="@style/TextAppearance.Headline"
                                android:layout_marginEnd="@dimen/margin_large"
                                app:layout_constraintEnd_toStartOf="@+id/total"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_large"
                                android:includeFontPadding="false"
                                android:textColor="@color/black"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:text="Combo Large Super Herfy - Large Size"
                                android:text="@{menuItem.getName(language)}"/>

                            <TextView
                                android:id="@+id/tvSoldOut"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/background_oval"
                                android:fontFamily="@font/inter_medium"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp"
                                android:textAlignment="center"
                                android:textAllCaps="true"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                app:backgroundTint="#0064AC"
                                app:cornerRadius="14dp"
                                app:layout_constraintStart_toStartOf="@+id/name"
                                app:layout_constraintTop_toBottomOf="@+id/name"
                                android:layout_marginTop="8dp"/>

                            <TextView
                                android:id="@+id/total"
                                style="@style/Styles.Text.Headline1"
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:textColor="@color/text_color_blue"
                                app:layout_constraintBottom_toBottomOf="@+id/name"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="@+id/name"
                                app:layout_constraintVertical_bias="0.0"
                                tools:text="SAR 44" />

                            <TextView
                                android:id="@+id/description"
                                style="@style/TextAppearance.Footnote.Medium_Regular"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:gravity="start"
                                android:textAlignment="viewStart"
                                android:layout_marginTop="8dp"
                                android:textColor="@color/secondaryTextColor"
                                android:textSize="14sp"
                                android:text="@{menuItem.getDescription(language)}"
                                app:layout_constraintEnd_toEndOf="@+id/total"
                                app:layout_constraintHorizontal_bias="1.0"
                                app:layout_constraintStart_toStartOf="@+id/name"
                                app:layout_constraintTop_toBottomOf="@+id/tvSoldOut"
                                tools:text="Grilled chicken patty, topped with a flavorful slice of cheese and shredded fresh lettuce" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/txtMoreInfo"
                                style="@style/Styles.Text.Footnote.Semi.Bold"
                                android:layout_width="wrap_content"
                                android:layout_marginBottom="@dimen/margin_small"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_large"
                                android:drawableEnd="@drawable/ic_question_mark"
                                android:drawableTint="@color/text_color_blue"
                                android:drawablePadding="@dimen/margin_micro"
                                android:textAlignment="viewStart"
                                android:textColor="@color/text_color_blue"
                                android:visibility="gone"
                                app:layout_constraintBottom_toTopOf="@+id/viewSeparator"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/description"
                                app:lineHeight="20sp"
                                tools:text="More Info"
                                tools:visibility="visible" />

                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnCalories"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:backgroundTint="@color/white"
                                android:gravity="center"
                                android:layout_marginTop="@dimen/margin_large"
                                app:layout_constraintStart_toStartOf="@+id/description"
                                android:orientation="horizontal"
                                app:layout_constraintBottom_toTopOf="@+id/viewSeparator"
                                app:cardCornerRadius="@dimen/_12sdp"
                                android:layout_marginBottom="@dimen/margin_small"
                                app:cardPreventCornerOverlap="true"
                                app:cardUseCompatPadding="false"
                                app:layout_constraintTop_toBottomOf="@+id/description"
                                app:strokeColor="#D9E8F3"
                                app:strokeWidth="1dp">

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/calories"
                                    style="@style/Styles.Text.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_gravity="center_vertical"
                                    android:layout_weight="1"
                                    android:drawableStart="@drawable/ic_common_calories"
                                    android:drawablePadding="@dimen/margin_small"
                                    android:gravity="center_vertical"
                                    android:paddingStart="@dimen/padding_micro"
                                    android:paddingTop="@dimen/padding_micro"
                                    android:paddingEnd="@dimen/padding_micro"
                                    android:paddingBottom="@dimen/padding_micro"
                                    android:text="@{viewModel.calories}"
                                    tools:text="2200 Kcal" />
                            </androidx.cardview.widget.CardView>

                            <View
                                android:id="@+id/viewSeparator"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="@dimen/margin_small"
                                app:layout_constraintTop_toBottomOf="@id/btnCalories"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                android:background="@color/colorSeparator" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/sizesLayoutTextContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin_large"
                            android:visibility="gone"
                            tools:visibility="visible">


                            <ImageView
                                android:id="@+id/checkBox"
                                android:layout_width="34dp"
                                android:layout_height="25dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_modifier_group_checked_selected"
                                android:visibility="gone"
                                android:layout_marginTop="16dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:visibility="visible" />


                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/sizes_label"
                                style="@style/Styles.Text.Footnote.Semi.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="start"
                                android:includeFontPadding="false"
                                android:text="Choose size"
                                android:textAlignment="viewStart"
                                android:textColor="@color/black"
                                android:textSize="14sp"
                                android:layout_marginTop="@dimen/margin_large"
                                android:layout_marginStart="@dimen/margin_large"
                                app:layout_goneMarginStart="0dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/sizesImage"
                                app:layout_constraintTop_toTopOf="parent" />




                            <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/sizesImage"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@color/white"
                                android:scaleType="centerInside"
                                android:layout_marginTop="@dimen/margin_large"
                                android:layout_marginEnd="@dimen/margin_large"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Image.Circle"
                                app:strokeColor="@color/background_color_light_blue"
                                app:strokeWidth="2dp"
                                tools:src="@tools:sample/avatars" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/sizes_recycler_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:descendantFocusability="blocksDescendants"
                            android:focusableInTouchMode="false"
                            android:orientation="horizontal"
                            android:visibility="gone"
                            android:layout_marginHorizontal="@dimen/margin_medium"
                            app:layout_behavior="@string/appbar_scrolling_view_behavior"
                            tools:itemCount="2"
                            tools:listitem="@layout/item_new_size"
                            tools:visibility="gone" />

                        <View
                            android:id="@+id/viewSizesSeparator"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="@dimen/margin_large"
                            android:layout_marginHorizontal="@dimen/margin_large"
                            android:background="@color/colorSeparator"
                            android:visibility="gone"/>

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/shimmer_layout_modifiers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:layout_marginTop="@dimen/margin_large"
                            android:visibility="gone"
                            android:layout_marginHorizontal="@dimen/margin_small"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/orderTypeContainer"
                            app:shimmer_duration="1000"
                            tools:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">
                                <include layout="@layout/item_modifier_item_placeholder" />
                                <include layout="@layout/item_modifier_item_placeholder" />

                                <include layout="@layout/item_modifier_item_placeholder" />

                                <include layout="@layout/item_modifier_item_placeholder" />

                            </LinearLayout>
                        </com.facebook.shimmer.ShimmerFrameLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_modifiers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin_large"
                            android:clipToPadding="false"
                            android:descendantFocusability="blocksDescendants"
                            android:focusableInTouchMode="false"
                            android:paddingTop="2dp"
                            android:visibility="gone"
                            app:layout_behavior="@string/appbar_scrolling_view_behavior"
                            tools:itemCount="5"
                            tools:listitem="@layout/item_modifier_group_new"
                            tools:visibility="visible" />

                        <LinearLayout
                            android:id="@+id/notes_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/margin_large"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/notes_label"
                                style="@style/TextAppearance.Footnote.Semi_Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_xlarge"
                                android:gravity="start"
                                android:includeFontPadding="false"
                                android:text="@string/special_instruction"
                                android:textAlignment="viewStart"
                                android:textAllCaps="false"
                                android:textColor="#0C0C0C"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/notes_description"
                                style="@style/TextAppearance.Footnote"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:ellipsize="end"
                                android:layout_marginTop="@dimen/_5sdp"
                                android:gravity="start"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textAlignment="viewStart"
                                android:textAllCaps="false"
                                android:textColor="#55667B" />

                            <EditText
                                android:id="@+id/et_item_notes"
                                style="@style/Styles.Text.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="80dp"
                                android:layout_marginTop="@dimen/margin_large"
                                android:background="@drawable/bg_background_border"
                                android:gravity="start"
                                android:inputType="text"
                                android:maxLength="512"
                                android:maxLines="4"
                                android:textAlignment="viewStart"
                                android:textColorHint="#ACACAC"
                                android:textSize="14sp"
                                android:text="@={viewModel.notes}"/>

                            <View
                                android:id="@+id/notesDivider"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="@dimen/margin_xlarge"
                                android:background="#E6E8EB" />
                        </LinearLayout>

                        <!-- TODO  Revert the parent to visible state when client requests to re-enable frequently bought items feature  -->

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/txtFrequntlyBought"
                                style="@style/Styles.Text.Footnote.Semi.Bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone"
                                android:layout_marginStart="@dimen/margin_large"
                                android:layout_marginTop="@dimen/margin_xlarge"
                                android:text="Frequently Bought Together"
                                android:textColor="@color/dark_shade_of_grey"
                                android:textSize="16sp" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/frequently_bough_recycleview"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/margin_large"
                                android:clipToPadding="false"
                                android:descendantFocusability="blocksDescendants"
                                android:focusableInTouchMode="false"
                                android:layout_marginTop="@dimen/margin_xlarge"
                                android:orientation="vertical"
                                app:layout_behavior="@string/appbar_scrolling_view_behavior"
                                tools:visibility="visible" />

                        </LinearLayout>


                    </LinearLayout>

                </androidx.core.widget.NestedScrollView>


            </androidx.coordinatorlayout.widget.CoordinatorLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:backgroundTint="@color/white"
                android:id="@+id/footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="5dp"
                android:orientation="horizontal"
                android:paddingBottom="8dp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:visibility="visible">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/txtQuantity"
                    style="@style/Styles.Text.Subheadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_large"
                    android:layout_marginTop="@dimen/margin_large"
                    android:layout_marginBottom="@dimen/margin_large"
                    android:fontFamily="@font/inter_semi_bold"
                    android:textAlignment="viewStart"
                    android:textColor="#0C0C0C"
                    app:layout_constraintBottom_toTopOf="@+id/add"

                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Quantity" />

                <LinearLayout
                    android:id="@+id/clickableParentQuantityLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/margin_large"
                    android:background="@drawable/rounded_corner"
                    android:backgroundTint="#D9E8F3"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toTopOf="@+id/add"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/quantity"
                            style="@style/TextAppearance.Footnote.Medium_Regular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="@dimen/margin_large"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="1"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="@+id/minus"
                            app:layout_constraintEnd_toStartOf="@+id/plus"
                            app:layout_constraintTop_toTopOf="@+id/minus" />

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/plus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?selectableItemBackground"
                            android:textAlignment="viewEnd"
                            app:layout_constraintBottom_toBottomOf="@+id/minus"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@+id/minus"
                            app:srcCompat="@drawable/quantity_up_blue" />

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/minus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/margin_large"
                            android:background="?selectableItemBackground"
                            app:layout_constraintEnd_toStartOf="@+id/quantity"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/ic_new_minus" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/add"
                    style="@style/TextAppearance.Footnote.Semi_Bold"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="@dimen/margin_large"
                    android:layout_marginTop="@dimen/margin_large"
                    android:layout_marginBottom="@dimen/margin_xlarge"
                    android:background="@drawable/rounded_corner"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="@dimen/_30sdp"
                    android:paddingTop="@dimen/padding_small"
                    android:paddingEnd="@dimen/_30sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:text="ADD TO Cart"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="36dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txtQuantity"
                    app:strokeWidth="2dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>




        </androidx.constraintlayout.widget.ConstraintLayout>


        <FrameLayout
            android:id="@+id/fm_combo_detail"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <View
                android:id="@+id/view_bg_transparent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#BF000000"
                android:visibility="gone"/>

            <include
                android:id="@+id/layout_bottom_sheet_combo_detail"
                layout="@layout/bottom_sheet_panel_modifiers"/>


        </FrameLayout>

        <FrameLayout
            android:id="@+id/cl_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone"
            app:isVisible="@{isVisible}"
            >

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:background="#52000000"
                android:focusable="true" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:cardCornerRadius="20dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@color/white"
                app:cardElevation="4dp"
                android:layout_gravity="center">

                <ProgressBar
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true"/>

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>



</layout>