<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    android:focusable="false"
    android:clickable="true"
    android:longClickable="false"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp"
    app:cardPreventCornerOverlap="true"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_item"
            android:layout_width="@dimen/item_menu_image_size"
            android:layout_height="@dimen/item_menu_image_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/image_item_stub" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            app:layout_constraintBottom_toBottomOf="@id/image_item"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/image_item"
            app:layout_constraintTop_toTopOf="@id/image_item">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/item_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/cairo_semibold"
                android:lineSpacingExtra="-5dp"
                android:maxLines="2"
                android:textColor="@color/cod_gray"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toStartOf="@id/cv_calories"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:textAlignment="viewStart"
                android:gravity="start"
                tools:text="Single Hamburgini" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_calories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toEndOf="@id/item_name"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="6dp"
                app:strokeWidth="1dp"
                app:strokeColor="#DEDEDE"
                app:cardCornerRadius="5dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="false"
                app:cardPreventCornerOverlap="true"
               >

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/item_calories"
                    android:gravity="top"
                    android:paddingHorizontal="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cairo_regular"
                    tools:text="1500 cal"
                    android:textSize="10sp"
                    android:lineSpacingExtra="-9dp"
                    android:lines="1"
                    android:includeFontPadding="false"
                    tools:ignore="SmallSp" />

            </com.google.android.material.card.MaterialCardView>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/add_to_bag"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:background="@drawable/background_add_to_bag"
                android:fontFamily="@font/cairo_semibold"
                android:gravity="center"
                android:paddingStart="12dp"
                android:textAllCaps="true"
                android:paddingEnd="12dp"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginBottom="8dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="?attr/colorPrimary"
                tools:text="Add to Bag" />

            <ImageView
                android:id="@+id/discount_indicator"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="-20dp"
                android:layout_marginBottom="-22dp"
                android:translationZ="12dp"
                android:src="@drawable/ic_discount_indicator"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/add_to_bag"
                app:layout_constraintStart_toStartOf="@+id/add_to_bag"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/item_price"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fontFamily="@font/cairo_semibold"
                android:gravity="start|center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="?attr/colorPrimary"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="@id/add_to_bag"
                app:layout_constraintEnd_toStartOf="@id/add_to_bag"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/add_to_bag"
                tools:text="252.00SR" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/old_price"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginBottom="-22dp"
                android:fontFamily="@font/cairo_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:maxLines="1"
                android:textColor="@color/strikethrough"
                android:textSize="14sp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/item_price"
                app:layout_constraintEnd_toEndOf="@+id/item_price"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/item_description"
                tools:text="252.00SR"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/item_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/cairo_semibold"
                android:lineSpacingExtra="-10dp"
                android:maxLines="2"
                android:lines="2"
                android:textColor="@color/dusty_gray"
                android:textSize="12sp"
                android:textAlignment="viewStart"
                android:gravity="start"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/item_name" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.herfy.views.SlantedTextView
            android:id="@+id/stvSoldout"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:slantedBackgroundColor="?colorPrimary"
            app:slantedLength="40dp"
            app:slantedMode="right"
            android:visibility="gone"
            app:slantedTextColor="@color/white"
            app:slantedTextSize="16sp" />

        <FrameLayout
            android:id="@+id/favorite_card"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/background_favorite"
            android:elevation="4dp">

            <RelativeLayout
                android:id="@+id/favorite_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?selectableItemBackground">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/favorite_icon"
                    android:layout_width="17dp"
                    android:layout_height="15dp"
                    android:layout_centerInParent="true"
                    android:scaleType="fitXY"
                    app:srcCompat="@drawable/ic_heart_unselected"
                    app:tint="#DEDEDE" />

            </RelativeLayout>

        </FrameLayout>

        <!--<com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/card_fav"
            android:layout_width="36dp"
            android:layout_marginTop="5dp"
            android:layout_marginStart="5dp"
            android:layout_height="36dp"
            android:background="@drawable/background_order_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_heart"
            android:scaleType="centerInside"
            app:backgroundTint="@color/white"
            app:elevation="4dp"
            app:tint="#DEDEDE"
            app:fabCustomSize="36dp"
            android:padding="16dp"/>-->

        <!--<FrameLayout
              android:id="@+id/card_fav"
              android:layout_width="34dp"
              android:layout_height="34dp"
              android:layout_marginStart="3dp"
              android:layout_marginTop="3dp"
              android:background="@drawable/background_order_type"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent">

              <androidx.appcompat.widget.AppCompatImageView
                  android:id="@+id/heart_image"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_gravity="center"
                  app:srcCompat="@drawable/ic_gray_heart" />

          </FrameLayout>-->

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>



