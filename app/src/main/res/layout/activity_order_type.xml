<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".order.views.OrderTypeActivity">

    <RelativeLayout
        android:id="@+id/image_container"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/concept_image"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:scaleType="centerInside"
            android:layout_centerInParent="true"/>

    </RelativeLayout>

    <TextView
        android:id="@+id/message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/primary_text"
        app:layout_constraintTop_toBottomOf="@+id/image_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/close"
        android:textSize="18sp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        android:text="How would you like to get the food?"/>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="centerInside"
        android:background="?selectableItemBackground"
        app:srcCompat="@drawable/close"
        app:layout_constraintTop_toBottomOf="@+id/image_container"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"/>

    <com.google.android.material.tabs.TabLayout
        style="@style/Widget.MaterialComponents.TabLayout"
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        app:layout_constraintTop_toBottomOf="@+id/message"
        app:tabTextColor="#CCCCCC"
        app:tabSelectedTextColor="@color/white"
        app:tabIndicatorColor="@android:color/transparent"
        app:tabIndicatorHeight="0dp"
        app:tabIconTint="#1D1D1D"
        app:tabInlineLabel="true"
        app:tabTextAppearance="@style/OrderTypeTabTextAppearance" />

    <com.sothree.slidinguppanel.SlidingUpPanelLayout
        android:id="@+id/sliding_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/tab_layout"
        app:layout_constraintBottom_toTopOf="@+id/stores_continue"
        android:gravity="bottom"
        app:umanoShadowHeight="0dp"
        app:umanoPanelHeight="110dp"
        app:umanoOverlay="true"
        app:umanoFadeColor="@android:color/transparent"
        app:umanoAnchorPoint="0.53"
        app:umanoDragView="@+id/drag"
        app:umanoScrollableView="@+id/stores_recycler_view">

        <fragment
            android:id="@+id/order_type_map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/map_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" >

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/addresses_nested_scroll_view"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="@color/background"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/addresses_continue"
                    android:padding="16dp"
                    android:visibility="gone">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/current_location_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary_text"
                            android:textSize="14sp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            android:layout_marginTop="8dp"
                            android:gravity="start"
                            android:textAlignment="viewStart"
                            android:text="Current Location"
                            android:textStyle="bold"/>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/current_location_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardPreventCornerOverlap="true"
                            app:cardUseCompatPadding="true"
                            app:cardCornerRadius="5dp"
                            app:cardBackgroundColor="@color/white"
                            app:strokeWidth="1dp"
                            app:strokeColor="#BEBEBE"
                            app:layout_constraintTop_toBottomOf="@+id/current_location_label"
                            android:visibility="gone">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:background="?selectableItemBackground">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/current_location_icon"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:srcCompat="@drawable/current_location" />

                                <TextView
                                    android:id="@+id/current_location"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/primary_text"
                                    android:textSize="14sp"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toEndOf="@id/current_location_icon"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    android:layout_marginStart="16dp"
                                    android:gravity="start"
                                    android:textAlignment="viewStart"
                                    android:textStyle="bold"/>

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/add_address_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardPreventCornerOverlap="true"
                            app:cardUseCompatPadding="true"
                            app:cardCornerRadius="5dp"
                            app:cardBackgroundColor="@color/white"
                            app:strokeWidth="1dp"
                            app:strokeColor="#BEBEBE"
                            app:layout_constraintTop_toBottomOf="@+id/current_location_container">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:background="?selectableItemBackground">

                                <androidx.appcompat.widget.AppCompatImageView
                                    android:id="@+id/add_address_icon"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:srcCompat="@drawable/map_view"
                                    android:tint="?attr/colorPrimary"/>

                                <TextView
                                    android:id="@+id/add_address"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/primary_text"
                                    android:textSize="14sp"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintStart_toEndOf="@id/add_address_icon"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    android:layout_marginStart="16dp"
                                    android:gravity="start"
                                    android:textAlignment="viewStart"
                                    android:textStyle="bold"
                                    android:text="Add Address"/>

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/home_addresses_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary_text"
                            android:textSize="14sp"
                            app:layout_constraintTop_toBottomOf="@+id/add_address_container"
                            app:layout_constraintStart_toStartOf="parent"
                            android:layout_marginTop="8dp"
                            android:gravity="start"
                            android:textAlignment="viewStart"
                            android:text="Home"
                            android:textStyle="bold"
                            android:visibility="gone"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/home_addresses_recycler_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusableInTouchMode="false"
                            android:descendantFocusability="blocksDescendants"
                            app:layout_constraintTop_toBottomOf="@+id/home_addresses_label"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/work_addresses_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary_text"
                            android:textSize="14sp"
                            app:layout_constraintTop_toBottomOf="@+id/home_addresses_recycler_view"
                            app:layout_constraintStart_toStartOf="parent"
                            android:layout_marginTop="8dp"
                            android:gravity="start"
                            android:textAlignment="viewStart"
                            android:text="Work"
                            android:textStyle="bold"
                            android:visibility="gone"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/work_addresses_recycler_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusableInTouchMode="false"
                            android:descendantFocusability="blocksDescendants"
                            app:layout_constraintTop_toBottomOf="@+id/work_addresses_label"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/other_addresses_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary_text"
                            android:textSize="14sp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintTop_toBottomOf="@+id/work_addresses_recycler_view"
                            app:layout_constraintStart_toStartOf="parent"
                            android:gravity="start"
                            android:textAlignment="viewStart"
                            android:text="Other"
                            android:textStyle="bold"
                            android:visibility="gone"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/other_addresses_recycler_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusableInTouchMode="false"
                            android:descendantFocusability="blocksDescendants"
                            app:layout_constraintTop_toBottomOf="@+id/other_addresses_label"
                            android:visibility="gone"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.core.widget.NestedScrollView>

                <!--<androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/store_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginBottom="16dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:visibility="gone">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/store_details_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_store_details"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginTop="12dp"
                        android:layout_marginStart="32dp"
                        android:layout_marginEnd="32dp">

                        <include layout="@layout/item_store" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/store_select"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_store_select"
                        app:layout_constraintTop_toBottomOf="@id/store_details_container"
                        android:layout_marginStart="32dp"
                        android:layout_marginEnd="32dp"
                        android:gravity="center"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:textSize="14sp"
                        android:textColor="@color/white"
                        android:text="Select this branch"/>

                    <RelativeLayout
                        android:id="@+id/store_close"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/background_store_close"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginEnd="40dp"
                        android:focusable="true"
                        android:clickable="true">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            app:srcCompat="@drawable/close"
                            android:layout_centerInParent="true"/>

                    </RelativeLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>-->

                <TextView
                    android:id="@+id/addresses_continue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:text="Continue"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:background="?attr/colorPrimary"
                    android:visibility="gone"/>

                <!--<LinearLayout
                    android:id="@+id/map_list_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/background_map_list"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:id="@+id/map_view"
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/map_view"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconTint="@color/map_list"
                        app:backgroundTint="@android:color/transparent"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:textColor="@color/map_list"
                        android:text="Map view"/>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_vertical"
                        android:background="#CCCCCC"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"/>

                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        android:id="@+id/list_view"
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/list_view"
                        app:iconGravity="textStart"
                        app:iconSize="18dp"
                        app:iconTint="@color/map_list"
                        app:backgroundTint="@android:color/transparent"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:textColor="@color/map_list"
                        android:text="List view"/>

                </LinearLayout>-->

                <RelativeLayout
                    android:id="@+id/delivery_location"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/background_location"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="16dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:visibility="gone">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/current_location"
                        app:tint="@color/white"
                        android:layout_centerInParent="true"/>

                </RelativeLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/search_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardPreventCornerOverlap="true"
                    app:cardUseCompatPadding="true"
                    app:cardCornerRadius="5dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#CCCCCC"
                    app:layout_constraintBottom_toTopOf="@+id/confirm_location"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="invisible">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp">

                        <!--<EditText
                            android:id="@+id/search"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:hint="Type delivery location"
                            android:drawableEnd="@drawable/search"
                            android:drawablePadding="16dp"
                            android:textSize="14sp"
                            android:textColor="@color/primary_text"
                            android:background="@android:color/transparent"
                            android:inputType="text"
                            android:maxLines="1"
                            android:lines="1"
                            android:singleLine="true"
                            android:imeOptions="actionDone"
                            android:dropDownHeight="200dp"/>
    -->
                        <AutoCompleteTextView
                            android:id="@+id/search"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/search_icon"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:textSize="14sp"
                            android:textColor="@color/primary_text"
                            android:background="@android:color/transparent"
                            android:inputType="text"
                            android:maxLines="1"
                            android:lines="1"
                            android:singleLine="true"
                            android:imeOptions="actionDone"
                            android:dropDownAnchor="@+id/search_container"
                            android:dropDownHeight="200dp"
                            android:enabled="false"/>

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/search_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            app:srcCompat="@drawable/search"
                            android:scaleType="centerInside"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:visibility="invisible"/>

                        <androidx.appcompat.widget.AppCompatImageButton
                            android:id="@+id/clear"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:scaleType="centerInside"
                            android:background="?selectableItemBackground"
                            app:srcCompat="@drawable/close"
                            android:layout_centerInParent="true"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:visibility="gone"/>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:id="@+id/confirm_location"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_marginBottom="16dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:text="Confirm location"
                    app:cornerRadius="5dp"
                    app:backgroundTint="?attr/colorPrimary"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:visibility="invisible"/>

                <ImageView
                    android:id="@+id/marker"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:src="@drawable/marker_map"
                    android:scaleType="centerInside"
                    android:layout_marginBottom="36dp"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </fragment>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="200dp"
            android:background="@drawable/background_order_type_pickup">

            <RelativeLayout
                android:id="@+id/drag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/drag"
                    android:layout_centerInParent="true"/>

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@+id/drag"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginTop="8dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/stores_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_alignParentTop="true"/>

            </RelativeLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.sothree.slidinguppanel.SlidingUpPanelLayout>

    <TextView
        android:id="@+id/stores_continue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:text="Continue"
        android:gravity="center"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:background="?attr/colorPrimary"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>
