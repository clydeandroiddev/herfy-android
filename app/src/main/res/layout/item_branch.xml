<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:background="?selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="16dp"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:textAlignment="viewStart"
            android:textSize="16sp"
            android:textColor="@color/primary_text"
            android:textStyle="bold"
            android:text="Branch name"
            android:maxWidth="190dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginEnd="16dp"/>

        <!--<androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:textSize="16sp"
                android:textColor="@color/primary_text"
                android:textStyle="bold"
                android:text="Branch name"
                android:maxWidth="190dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginEnd="16dp"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/open_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="centerInside"
                android:background="@drawable/background_store_open"
                app:srcCompat="@drawable/store_open"
                app:layout_constraintStart_toEndOf="@+id/name"
                app:layout_constraintTop_toTopOf="@id/name"
                android:layout_marginStart="8dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>-->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/distance_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/store_distance"
                app:layout_constraintEnd_toStartOf="@+id/distance"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textAlignment="viewEnd"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/distance_icon"
                app:layout_constraintBottom_toBottomOf="@+id/distance_icon"
                android:textStyle="bold"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/details_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/header">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/telephone_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/store_telephone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/telephone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textAlignment="viewStart"
            android:textSize="12sp"
            android:textColor="?attr/colorPrimary"
            android:text="92 00 22 993"
            app:layout_constraintTop_toTopOf="@+id/telephone_icon"
            app:layout_constraintBottom_toBottomOf="@+id/telephone_icon"
            app:layout_constraintStart_toEndOf="@+id/telephone_icon"
            android:layout_marginEnd="16dp"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/hours_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/store_hours"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/telephone_icon"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/hours"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textAlignment="viewStart"
            android:textSize="12sp"
            android:textColor="@color/primary_text"
            android:text="06:00 AM - 08:30 PM"
            app:layout_constraintTop_toTopOf="@id/hours_icon"
            app:layout_constraintBottom_toBottomOf="@+id/hours_icon"
            app:layout_constraintStart_toEndOf="@+id/hours_icon"
            app:layout_constraintEnd_toStartOf="@+id/open_now_icon"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/open_now"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textAlignment="viewEnd"
            android:textSize="12sp"
            android:textColor="#4AE273"
            android:textStyle="bold"
            android:text="Open now"
            app:layout_constraintTop_toTopOf="@id/hours_icon"
            app:layout_constraintBottom_toBottomOf="@+id/hours_icon"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/open_now_icon"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/store_open_now"
            app:layout_constraintEnd_toStartOf="@id/open_now"
            app:layout_constraintTop_toTopOf="@id/open_now"
            app:layout_constraintBottom_toBottomOf="@id/open_now"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="8dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/show_facility"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/details_container"
        android:layout_marginTop="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:focusable="true"
        android:clickable="true"
        android:background="@drawable/background_order_type_store_facility"
        android:text="Show facility"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/facilities"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/show_facility"
        android:visibility="gone" />

    <View
        android:id="@+id/border"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E6E6E6"
        android:visibility="gone"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/facilities" />

</androidx.constraintlayout.widget.ConstraintLayout>

