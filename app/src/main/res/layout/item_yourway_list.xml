    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/additionsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <TextView
            android:id="@+id/nameAddition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/cairo_bold"
            android:includeFontPadding="false"
            android:paddingTop="5dp"
            android:textColor="@color/primary_text"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Additions" />

        <TextView
            android:id="@+id/selectAddition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/cairo_regular"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/nameAddition"
            app:layout_constraintStart_toEndOf="@id/nameAddition"
            tools:text="Your way" />

        <TextView
            android:id="@+id/minimum_maximum_addition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/cairo_regular"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@id/selectAddition"
            app:layout_constraintStart_toEndOf="@id/selectAddition"
            tools:text="Your way" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewAddition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:layoutDirection="locale"
            android:nestedScrollingEnabled="false"
            android:paddingTop="2dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@id/nameAddition"
            tools:itemCount="3"
            tools:listitem="@layout/item_additions" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/combosModifiersList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:layoutDirection="locale"
        android:nestedScrollingEnabled="false"
        android:paddingTop="10dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/additionsLayout"
        tools:itemCount="1"
        tools:listitem="@layout/item_new_modifier_items"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>