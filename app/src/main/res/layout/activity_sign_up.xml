<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".auth.views.SignUpActivity"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <include
        android:id="@+id/navigation"
        layout="@layout/navigation"
        app:layout_constraintTop_toTopOf="parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/navigation"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textColor="@color/primary_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_margin="16dp"
                android:text="Sign Up now"/>

            <TextView
                android:id="@+id/personal_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/primary_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/message"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:text="Personal info"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/first_name_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@+id/personal_info"
                app:cardCornerRadius="5dp"
                app:strokeWidth="0.4dp"
                app:strokeColor="@color/input_border"
                app:cardBackgroundColor="@color/input_background">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/first_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:background="@android:color/transparent"
                        android:singleLine="true"
                        android:inputType="textPersonName|textCapWords"
                        android:digits="ABCDEFGHIJKLMNOPQRSTUVWQYZabcdefghijklmnopqrstuvwxyz "
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@+id/last_name"
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textAlignment="viewStart"
                        android:gravity="start"
                        android:hint="Enter First name"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/first_name_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@+id/first_name_container"
                app:layout_constraintTop_toBottomOf="@+id/first_name_container"
                android:textSize="12sp"
                android:textColor="#DB3434"
                android:textAlignment="viewStart"
                android:gravity="start"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/last_name_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@+id/first_name_error"
                app:cardCornerRadius="5dp"
                app:strokeWidth="0.4dp"
                app:strokeColor="@color/input_border"
                app:cardBackgroundColor="@color/input_background">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/last_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:singleLine="true"
                        android:inputType="textPersonName|textCapWords"
                        android:digits="ABCDEFGHIJKLMNOPQRSTUVWQYZabcdefghijklmnopqrstuvwxyz "
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@+id/phone_number"
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textAlignment="viewStart"
                        android:gravity="start"
                        android:hint="Enter Last name"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/last_name_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@+id/last_name_container"
                app:layout_constraintTop_toBottomOf="@+id/last_name_container"
                android:textSize="12sp"
                android:textColor="#DB3434"
                android:textAlignment="viewStart"
                android:gravity="start"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/phone_number_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@+id/last_name_error"
                app:cardCornerRadius="5dp"
                app:strokeWidth="0.4dp"
                app:strokeColor="@color/input_border"
                app:cardBackgroundColor="@color/input_background">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp"
                    android:layoutDirection="ltr">

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_marginStart="2dp"
                        android:includeFontPadding="false"
                        android:visibility="visible"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="8dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <androidx.appcompat.widget.AppCompatSpinner
                            android:id="@+id/phone_number_prefix"
                            android:layout_width="70dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/spinner_background"
                            android:dropDownWidth="70dp"
                            android:paddingStart="0dp"
                            android:dropDownVerticalOffset="40dp"
                            android:gravity="center"
                            android:fontFamily="@font/cairo_bold"
                            android:textAlignment="center"
                            android:layoutDirection="ltr"
                            android:textColor="#2F2F2F"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </androidx.cardview.widget.CardView>

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phone_number"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/cairo_semibold"
                        android:background="@android:color/transparent"
                        android:gravity="center"
                        android:inputType="phone"
                        android:digits="0123456789٠١٢٣٤٥٦٧٨٩"
                        android:maxLength="13"
                        android:maxLines="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:singleLine="true"
                        android:textColor="@color/primary_text"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@+id/email"
                        android:layout_marginStart="32dp"
                        android:layout_marginEnd="32dp"
                        android:includeFontPadding="false"
                        android:layoutDirection="ltr"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/phone_number_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@+id/phone_number_container"
                app:layout_constraintTop_toBottomOf="@+id/phone_number_container"
                android:textSize="12sp"
                android:textColor="#DB3434"
                android:textAlignment="viewStart"
                android:gravity="start"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/email_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@+id/phone_number_error"
                app:cardCornerRadius="5dp"
                app:strokeWidth="0.4dp"
                app:strokeColor="@color/input_border"
                app:cardBackgroundColor="@color/input_background">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:inputType="textEmailAddress"
                        android:imeOptions="actionNext"
                        android:nextFocusForward="@+id/password"
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textAlignment="viewStart"
                        android:gravity="start"
                        android:hint="Enter Email"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/email_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@+id/email_container"
                app:layout_constraintTop_toBottomOf="@+id/email_container"
                android:textSize="12sp"
                android:textColor="#DB3434"
                android:textAlignment="viewStart"
                android:gravity="start"
                android:visibility="gone" />

            <TextView
                android:id="@+id/password_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/primary_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/email_error"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:text="Password"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/password_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@+id/password_label"
                app:cardCornerRadius="5dp"
                app:strokeWidth="0.4dp"
                app:strokeColor="@color/input_border"
                app:cardBackgroundColor="@color/input_background">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:inputType="textPassword"
                        android:imeOptions="actionNext"
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textAlignment="viewStart"
                        android:gravity="start"
                        android:hint="Enter password"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/password_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@+id/password_container"
                app:layout_constraintTop_toBottomOf="@+id/password_container"
                android:textSize="12sp"
                android:textColor="#DB3434"
                android:textAlignment="viewStart"
                android:gravity="start"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/repeat_password_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toBottomOf="@+id/password_error"
                app:cardCornerRadius="5dp"
                app:strokeWidth="0.4dp"
                app:strokeColor="@color/input_border"
                app:cardBackgroundColor="@color/input_background">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/repeat_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone"
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textAlignment="viewStart"
                        android:gravity="start"
                        android:hint="Repeat Password"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/repeat_password_error"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="@+id/repeat_password_container"
                app:layout_constraintTop_toBottomOf="@+id/repeat_password_container"
                android:textSize="12sp"
                android:textColor="#DB3434"
                android:textAlignment="viewStart"
                android:gravity="start"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:id="@+id/sign_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/repeat_password_error"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="24dp"
                android:padding="16dp"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:cornerRadius="5dp"
                android:textColor="@color/white"
                app:backgroundTint="?attr/colorPrimary"
                android:gravity="center"
                android:text="Sign Up"/>

            <TextView
                android:id="@+id/or_guest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/primary_text"
                android:layout_marginTop="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sign_up"
                android:text="Or"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/input_border"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/or_guest"
                app:layout_constraintTop_toTopOf="@+id/or_guest"
                app:layout_constraintBottom_toBottomOf="@+id/or_guest"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/input_border"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/or_guest"
                app:layout_constraintTop_toTopOf="@+id/or_guest"
                app:layout_constraintBottom_toBottomOf="@+id/or_guest"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/guest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/or_guest"
                android:layout_marginTop="24dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:cornerRadius="5dp"
                app:strokeWidth="2dp"
                app:strokeColor="#AAAAAA"
                android:textColor="@color/white"
                app:backgroundTint="#AAAAAA"
                android:gravity="center"
                android:text="Continue as Guest"/>

            <TextView
                android:id="@+id/or_social"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/primary_text"
                android:layout_marginTop="32dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/guest"
                android:text="Or"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/input_border"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/or_social"
                app:layout_constraintTop_toTopOf="@+id/or_social"
                app:layout_constraintBottom_toBottomOf="@+id/or_social"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/input_border"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/or_social"
                app:layout_constraintTop_toTopOf="@+id/or_social"
                app:layout_constraintBottom_toBottomOf="@+id/or_social"/>

            <TextView
                android:id="@+id/social"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/primary_text"
                android:layout_marginTop="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/or_social"
                android:text="Sign in using social account"/>

            <LinearLayout
                android:id="@+id/social_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/social">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/facebook_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:background="?selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:visibility="gone">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/facebook_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/facebook"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/facebook_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#3B5998"
                        android:text="Facebook"
                        android:layout_marginTop="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/facebook_icon" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/google_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="?selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/google_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/google"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                        android:id="@+id/google_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#EA4335"
                        android:text="Google"
                        android:layout_marginTop="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/google_icon" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

            <View
                android:id="@+id/bottom"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/input_border"
                app:layout_constraintTop_toBottomOf="@+id/social_container"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@+id/bottom">

                <TextView
                    android:id="@+id/account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/primary_text"
                    android:text="Already have an account?"/>

                <TextView
                    android:id="@+id/sign_in"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="?attr/colorPrimary"
                    android:layout_marginStart="8dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:background="?selectableItemBackground"
                    android:text="Sign In"/>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>