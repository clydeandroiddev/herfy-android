<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/modifierLabel"
        android:layout_width="0dp"
        android:layout_marginStart="8dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/cairo_regular"
        android:includeFontPadding="false"
        android:lineSpacingExtra="-7dp"
        android:maxLines="2"
        android:textAlignment="viewStart"
        android:textColor="@color/dusty_gray"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@+id/txtModifiersprice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Option 1 Regular" />

    <TextView
        android:id="@+id/txtModifiersprice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/cairo_semibold"
        android:includeFontPadding="false"
        android:textAllCaps="true"
        android:textColor="@color/dusty_gray"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/modifierLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/modifierLabel"
        tools:text="40.00 SR" />
</androidx.constraintlayout.widget.ConstraintLayout>