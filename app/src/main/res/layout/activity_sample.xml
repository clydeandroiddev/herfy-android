<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/main_new_sampe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:orientation="vertical"
        tools:ignore="MissingDefaultResource">

        <com.herfy.utils.widgets.otp.OTPTextView
            android:id="@+id/otp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#55667B"
            app:box_margin="4dp"
            app:box_margin_horizontal="16dp"
            app:height="43dp"
            app:hide_otp="false"
            app:hide_otp_drawable="@drawable/background_edit_field"
            app:length="8"
            app:otp_box_background="@drawable/background_edit_field"
            app:otp_box_background_active="@drawable/background_edit_field"
            app:otp_box_background_error="@drawable/background_edit_field"
            app:otp_box_background_inactive="@drawable/background_edit_field"
            app:otp_box_background_success="@drawable/background_edit_field"
            app:otp_text_size="14sp" />

    </LinearLayout>

</layout>