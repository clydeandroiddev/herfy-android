<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">


    <FrameLayout
        android:id="@+id/item_maker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/item_maker_constraint"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/background_header_order_type"
            android:scaleType="centerInside"
            app:backgroundTint="@color/white"
            app:elevation="4dp"
            app:fabCustomSize="40dp"
            app:tint="#DEDEDE" />

    </FrameLayout>

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/color_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:layout_margin="5dp"
        app:layout_constraintBottom_toBottomOf="@id/item_maker"
        app:layout_constraintEnd_toEndOf="@id/item_maker"
        app:layout_constraintStart_toStartOf="@id/item_maker"
        app:layout_constraintTop_toTopOf="@id/item_maker"
        tools:src="@color/white" />

    <LinearLayout
        android:id="@+id/other_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/item_maker"
        app:layout_constraintEnd_toEndOf="@id/item_maker"
        app:layout_constraintStart_toStartOf="@id/item_maker"
        app:layout_constraintTop_toTopOf="@id/item_maker"
        tools:visibility="visible">

        <TextView
            android:id="@+id/other_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/cairo_bold"
            android:textColor="#5F5F5F"
            android:textSize="9sp"
            tools:text="Other" />

        <ImageView
            android:layout_width="6dp"
            android:layout_height="3dp"
            android:layout_marginStart="2dp"
            android:layout_marginTop="1dp"
            android:src="@drawable/ic_union_small" />

    </LinearLayout>


    <View
        android:layout_width="4dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@id/item_maker"
        app:layout_constraintStart_toEndOf="@id/item_maker"
        app:layout_constraintTop_toTopOf="@id/item_maker" />

    <View
        android:layout_width="0dp"
        android:layout_height="4dp"
        app:layout_constraintEnd_toEndOf="@id/item_maker"
        app:layout_constraintStart_toStartOf="@id/item_maker"
        app:layout_constraintTop_toBottomOf="@id/item_maker" />


</androidx.constraintlayout.widget.ConstraintLayout>