<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginBottom="@dimen/margin_large"
    app:strokeColor="#D9E8F3"
    app:strokeWidth="1dp"
    app:cardPreventCornerOverlap="false"
    app:cardCornerRadius="16dp"
    app:contentPadding="10dp"
    android:id="@+id/optionCardView"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:id="@+id/clickable_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!--    <FrameLayout-->
        <!--        android:id="@+id/check_layout"-->
        <!--        android:layout_width="46dp"-->
        <!--        android:layout_height="46dp"-->
        <!--        android:background="?attr/selectableItemBackgroundBorderless">-->

        <!--        <ImageView-->
        <!--            android:id="@+id/checkBox"-->
        <!--            android:layout_width="20dp"-->
        <!--            android:layout_height="20dp"-->
        <!--            android:visibility="gone"-->
        <!--            tools:visibility="visible"-->
        <!--            android:layout_gravity="center"-->
        <!--            android:src="@drawable/item_drawable_checked_state" />-->
        <!--        <ImageView-->
        <!--            android:id="@+id/radioButton"-->
        <!--            android:layout_width="20dp"-->
        <!--            android:layout_height="20dp"-->
        <!--            android:visibility="gone"-->
        <!--            android:layout_gravity="center"-->
        <!--            android:button="@drawable/item_drawable_radio_state"/>-->
        <!--    </FrameLayout>-->

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/modifierImage"
            android:layout_width="134dp"
            android:layout_height="134dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            tools:src = "@tools:sample/avatars"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApp.Image.Corner12dp"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/txtCalories"
                android:layout_width="0dp"
                android:visibility="gone"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_fire"
                style="@style/TextAppearance.Caption"
                android:fontFamily="@font/inter_regular"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/txtModifierItemName"
                android:layout_marginStart="@dimen/margin_large"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginTop="@dimen/margin_large"
                android:layout_gravity="center_vertical"
                android:drawablePadding="@dimen/padding_micro"
                android:gravity="start|center_vertical"
                android:paddingEnd="4dp"
                tools:visibility="visible"
                android:textAlignment="viewStart"
                android:textColor="#0C0C0C"
                tools:text="2000 Kcal" />

            <ImageView
                android:id="@+id/icFavorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="visible"
                android:layout_marginStart="@dimen/margin_large"
                android:src="@drawable/ic_frequent_favourites"
                android:layout_marginEnd="@dimen/margin_small"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/txtModifierItemName"
                style="@style/Styles.Text.Footnote.Semi.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_bold"
                android:paddingEnd="4dp"
                android:textAlignment="viewEnd"
                android:textColor="#0C0C0C"
                app:layout_constraintStart_toStartOf="@+id/txtmodifierPrice"
                app:layout_constraintTop_toBottomOf="@+id/txtCalories"
                tools:text="Marinara dip" />

            <TextView
                android:id="@+id/modifierDescription"
                style="@style/Styles.Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_14sdp"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="@dimen/margin_small"
                android:ellipsize="end"
                android:fontFamily="@font/inter_regular"
                android:gravity="start|center_vertical"
                android:textAlignment="viewStart"
                android:textColor="#1e1e1e"
                app:layout_constraintEnd_toEndOf="@+id/txtModifierItemName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtModifierItemName"
                tools:text="Dive into a flavor-packed adventure with our New Triple Herfy!" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/txtmodifierPrice"
                style="@style/Styles.Text.Footnote_Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_large"
                android:layout_marginBottom="@dimen/margin_xlarge"
                android:textColor="@color/text_color_blue"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="@+id/modifierDescription"
                app:layout_constraintTop_toBottomOf="@+id/modifierDescription"
                tools:text="+Sar 2" />

            <ImageButton
                android:id="@+id/quantityDown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/margin_micro"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/quantity_up_blue"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/txtmodifierPrice" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>