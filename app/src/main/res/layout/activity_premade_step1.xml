<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mercury">

    <include
        android:id="@+id/toolbar"
        layout="@layout/header_subscription_activity" />

    <com.sothree.slidinguppanel.SlidingUpPanelLayout
        android:id="@+id/sliding_panel_main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:umanoAnchorPoint="0.7"
        app:umanoDragView="@+id/drag"
        app:umanoFadeColor="@android:color/transparent"
        app:umanoOverlay="true"
        app:umanoPanelHeight="0dp"
        app:umanoScrollableView="@+id/recycler_view"
        app:umanoShadowHeight="0dp">

        <FrameLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include layout="@layout/premade_step1_main_content" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="-8dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="8dp"
                app:cardElevation="8dp">

                <include layout="@layout/premade_step1_sliding_panel" />

            </androidx.cardview.widget.CardView>

        </FrameLayout>

    </com.sothree.slidinguppanel.SlidingUpPanelLayout>

    <LinearLayout
        android:id="@+id/bottom_sliding_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        android:visibility="gone"
        android:weightSum="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/cancel_button"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/background_primary_eight_dp"
            android:fontFamily="@font/cairo_bold"
            android:gravity="center"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            tools:text="CANCEL" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/confirm_button"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:alpha="0.9"
            android:background="@drawable/background_primary_eight_dp"
            android:fontFamily="@font/cairo_bold"
            android:gravity="center"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            tools:text="CONFIRM" />


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>