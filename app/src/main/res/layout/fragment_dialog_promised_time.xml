<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="307dp"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_bold"
                android:gravity="center"
                android:paddingTop="5dp"
                android:paddingBottom="2dp"
                android:textAllCaps="true"
                android:textColor="?attr/colorPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <ImageButton
                android:id="@+id/buttonClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="10dp"
                android:background="?attr/selectableItemBackground"
                android:src="@drawable/promised_time_close"
                app:layout_constraintBottom_toBottomOf="@id/title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/title" />

            <ImageView
                android:id="@+id/staticMap"
                android:layout_width="match_parent"
                android:layout_height="181dp"
                android:layout_marginTop="2dp"
                android:src="@color/placeholder_color"
                app:layout_constraintTop_toBottomOf="@id/title" />

            <ImageView
                android:id="@+id/rectangleIcon"
                android:layout_width="45dp"
                android:layout_height="33dp"
                android:layout_marginTop="53dp"
                android:src="@drawable/ic_rectangle"
                app:layout_constraintEnd_toEndOf="@id/markerCenter"
                app:layout_constraintStart_toStartOf="@id/markerCenter"
                app:layout_constraintTop_toTopOf="@id/staticMap" />

            <ImageView
                android:id="@+id/markerCenter"
                android:layout_width="35dp"
                android:layout_height="41dp"
                android:layout_marginTop="52dp"
                android:src="@drawable/ic_marker"
                app:layout_constraintEnd_toEndOf="@id/staticMap"
                app:layout_constraintStart_toStartOf="@id/staticMap"
                app:layout_constraintTop_toTopOf="@id/staticMap" />

            <ImageView
                android:id="@+id/homeIcon"
                android:layout_width="17dp"
                android:layout_height="18dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/home_icon"
                app:layout_constraintEnd_toEndOf="@id/markerCenter"
                app:layout_constraintStart_toStartOf="@id/markerCenter"
                app:layout_constraintTop_toTopOf="@id/markerCenter" />

            <ImageView
                android:id="@+id/branchImage"
                android:layout_width="41dp"
                android:layout_height="31dp"
                android:layout_marginStart="2dp"
                android:layout_marginTop="54dp"
                android:layout_marginEnd="2dp"
                app:layout_constraintEnd_toEndOf="@id/rectangleIcon"
                app:layout_constraintStart_toStartOf="@id/rectangleIcon"
                app:layout_constraintTop_toTopOf="@id/staticMap" />

            <LinearLayout
                android:id="@+id/minutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:layoutDirection="locale"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/staticMap">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/labelReady"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/cairo_light"
                    android:gravity="center"
                    android:textColor="#1E1E1E"
                    app:layout_constraintTop_toBottomOf="@id/staticMap"
                    tools:text="Your order will be ready in" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/mins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:fontFamily="@font/cairo_bold"
                    android:gravity="center"
                    android:textColor="#1E1E1E"
                    app:layout_constraintStart_toEndOf="@id/labelReady"
                    app:layout_constraintTop_toBottomOf="@id/labelReady"
                    tools:text="15 mins" />

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/branchDetailsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="19dp"
                android:layout_marginEnd="15dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:cardPreventCornerOverlap="true"
                app:cardUseCompatPadding="true"
                app:layout_constraintTop_toTopOf="@id/minutes">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:fontFamily="@font/cairo_bold"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:textAllCaps="true"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="PICKUP FROM" />

                    <TextView
                        android:id="@+id/address"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="23dp"
                        android:layout_marginEnd="16dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/cairo_regular"
                        android:gravity="start"
                        android:lineSpacingExtra="-8dp"
                        android:maxLines="2"
                        android:paddingBottom="6dp"
                        android:textColor="@color/black"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/type"
                        tools:text="Riyadh Branch Saudi Arabia | The quick brown fox jumps over the head of the lazy dog" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_change"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/cairo_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textAlignment="center"
                android:textAllCaps="true"
                app:barrierMargin="0dp"
                android:layout_marginTop="-3dp"
                android:textColor="?attr/colorPrimary"
                app:backgroundTint="@color/white"
                app:cornerRadius="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/confirm"
                app:layout_constraintTop_toBottomOf="@id/branchDetailsLayout"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="@id/branchDetailsLayout"
                app:strokeColor="?attr/colorPrimary"
                app:strokeWidth="2dp"
                tools:text="CHANGE" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="3dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/background_primary_eight_dp"
                android:fontFamily="@font/cairo_bold"
                android:gravity="center"
                android:paddingStart="5dp"
                android:paddingTop="0dp"
                android:paddingEnd="5dp"
                android:paddingBottom="0dp"
                android:textAllCaps="true"
                android:textColor="@color/white"
                app:layout_constraintEnd_toEndOf="@id/branchDetailsLayout"
                app:layout_constraintStart_toEndOf="@+id/btn_change"
                app:layout_constraintTop_toBottomOf="@id/branchDetailsLayout"
                tools:text="CONFIRM" />

            <View
                android:layout_width="match_parent"
                android:layout_height="15dp"
                app:layout_constraintTop_toBottomOf="@id/confirm" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>