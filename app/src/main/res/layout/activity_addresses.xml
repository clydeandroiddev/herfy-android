<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context="com.herfy.addresses.views.AddressesActivity" >

    <include
        android:id="@+id/navigation"
        layout="@layout/navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/search_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/search_container"
        app:layout_constraintBottom_toBottomOf="@+id/search_container"
        app:srcCompat="@drawable/search"
        android:layout_marginStart="16dp"
        android:visibility="gone"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false"
        app:cardCornerRadius="5dp"
        app:strokeWidth="1dp"
        app:strokeColor="#CCCCCC"
        app:layout_constraintStart_toEndOf="@+id/search_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigation"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">

            <EditText
                android:id="@+id/search"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/clear"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:textCursorDrawable="@null"
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:background="@android:color/transparent"
                android:maxLines="1"
                android:imeOptions="actionDone"
                android:layout_marginEnd="16dp"
                android:enabled="false"/>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/clear"
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:srcCompat="@drawable/close"
                android:background="?selectableItemBackground"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:visibility="gone"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/search_container"
        app:layout_constraintBottom_toTopOf="@+id/addresses_continue"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/searched_places_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:text="Searched places"
                android:textStyle="bold"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/searched_places_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusableInTouchMode="false"
                android:descendantFocusability="blocksDescendants"
                app:layout_constraintTop_toBottomOf="@+id/searched_places_label"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/current_location_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@+id/searched_places_recycler_view"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:text="Current Location"
                android:textStyle="bold"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/current_location_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardPreventCornerOverlap="true"
                app:cardUseCompatPadding="true"
                app:cardCornerRadius="5dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="1dp"
                app:strokeColor="#BEBEBE"
                app:layout_constraintTop_toBottomOf="@+id/current_location_label"
                android:visibility="gone">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:background="?selectableItemBackground">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/current_location_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:srcCompat="@drawable/current_location" />

                    <TextView
                        android:id="@+id/current_location"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_text"
                        android:textSize="14sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/current_location_icon"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginStart="16dp"
                        android:gravity="start"
                        android:textAlignment="viewStart"
                        android:textStyle="bold"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/add_address_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardPreventCornerOverlap="true"
                app:cardUseCompatPadding="true"
                app:cardCornerRadius="5dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="1dp"
                app:strokeColor="#BEBEBE"
                app:layout_constraintTop_toBottomOf="@+id/current_location_container">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:background="?selectableItemBackground">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/add_address_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:srcCompat="@drawable/map_view"
                        android:tint="?attr/colorPrimary"/>

                    <TextView
                        android:id="@+id/add_address"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textColor="@color/primary_text"
                        android:textSize="14sp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/add_address_icon"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginStart="16dp"
                        android:gravity="start"
                        android:textAlignment="viewStart"
                        android:textStyle="bold"
                        android:text="Add Address"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/home_addresses_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@+id/add_address_container"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:text="Home"
                android:textStyle="bold"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/home_addresses_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusableInTouchMode="false"
                android:descendantFocusability="blocksDescendants"
                app:layout_constraintTop_toBottomOf="@+id/home_addresses_label"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/work_addresses_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@+id/home_addresses_recycler_view"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:text="Work"
                android:textStyle="bold"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/work_addresses_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusableInTouchMode="false"
                android:descendantFocusability="blocksDescendants"
                app:layout_constraintTop_toBottomOf="@+id/work_addresses_label"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/other_addresses_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_text"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/work_addresses_recycler_view"
                app:layout_constraintStart_toStartOf="parent"
                android:gravity="start"
                android:textAlignment="viewStart"
                android:text="Other"
                android:textStyle="bold"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/other_addresses_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusableInTouchMode="false"
                android:descendantFocusability="blocksDescendants"
                app:layout_constraintTop_toBottomOf="@+id/other_addresses_label"
                android:visibility="gone"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <TextView
        android:id="@+id/addresses_continue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:text="Continue"
        android:gravity="center"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:background="?attr/colorPrimary"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>