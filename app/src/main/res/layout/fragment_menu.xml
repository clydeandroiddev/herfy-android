<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        app:elevation="0.1dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/order_type_search_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.cardview.widget.CardView
                android:id="@+id/order_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:cornerRadius="10dp"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardPreventCornerOverlap="true"
                app:cardUseCompatPadding="true"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/order_type_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:src="@drawable/order_type_pickup"/>

                    <TextView
                        android:id="@+id/order_type_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="200dp"
                        android:ellipsize="end"
                        android:text="Select order type"
                        android:textColor="@color/primary_text"
                        app:cornerRadius="10dp"
                        app:backgroundTint="?attr/colorPrimary"
                        android:gravity="center"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:lines="1"
                        app:layout_constraintStart_toEndOf="@+id/order_type_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_marginStart="8dp"/>

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/order_type_select"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        app:layout_constraintStart_toEndOf="@+id/order_type_label"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:srcCompat="@drawable/select_order_type"
                        android:layout_marginStart="8dp"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/search_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?selectableItemBackground"
                app:srcCompat="@drawable/search"
                android:tint="@color/black"
                app:layout_constraintTop_toTopOf="@+id/order_type"
                app:layout_constraintBottom_toBottomOf="@+id/order_type"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="16dp"/>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/search_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:cardPreventCornerOverlap="true"
                app:cardUseCompatPadding="true"
                app:cardCornerRadius="5dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#CCCCCC"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/close"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_margin="16dp"
                android:visibility="gone">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <EditText
                        android:id="@+id/search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:hint="Search here"
                        android:textCursorDrawable="@null"
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:background="@android:color/transparent"
                        android:maxLines="1"
                        android:inputType="text"
                        android:imeOptions="actionSearch"
                        android:dropDownHeight="200dp"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="@id/search_container"
                app:layout_constraintBottom_toBottomOf="@+id/search_container"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="16dp"
                android:background="?selectableItemBackground"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:textSize="12sp"
                android:text="Close"
                android:padding="8dp"
                android:visibility="gone"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/store_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/order_type_search_container"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="16dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/open_closed_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/store_open_close"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/open_closed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OPEN"
                android:textSize="10sp"
                android:textColor="#227D26"
                android:textStyle="bold"
                android:textAlignment="center"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="@+id/open_closed_icon"
                app:layout_constraintEnd_toEndOf="@+id/open_closed_icon"
                app:layout_constraintBottom_toBottomOf="@+id/open_closed_icon"
                android:layout_centerHorizontal="true"
                android:paddingBottom="2dp"/>


            <!--<RelativeLayout
                android:id="@+id/open_closed_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/open_closed_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/store_open_close"
                    android:layout_alignParentTop="true"/>

                <TextView
                    android:id="@+id/open_closed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OPEN"
                    android:textSize="8sp"
                    android:textColor="#227D26"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:gravity="center"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:paddingBottom="2dp"/>

            </RelativeLayout>-->

            <TextView
                android:id="@+id/store_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Open until 10:00 PM"
                android:textColor="@color/primary_text"
                android:textAlignment="viewStart"
                android:gravity="start"
                android:textSize="12sp"
                app:layout_constraintStart_toEndOf="@+id/open_closed_icon"
                app:layout_constraintTop_toTopOf="@+id/open_closed"
                app:layout_constraintBottom_toBottomOf="@+id/open_closed"
                android:layout_marginStart="8dp"
                android:paddingBottom="1dp"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/order_type_search_container"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp"
            android:textColor="@color/primary_text"
            android:textSize="20sp"
            android:text="What would you like to eat?"
            android:textAlignment="viewStart"
            android:gravity="start"
            android:visibility="gone"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/menu_categories_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="0dp"
        app:layout_constraintTop_toBottomOf="@+id/navigation"/>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/menu_categories_shimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="0dp"
        app:layout_constraintTop_toBottomOf="@+id/navigation"
        app:shimmer_duration="800">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <include layout="@layout/placeholder_menu_category" />
            <include layout="@layout/placeholder_menu_category" />
            <include layout="@layout/placeholder_menu_category" />
            <include layout="@layout/placeholder_menu_category" />
        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/menu_items_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/menu_categories_recycler_view"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/menu_items_shimmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toBottomOf="@+id/menu_categories_shimmer"
        app:shimmer_duration="800">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <include
                    android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:layout_weight="1"
                    layout="@layout/placeholder_menu_item" />
                <include
                    android:layout_width="0dp"
                    android:layout_height="200dp"
                    android:layout_weight="1"
                    layout="@layout/placeholder_menu_item" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <include
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    layout="@layout/placeholder_menu_item" />
                <include
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_weight="1"
                    layout="@layout/placeholder_menu_item" />
            </LinearLayout>

        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/menu_categories_recycler_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="12sp"
        android:visibility="gone"/>

</androidx.constraintlayout.widget.ConstraintLayout>