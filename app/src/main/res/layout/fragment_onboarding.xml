<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/main_layout"
    android:background="@color/page_background_color">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dynamic_image_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/dynamic_image_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/img_onboarding_fastfood_burger_1"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="@+id/dynamic_image_content"
            app:layout_constraintStart_toStartOf="@+id/dynamic_image_content"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/dynamic_image_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="fitCenter"
            android:src="@drawable/img_onboarding_fastfood_burger_2"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/dynamic_image_header" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:visibility="gone"
        tools:src="@drawable/img_burger_sample_feedback" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:ellipsize="end"
        android:fontFamily="@font/cairo_bold"
        android:gravity="start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="#171717"
        android:textSize="30sp"
        android:textStyle="bold"
        tools:text="Sample Title"
        tools:visibility="visible"/>

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:layout_marginTop="-10dp"
        android:ellipsize="end"
        android:fontFamily="@font/cairo_regular"
        android:gravity="start"
        android:includeFontPadding="false"
        android:lineSpacingExtra="-8dp"
        android:lines="2"
        android:maxLines="2"
        android:text="@string/please_pick_a_language_message_en"
        android:textAlignment="viewStart"
        android:textColor="#555555"
        android:textSize="18sp"
        tools:text="Sample laksjd asldkjf a;lskdjf ;laksjdf asdf ladf adsf h kahdsf"
        tools:visibility="visible"/>

</LinearLayout>