<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".language.LanguageActivity"
    android:background="@color/background">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginStart="37dp"
        android:layout_marginEnd="35dp"
        android:ellipsize="end"
        android:fontFamily="@font/cairo_bold"
        android:lineSpacingExtra="-7dp"
        android:maxLines="1"
        android:text="@string/please_pick_a_language_title_en"
        android:textColor="#171717"
        android:textSize="@dimen/title_text_size"
        android:textAlignment="viewStart"
        android:textStyle="bold"
        android:gravity="start"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toTopOf="@+id/message"
        android:visibility="invisible"/>

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="37dp"
        android:layout_marginEnd="35dp"
        android:layout_marginBottom="16dp"
        android:ellipsize="end"
        android:fontFamily="@font/cairo_regular"
        android:lineSpacingExtra="-10dp"
        android:maxLines="2"
        android:text="@string/please_pick_a_language_message_en"
        android:textColor="#555555"
        android:textSize="18sp"
        android:textAlignment="viewStart"
        android:gravity="start"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toTopOf="@id/arabic_card"
        android:visibility="invisible"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/arabic_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toTopOf="@+id/french_card"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        app:strokeWidth="2dp"
        app:strokeColor="@android:color/transparent"
        android:visibility="invisible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/arabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="?selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone">

            <TextView
                android:id="@+id/arabic_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="العربية"
                android:textStyle="bold"
                android:textColor="#171717"
                android:textSize="18sp"
                android:fontFamily="@font/cairo_bold" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/arabic_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="centerInside"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:srcCompat="@drawable/language_selected"
                android:visibility="gone"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/french_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toTopOf="@id/english_card"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        app:strokeWidth="2dp"
        app:strokeColor="@android:color/transparent"
        android:visibility="invisible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/french"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="?selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone">

            <TextView
                android:id="@+id/french_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="Français"
                android:textStyle="bold"
                android:textColor="#171717"
                android:textSize="18sp"
                android:fontFamily="@font/cairo_bold" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/french_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="centerInside"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:srcCompat="@drawable/language_selected"
                android:visibility="gone"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/english_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="10dp"
        app:strokeWidth="2dp"
        app:strokeColor="@android:color/transparent"
        android:visibility="invisible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/english"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="?selectableItemBackground"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone">

            <TextView
                android:id="@+id/english_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:text="English"
                android:textStyle="bold"
                android:textColor="#171717"
                android:textSize="18sp"
                android:fontFamily="@font/cairo_bold" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/english_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:scaleType="centerInside"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:srcCompat="@drawable/language_selected"
                android:visibility="gone"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>



    <com.google.android.material.button.MaterialButton
        android:id="@+id/proceed"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/cairo_black"
        android:gravity="center"
        android:text="@string/proceed_en"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:backgroundTint="?attr/colorPrimary"
        app:cornerRadius="8dp"
        android:visibility="invisible"/>

</androidx.constraintlayout.widget.ConstraintLayout>