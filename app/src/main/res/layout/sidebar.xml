<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:src="@drawable/background_side_bar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:rotation="@integer/rotation_degree"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginHorizontal="16dp">

        <ImageView
            android:id="@+id/concept"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:scaleType="centerInside"
            android:src="@drawable/logo_herfy"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <Spinner
            android:id="@+id/spinner_lang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/background_spinner"
            android:textSize="13sp"
            android:spinnerMode="dropdown"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:textAppearance="@style/TextAppearance.Footnote_Bold"
            android:textColor="@color/black"
            tools:listitem="@layout/item_language"
            android:clickable="false"
            android:focusable="false"
            style="@style/SpinnerTheme"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>


        <LinearLayout
            android:id="@+id/ln_customer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="40dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinner_lang">

            <TextView
                android:id="@+id/customer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="start"
                android:includeFontPadding="false"
                android:textAlignment="viewStart"
                android:textColor="@color/white"
                android:textSize="25sp"
                style="@style/Styles.Text.Title1"
                tools:text="Hi John Doe" />

            <androidx.emoji2.widget.EmojiTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textSize="20sp"
                android:textColor="@color/black"
                android:text="@string/side_menu_hi"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:layout_marginTop="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frame">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginHorizontal="16dp">

            <FrameLayout
                android:id="@+id/fm_signin"
                android:layout_width="match_parent"
                android:layout_height="60dp">

                <TextView
                    android:id="@+id/signin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:background="@drawable/background_get_started"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="Get Started With Herfy"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="20dp"
                    style="@style/Styles.Text.Caption"/>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha=".4"
                    android:background="@color/white"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="bottom"
                    />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/fm_account"
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_sidebar_user"
                    />

                <TextView
                    android:id="@+id/account"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="16dp"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:text="My Profile"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    style="@style/Styles.Text.Caption"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha=".4"
                    android:background="@color/white"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="bottom"
                    />
            </FrameLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clNotification"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_gravity="start"
                android:background="?selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="start"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imageView3"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_sidebar_notif"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivNewNotifIndicator"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/notification"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:text="Notifications"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    style="@style/Styles.Text.Body.Medium"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toEndOf="@id/ivNewNotifIndicator"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivNewNotifIndicator"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_notif_badge"
                    android:visibility="invisible"
                    app:layout_constraintBottom_toBottomOf="@+id/imageView3"
                    app:layout_constraintEnd_toStartOf="@id/notification"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toEndOf="@+id/imageView3"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:alpha=".4"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <FrameLayout
                android:id="@+id/fm_history"
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_sidebar_history"
                    />

                <TextView
                    android:id="@+id/history"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:text="Your Orders"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    style="@style/Styles.Text.Caption"/>

                <View
                    android:alpha=".4"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="bottom"/>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fm_loyalty"
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_sidebar_loyalty"
                    />

                <TextView
                    android:id="@+id/loyalty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:text="Loyalty &amp; Rewards"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    style="@style/Styles.Text.Caption"/>

                <View
                    android:alpha=".4"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="bottom"/>

            </FrameLayout>

            <FrameLayout
                android:id="@+id/fm_promotions"
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_sidebar_tag"
                    />

                <TextView
                    android:id="@+id/promotions"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:text="Promotions"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    style="@style/Styles.Text.Caption"/>

                <View
                    android:alpha=".4"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="bottom"/>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fm_favorites"
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_sidebar_favorites"
                    />

                <TextView
                    android:id="@+id/favorites"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:text="Favourites"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    style="@style/Styles.Text.Caption"/>

                <View
                    android:alpha=".4"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="bottom"
                    />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fm_refer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_sidebar_refer"
                    />

                <TextView
                    android:id="@+id/refer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:text="Refer &amp; Earn"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    style="@style/Styles.Text.Caption"/>
                <View
                    android:alpha=".4"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="bottom"
                    />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fm_store_locator"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_sidebar_store_locater"
                    />

                <TextView
                    android:id="@+id/store_locator"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:text="Store Locater"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    style="@style/Styles.Text.Caption"/>
                <View
                    android:alpha=".4"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="bottom"
                    />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fm_support"
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_sidebar_help"
                    />

                <TextView
                    android:id="@+id/support"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:text="Help &amp; Support"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    style="@style/Styles.Text.Caption"/>
                <View
                    android:alpha=".4"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="bottom"
                    />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fm_feedback"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_sidebar_help"
                    />

                <TextView
                    android:id="@+id/feedback"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:text="Help &amp; Support"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    style="@style/Styles.Text.Caption"/>
                <View
                    android:alpha=".4"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="bottom"
                    />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fm_active_subscription"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/active_subscription"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:text="Active Subscription"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    style="@style/Styles.Text.Caption"/>
                <View
                    android:alpha=".4"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="bottom"
                    />

            </FrameLayout>

            <FrameLayout
                android:id="@+id/liveChatLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?selectableItemBackground"
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    >

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"

                        android:src="@drawable/ic_whatsapp_filled" />

                    <TextView
                        android:layout_marginStart="10dp"
                        android:id="@+id/liveChat"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="Live Chat"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        style="@style/Styles.Text.Body.Medium"/>



                </LinearLayout>

                <View
                    android:alpha=".4"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:layout_gravity="bottom"
                    />


            </FrameLayout>

            <FrameLayout
                android:id="@+id/fm_brands"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/brands"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:text="Brands"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    style="@style/Styles.Text.Caption"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="bottom"
                    />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fm_faqs"
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_sidebar_faqs"
                    />

                <TextView
                    android:id="@+id/faqs"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:text="FAQs"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    style="@style/Styles.Text.Caption"/>

                <View
                    android:alpha=".4"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="bottom"
                    />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fm_about_us"
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_sidebar_about_us"
                    />

                <TextView
                    android:id="@+id/about_us"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:text="About Us"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    style="@style/Styles.Text.Caption"/>

                <View
                    android:alpha=".4"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="bottom"
                    />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/fm_terms"
                android:layout_width="match_parent"
                android:layout_height="56dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/ic_sidebar_terms"
                    />

                <TextView
                    android:id="@+id/terms"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="?selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="start|center_vertical"
                    android:includeFontPadding="false"
                    android:text="Terms &amp; Condition"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:layout_marginStart="16dp"
                    style="@style/Styles.Text.Caption"/>

                <View
                    android:alpha=".4"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/white"
                    android:layout_marginTop="6dp"
                    android:layout_gravity="bottom"
                    />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/selection_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quick_order_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardPreventCornerOverlap="true"
                    app:cardUseCompatPadding="true"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:id="@+id/quick_order"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/quick_order_icon"
                            android:layout_width="37dp"
                            android:layout_height="37dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/ic_cart"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/quick_order_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/cairo_bold"
                            android:gravity="start"
                            android:includeFontPadding="false"
                            android:text="Quick Order"
                            android:textAlignment="viewStart"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/subscriptions_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="4dp"
                    app:cardPreventCornerOverlap="true"
                    app:cardUseCompatPadding="true"
                    app:strokeColor="@android:color/transparent"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:id="@+id/subscriptions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/subscriptions_icon"
                            android:layout_width="37dp"
                            android:layout_height="37dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/subscriptions"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/subscriptions_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/cairo_bold"
                            android:gravity="start"
                            android:includeFontPadding="false"
                            android:text="Subscriptions"
                            android:textAlignment="viewStart"
                            android:textColor="#1E1E1E"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mediaIconLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:visibility="visible"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvReachUs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Styles.Text.Caption.Semibold"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Follow Us On Social Media"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_horizontal"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvReachUs">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_ig"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="@color/border_color_light"
                        app:strokeWidth="1dp"
                        android:layout_marginEnd="12dp"
                        android:visibility="visible"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/iv_ig"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/logo_ig"
                            android:layout_gravity="center"/>


                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_facebook"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="@color/border_color_light"
                        app:strokeWidth="1dp"
                        android:layout_marginEnd="12dp"
                        android:visibility="visible"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/iv_facebook"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/logo_fb"
                            android:visibility="visible"
                            android:layout_gravity="center"/>


                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_tiktok"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="@color/border_color_light"
                        app:strokeWidth="1dp"
                        android:layout_marginEnd="12dp"
                        android:visibility="visible"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/iv_tiktok"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/logo_tiktok"
                            android:layout_gravity="center"
                            />


                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_youtube"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="@color/border_color_light"
                        app:strokeWidth="1dp"
                        android:layout_marginEnd="12dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/iv_youtube"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/logo_yt"
                            android:visibility="visible"
                            tools:visibility="visible"
                            android:layout_gravity="center"/>


                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_web"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="@color/border_color_light"
                        app:strokeWidth="1dp"
                        android:layout_marginEnd="12dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/iv_web"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_web"
                            android:visibility="gone"
                            tools:visibility="visible"
                            android:layout_gravity="center"/>


                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_twitter"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="@color/border_color_light"
                        app:strokeWidth="1dp"
                        android:layout_marginEnd="12dp"
                        android:visibility="visible"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/iv_twitter"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/logo_twitter_x"
                            android:layout_gravity="center"
                            />


                    </com.google.android.material.card.MaterialCardView>


                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_share"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="@color/border_color_light"
                        app:strokeWidth="1dp"
                        android:layout_marginEnd="12dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/iv_share"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_share_icon_svg"
                            android:layout_gravity="center"
                            />


                    </com.google.android.material.card.MaterialCardView>




                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/caloriesPageLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:focusable="true"
                android:clickable="true"
                android:background="?selectableItemBackground"
                android:fontFamily="@font/cairo_bold"
                android:includeFontPadding="false"
                android:padding="4dp"
                android:textColor="@color/primary_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/version_build"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/white"
                style="@style/Styles.Text.Caption.Semibold"
                android:textSize="12sp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="24dp"
                tools:text="Version 1.0.0"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
