<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackgroundBorderless">

    <FrameLayout
        android:id="@+id/item_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/item_color_constraint"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/background_header_order_type"
            android:scaleType="centerInside"
            app:backgroundTint="@color/white"
            app:elevation="4dp"
            app:fabCustomSize="40dp"
            app:tint="#DEDEDE" />

    </FrameLayout>

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/color_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="center"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="@id/item_color"
        app:layout_constraintEnd_toEndOf="@id/item_color"
        app:layout_constraintStart_toStartOf="@id/item_color"
        app:layout_constraintTop_toTopOf="@id/item_color"
        tools:src="@color/black" />

    <View
        android:layout_width="8dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@id/item_color"
        app:layout_constraintStart_toEndOf="@id/item_color"
        app:layout_constraintTop_toTopOf="@id/item_color" />

    <View
        android:layout_width="0dp"
        android:layout_height="8dp"
        app:layout_constraintEnd_toEndOf="@id/item_color"
        app:layout_constraintStart_toStartOf="@id/item_color"
        app:layout_constraintTop_toBottomOf="@id/item_color" />


</androidx.constraintlayout.widget.ConstraintLayout>