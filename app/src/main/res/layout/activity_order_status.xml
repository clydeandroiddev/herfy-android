<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.herfy.order.views.OrderStatusActivity"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:background="@color/background">

    <include
        android:id="@+id/navigation"
        layout="@layout/navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/navigation"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary_text"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="8dp"
                android:textSize="24sp"
                android:text="Order status"/>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image"
                android:layout_width="160dp"
                android:layout_height="100dp"
                android:layout_marginEnd="8dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/order_status"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:indeterminate="true"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@+id/image"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/image"
                android:background="@drawable/background_order_status"
                android:layout_marginTop="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/id_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/track"
                    android:layout_marginTop="32dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    android:textSize="12sp"
                    android:textColor="@color/primary_text"
                    android:text="Your order ID"/>

                <TextView
                    android:id="@+id/code"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/id_label"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/track"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    android:textSize="30sp"
                    android:textColor="?attr/colorPrimary"/>

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:id="@+id/track"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/id_label"
                    android:padding="8dp"
                    android:layout_marginEnd="16dp"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="5dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="?attr/colorPrimary"
                    android:textColor="?attr/colorPrimary"
                    app:backgroundTint="@android:color/transparent"
                    android:gravity="center"
                    android:text="Live tracking" />

                <com.xfinity.dahdit.DashedLine
                    android:id="@+id/id_dashed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dashHeight="2dp"
                    app:dashLength="8dp"
                    app:minimumDashGap="3dp"
                    app:dashColor="#CCCCCC"
                    android:layout_marginTop="8dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/code"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/confirmed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/id_dashed"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:textSize="14sp"
                    android:text="Order confirmed"
                    android:textColor="@color/secondary_text"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:enabled="false"
                    app:buttonTint="@color/order_status"/>

                <TextView
                    android:id="@+id/confirmed_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/id_dashed"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBaseline_toBaselineOf="@+id/confirmed"
                    android:layout_marginEnd="16dp"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:text="On progress"/>

                <com.xfinity.dahdit.DashedLine
                    android:id="@+id/confirmed_dashed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dashHeight="2dp"
                    app:dashLength="8dp"
                    app:minimumDashGap="3dp"
                    app:dashColor="#CCCCCC"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@+id/confirmed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/preparing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/confirmed_dashed"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:text="Preparing"
                    android:textColor="@color/secondary_text"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:enabled="false"
                    app:buttonTint="@color/order_status"/>

                <TextView
                    android:id="@+id/preparing_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/confirmed_dashed"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBaseline_toBaselineOf="@+id/preparing"
                    android:layout_marginEnd="16dp"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:text="On progress"/>

                <com.xfinity.dahdit.DashedLine
                    android:id="@+id/preparing_dashed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dashHeight="2dp"
                    app:dashLength="8dp"
                    app:minimumDashGap="3dp"
                    app:dashColor="#CCCCCC"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@+id/preparing"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/on_the_way"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/preparing_dashed"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:text="Food on the way"
                    android:textColor="@color/secondary_text"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:enabled="false"
                    app:buttonTint="@color/order_status"/>

                <TextView
                    android:id="@+id/on_the_way_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/preparing_dashed"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBaseline_toBaselineOf="@+id/on_the_way"
                    android:layout_marginEnd="16dp"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:text="On progress"/>

                <com.xfinity.dahdit.DashedLine
                    android:id="@+id/on_the_way_dashed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dashHeight="2dp"
                    app:dashLength="8dp"
                    app:minimumDashGap="3dp"
                    app:dashColor="#CCCCCC"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@+id/on_the_way"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/delivered"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/on_the_way_dashed"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:text="Delivered to you"
                    android:textColor="@color/secondary_text"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:enabled="false"
                    app:buttonTint="@color/order_status"/>

                <TextView
                    android:id="@+id/delivered_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/on_the_way_dashed"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBaseline_toBaselineOf="@+id/delivered"
                    android:layout_marginEnd="16dp"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:text="On progress"/>

                <com.xfinity.dahdit.DashedLine
                    android:id="@+id/delivered_dashed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:dashHeight="2dp"
                    app:dashLength="8dp"
                    app:minimumDashGap="3dp"
                    app:dashColor="#CCCCCC"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@+id/delivered"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/delivered_dashed"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:text="Rating"
                    android:textColor="@color/secondary_text"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:enabled="false"
                    app:buttonTint="@color/order_status"/>

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:id="@+id/rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/delivered_dashed"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="8dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    app:cornerRadius="5dp"
                    android:gravity="center"
                    app:backgroundTint="@color/white"
                    android:clickable="false"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/secondary_text"
                    android:text="Rate Now"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:id="@+id/cancel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/container"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:backgroundTint="?attr/colorPrimary"
                android:textColor="@color/white"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:cornerRadius="5dp"
                android:gravity="center"
                android:text="Cancel order"
                android:visibility="gone"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>



</androidx.constraintlayout.widget.ConstraintLayout>