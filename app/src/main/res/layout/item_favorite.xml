<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="5dp"
    app:cardElevation="3dp"
    app:cardPreventCornerOverlap="true"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?selectableItemBackground"
        android:padding="5dp">
        <ProgressBar
            style="?android:progressBarStyleSmall"
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:layout_constraintTop_toTopOf="@+id/image_item"
            app:layout_constraintBottom_toBottomOf="@+id/image_item"
            app:layout_constraintStart_toStartOf="@+id/image_item"
            app:layout_constraintEnd_toEndOf="@+id/image_item"
            android:layout_marginStart="16dp"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image_item"
            android:layout_width="@dimen/item_menu_image_size"
            android:layout_height="@dimen/item_menu_image_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/image_item_stub" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingStart="8dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp"
            app:layout_constraintBottom_toBottomOf="@id/image_item"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/image_item"
            app:layout_constraintTop_toTopOf="@id/image_item">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/item_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/cairo_semibold"
                android:lineSpacingExtra="-5dp"
                android:maxLines="2"
                android:textColor="@color/cod_gray"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Single Hamburgini" />

            <ImageView
                android:id="@+id/discount_indicator"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="-20dp"
                android:layout_marginBottom="-22dp"
                android:translationZ="12dp"
                android:src="@drawable/ic_discount_indicator"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/add_to_bag"
                app:layout_constraintStart_toStartOf="@+id/add_to_bag"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/add_to_bag"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/background_add_to_bag"
                android:fontFamily="@font/cairo_semibold"
                android:gravity="center"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                tools:text="Add to Bag" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/old_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/cairo_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:maxLines="1"
                android:textColor="@color/strikethrough"
                android:textSize="14sp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/item_price"
                app:layout_constraintEnd_toEndOf="@+id/item_price"
                app:layout_constraintStart_toStartOf="@+id/item_price"
                app:layout_constraintTop_toBottomOf="@+id/item_description"
                tools:text="252.00SR"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/item_price"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:fontFamily="@font/cairo_semibold"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="0dp"
                android:paddingEnd="2dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="@id/add_to_bag"
                app:layout_constraintEnd_toStartOf="@id/add_to_bag"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/add_to_bag"
                tools:text="252.00SR" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/item_description"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:ellipsize="end"
                android:fontFamily="@font/cairo_semibold"
                android:lineSpacingExtra="-5dp"
                android:maxLines="2"
                android:textColor="@color/dusty_gray"
                android:textSize="12sp"
                android:elevation="2dp"
                app:layout_constraintBottom_toTopOf="@id/add_to_bag"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/item_name"
                tools:text="Pickles, gravy, buns, beef patty, cheddar cheese, etc." />

            <com.herfy.common.view.SlantedTextView
                android:id="@+id/stvSoldout"
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:slantedBackgroundColor="?colorPrimary"
                app:slantedLength="40dp"
                app:slantedMode="right"
                android:visibility="gone"
                app:slantedTextColor="@color/white"
                app:slantedTextSize="16sp" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <FrameLayout
            android:id="@+id/favorite_card"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/background_favorite"
            android:elevation="4dp" >

            <RelativeLayout
                android:id="@+id/favorite_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?selectableItemBackground">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/favorite_icon"
                    android:layout_width="17dp"
                    android:layout_height="15dp"
                    android:layout_centerInParent="true"
                    android:scaleType="fitXY"
                    app:srcCompat="@drawable/ic_heart_unselected"
                    app:tint="#F22424" />

            </RelativeLayout>

        </FrameLayout>

        <!--<com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/card_fav"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/background_order_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_heart"
            android:scaleType="centerInside"
            app:backgroundTint="@color/white"
            app:elevation="2dp"
            app:tint="#F22424"
            app:fabCustomSize="36dp"
            android:padding="16dp"/>-->

        <!--<com.google.android.material.card.MaterialCardView
            android:id="@+id/card_fav"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="3dp"
            android:layout_marginTop="3dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="34dp"
            app:cardElevation="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/heart_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:srcCompat="@drawable/ic_gray_heart"/>

        </com.google.android.material.card.MaterialCardView>-->


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>



