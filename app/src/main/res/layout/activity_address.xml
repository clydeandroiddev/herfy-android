<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".order.views.AddressActivity">

    <include
        layout="@layout/toolbar"
        android:id="@+id/toolbar"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        android:paddingBottom="8dp"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:includeFontPadding="false"
        android:fontFamily="@font/cairo_bold"
        android:textStyle="bold"
        android:textSize="12sp"
        android:textColor="@color/white"
        android:textAlignment="center"
        android:gravity="center"
        android:background="?attr/colorPrimary"
        android:lineSpacingExtra="-7dp" />

    <fragment
        android:id="@+id/address_map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_marker_location"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:paddingBottom="50dp"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/location"
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:backgroundTint="@color/white"
                android:layout_marginBottom="8dp"
                android:padding="8dp"
                app:tint="#C2C2C2"
                app:fabCustomSize="60dp"
                app:srcCompat="@drawable/ic_location_disabled"
                app:layout_constraintBottom_toTopOf="@+id/use"
                app:layout_constraintEnd_toEndOf="parent"
                app:elevation="4dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/use"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:backgroundTint="?attr/colorPrimary"
                app:cornerRadius="8dp"
                android:includeFontPadding="false"
                android:fontFamily="@font/cairo_black"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:textColor="@color/white"
                android:textAlignment="center"
                android:gravity="center"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </fragment>

</androidx.constraintlayout.widget.ConstraintLayout>